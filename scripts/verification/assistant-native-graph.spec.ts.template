function carrier(sessionId = 'cloud-session', home = '/cloud') {
  const mock = RemoteMock.create({ host: { home } });
  mock.load({
    unary: {
      'session/list': ok({ items: [{ sessionId, updatedAt: 1, running: false, blank: true, agentAvailable: true }] }),
      'session/projections': ok({ kind: 'sequenced', asOfSeq: -1, values: {} }),
      'session/prompt': ok({ accepted: true }),
      'settings/describe': ok({ namespaces: [], writable: false, hasDocument: false }),
      'fileUploads/upload': ok({ receiptId: 'fixture-receipt', file: { attachmentId: 'sha256:' + 'a'.repeat(64), name: 'report.txt', bytes: 4 } }),
    },
    stream: {
      'session/control': (_args, stream) => { stream.push({ type: 'baseline', value: { projections: {} } }); },
      'session/follow': ([wire], stream) => {
        const input = (wire as { request: { address: { sessionId: string }; assistantStream: boolean } }).request;
        expect(input.address.sessionId).toBe(sessionId);
        stream.push({ type: 'snapshot', header: { version: SESSION_FORMAT_VERSION, id: sessionId, createdAt: 0, isSeeded: false },
          cursor: -1, records: [], hasMore: false, projections: { asOfSeq: -1, values: {} },
          ...(input.assistantStream ? { assistantStream: { revision: 0 } } : {}) });
      },
      'remoteAccess/follow': (_args, stream) => { stream.push({ type: 'baseline', owner: false, grants: [
        { resource: { kind: 'session', id: sessionId }, actions: ['session/follow', 'session/projections'] },
      ] }); },
    },
  });
  return mock;
}

function pollingCarrier(mock: ReturnType<typeof carrier>) {
  const polls = new Map<string, { controller: AbortController; iterator: AsyncIterator<unknown> }>();
    const memory = new Map<string, string>(), calls: Array<{ operation: string; value: any }> = [];
    const storage = { get length() { return memory.size; }, key: (index: number) => [...memory.keys()][index] ?? null, getItem: (key: string) => memory.get(key) ?? null, setItem: (key: string, value: string) => { memory.set(key, value) }, removeItem: (key: string) => { memory.delete(key) } };
    const execute = async (_agent: string, operation: string, value: any, signal?: AbortSignal) => {
      calls.push({ operation, value }); expect(value.conversation).toBe('personal');
      if (operation === 'native-open') return { carrierId: 'carrier-one', sessionId: 'cloud-session', journalScope: 'c'.repeat(64), representation: 'assistant-public-projection/v1', capabilities: { owner: false, durableSubmit: true } };
      if (operation === 'native-call') {
        if (value.endpoint === 'session/prompt') {
          expect([...memory.values()].join()).toContain(value.payload.args.request.requestId);
          expect([...memory.values()].join()).not.toContain('ZGF0YQ==');
        }
        return mock.rpc.call('/api', value.endpoint, value.payload, signal);
      }
      if (operation === 'attachment-upload') return { receiptId: 'cloud-receipt', kind: value.kind, ...(value.kind === 'image' ? { mediaType: value.mediaType } : {}), attachment: { attachmentId: 'sha256:' + 'a'.repeat(64), name: value.name, bytes: Buffer.from(value.data, 'base64').length } };
      if (operation === 'native-stream-open') {
        const controller = new AbortController();
        polls.set(value.streamId, { controller, iterator: mock.rpc.open('/api', value.endpoint, value.payload, controller.signal)[Symbol.asyncIterator]() });
        return { opened: true };
      }
      if (operation === 'native-stream-poll') {
        const stream = polls.get(value.streamId)!;
        const abort = () => stream.controller.abort(); signal?.addEventListener('abort', abort, { once: true });
        try { const next = await stream.iterator.next(); return { items: next.done ? [] : [next.value], ended: next.done === true }; }
        finally { signal?.removeEventListener('abort', abort); }
      }
      if (operation === 'native-stream-cancel') { polls.get(value.streamId)?.controller.abort(); polls.delete(value.streamId); return { cancelled: true }; }
      if (operation === 'native-close') { for (const stream of polls.values()) stream.controller.abort(); polls.clear(); return { closed: true }; }
      throw new Error('Unexpected carrier operation ' + operation);
    };
  return { execute, memory, storage, calls };
}

async function graph(mock = carrier(), safe = false) {
  const ctx = new Context();
  disposers.push(() => ctx.fiber.dispose());
  const localSocket = vi.fn(() => { throw new Error('default/local socket forbidden'); });
  await ctx.plugin({ apply(scope: Context) {
    installConnection(scope, { interactions: 'answer', location: { hostname: 'cloud-assistant.invalid' },
      transport: { rpc: mock.rpc, ownsHost: false, createWebSocket: localSocket },
      recovery: { backoffBaseMs: 10, backoffMaxMs: 10 } });
  } }).await();
  for (const plugin of [typert, gateway, remotes, renderer, ...(safe ? [cloudOnlyAdapters] : [fileUpload, access]), sessions, uiSession]) await ctx.plugin(plugin).await();
  await vi.waitFor(() => { expect(ctx.get('connection').generation.getSnapshot()).toBeDefined(); });
  await mock.streams.opened('remoteAccess/follow', 1);
  return { ctx, mock, localSocket };
}

// Controlled public-service implementation: no Session/Controller substitutes.
// Every grant is a display hint only; the carrier must enforce each actual RPC.
const cloudOnlyAdapters = { inject: ['remote', 'remote.fileUploads', 'connection', 'slots'], async apply(ctx: Context) {
  const sources = new Map<string, ReturnType<typeof createSnapshotStore<boolean>>>();
  let grants = new Set<string>(), stopped = false;
  const publish = () => { for (const [key, source] of sources) source.set(!stopped && grants.has(key)); };
  const clear = () => { grants = new Set(); publish(); };
  const source: access.ClientRemoteAccess['source'] = (kind, id, action) => {
    const key = `${kind}:${id}:${action}`;
    if (!sources.has(key)) sources.set(key, createSnapshotStore(!stopped && grants.has(key)));
    return sources.get(key)!;
  };
  ctx.provide('remoteAccess', { source } satisfies access.ClientRemoteAccess);
  ctx.slots.provideRoot({ keyedHooks: { remoteAccess: action => source('global', '', action) } });
  const unmount = await ctx.remote.$mount(remoteAccessRemote);
  const allowed = new Set(['session/follow', 'session/projections', 'session/page', 'session/prompt', 'fileUploads/upload']);
  const scoped = (grant: access.RemoteAccessGrant) => grant.resource.kind === 'session' && grant.resource.id === 'cloud-session';
  const applyGrant = (grant: access.RemoteAccessGrant) => {
    if (!scoped(grant)) return;
    grants = new Set([...grants].filter(key => !key.startsWith('session:cloud-session:')));
    for (const action of grant.actions) if (allowed.has(action)) grants.add(`session:cloud-session:${action}`);
  };
  const scopedFollow = ctx.inject(['remote.remoteAccess'], remoteCtx => {
  const stream = remoteCtx.remote.$stream<access.RemoteAccessFrame>({
    name: 'Controlled cloud-only access', open: signal => remoteCtx.remote.remoteAccess.follow(signal),
    ended: () => new gateway.RemoteStreamCarrierError('controlled access carrier ended'), carrierFailed: clear,
  });
  const follow = new gateway.RemoteSnapshotStream(stream, {
    name: 'Controlled cloud-only access',
    isSnapshot: (frame): frame is Extract<access.RemoteAccessFrame, {type:'baseline'}> => frame.type === 'baseline',
    replace: frame => {
      clear();
      if (frame.owner || ctx.connection.generation.getSnapshot() === undefined) return;
      for (const grant of frame.grants) applyGrant(grant);
      publish();
    },
    update: frame => {
      if (frame.type === 'upsert') applyGrant(frame.grant);
      else if (frame.resource.kind === 'session' && frame.resource.id === 'cloud-session') clear();
      publish();
    }, failed: clear,
  });
  const unsubscribe = ctx.connection.generation.subscribe(() => { clear(); follow.restart(); });
  follow.start();
  remoteCtx.effect(() => async () => { clear(); unsubscribe(); await follow.dispose(); });
  });
  // The upload interface accepts Blob without reading the page-global upload hook.
  const upload: fileUpload.FileUploadService['upload'] = async (sessionId, data, name, signal, onProgress) => {
    if (sessionId !== 'cloud-session') throw new Error('outside current cloud session');
    signal?.throwIfAborted();
    if (!(data instanceof Blob) && !(data instanceof Uint8Array)) throw new Error('one-shot streams unsupported');
    if ((data instanceof Blob ? data.size : data.byteLength) > 1024) throw new Error('controlled upload limit');
    const bytes = data instanceof Uint8Array ? data : await new Promise<Uint8Array>((resolve, reject) => {
      const reader = new FileReader();
      const aborted = () => { reader.abort(); reject(signal?.reason); };
      signal?.addEventListener('abort', aborted, { once: true });
      reader.onerror = () => reject(reader.error);
      reader.onload = () => resolve(new Uint8Array(reader.result as ArrayBuffer));
      reader.onloadend = () => signal?.removeEventListener('abort', aborted);
      reader.readAsArrayBuffer(data);
    });
    signal?.throwIfAborted();
    onProgress?.({ loaded: bytes.length, total: bytes.length });
    return ctx.remote.fileUploads.upload(sessionId, { data: bytesToBase64(bytes), ...(name === undefined ? {} : { name }) }, signal);
  };
  ctx.provide('fileUpload', { upload } satisfies fileUpload.FileUploadService);
  return async () => { stopped = true; clear(); await scopedFollow.dispose(); await unmount(); };
} };

describe('Isolated native Client graph feasibility, with only its external carrier controlled', () => {
  it('owns genuine same-ID bindings in distinct Controller graphs without retaining on the other Host', async () => {
    const local = await graph(carrier('same-id', '/local-fixture'));
    const cloud = await graph(carrier('same-id', '/cloud-fixture'));
    expect(cloud.ctx.connection.isLoopback).toBe(false);
    expect(cloud.ctx.remote.$host).toMatchObject({ home: '/cloud-fixture', isLoopback: false });
    const reference = cloud.ctx.sessions.retain('same-id', { source: 'controllerOperation' });
    await reference.ready;
    expect(reference.binding.session.getSnapshot().openError).toBeNull();
    expect(reference.binding.session.getSnapshot()).toMatchObject({ openState: 'open' });
    expect(cloud.ctx.sessions.binding('same-id')).toBe(reference.binding);
    expect(local.ctx.sessions.binding('same-id')).toBeUndefined();
    expect(cloud.ctx.uiSession.bindingSource(reference).getSnapshot().key).toBe('same-id');
    expect(() => local.ctx.uiSession.bindingSource(reference)).toThrow('not active in this Controller');
    expect(local.mock.log.streams('session/follow')).toHaveLength(0);
    expect(cloud.localSocket).not.toHaveBeenCalled(); expect(local.localSocket).not.toHaveBeenCalled();
    reference.release();
    await vi.waitFor(() => { expect(cloud.ctx.sessions.binding('same-id')).toBeUndefined(); });
  });

  it('reconnects only its cloud carrier and preserves the exact retained Session binding', async () => {
    const b = await graph(), reference = b.ctx.sessions.retain('cloud-session', { source: 'controllerOperation' });
    await reference.ready;
    expect(reference.binding.session.getSnapshot().openError).toBeNull();
    expect(reference.binding.session.getSnapshot()).toMatchObject({ openState: 'open' });
    const binding = reference.binding, resumed = Promise.withResolvers<void>();
    b.mock.stream('$events', (_args, stream) => { void resumed.promise.then(() => stream.push({ type: 'ready', clientId: 'resumed-client', host: { home: '/cloud' } })); });
    b.ctx.connection.reconnect();
    await vi.waitFor(() => { expect(b.ctx.connection.generation.getSnapshot()).toBeUndefined(); });
    expect(b.mock.streams.fail('session/follow', new gateway.RemoteStreamCarrierError('controlled cloud carrier loss'))).toBe(1);
    expect(reference.binding).toBe(binding);
    resumed.resolve();
    await vi.waitFor(() => { expect(b.ctx.connection.generation.getSnapshot()?.id).toBe(2); });
    await vi.waitFor(() => { expect({ opens: b.mock.log.streams('session/follow').length, snapshot: reference.binding.session.getSnapshot() }).toMatchObject({ opens: 2 }); });
    expect(reference.binding).toBe(binding); expect(b.ctx.sessions.binding('cloud-session')).toBe(binding);
    reference.release();
  });

  it('releases a pending old graph before another assistant is retained, ignoring late stream data', async () => {
    const firstMock = carrier('old-session'), late = Promise.withResolvers<void>();
    firstMock.stream('session/follow', (_args, stream) => { void late.promise.then(() => stream.push({ invalidOldFrame: true })); });
    const first = await graph(firstMock), reference = first.ctx.sessions.retain('old-session', { source: 'controllerOperation' });
    const ready = reference.ready.catch(error => error);
    await firstMock.streams.opened('session/follow', 1);
    reference.release();
    await first.ctx.fiber.dispose();
    const next = await graph(carrier('next-session')), nextReference = next.ctx.sessions.retain('next-session', { source: 'controllerOperation' });
    await nextReference.ready; late.resolve(); await ready;
    expect(first.ctx.sessions?.binding('old-session')).toBeUndefined();
    expect(next.ctx.sessions.binding('old-session')).toBeUndefined();
    expect(next.ctx.sessions.binding('next-session')).toBe(nextReference.binding);
    expect(next.mock.log.streams('session/follow')).toHaveLength(1);
    nextReference.release();
  });

  it('routes explicit bytes through the cloud Remote but demonstrates why native Blob uploads need an instance seam', async () => {
    const pageUpload = vi.fn(async () => new Response(JSON.stringify(ok({ receiptId: 'page-receipt', file: { attachmentId: 'sha256:' + 'b'.repeat(64), name: 'report.txt', bytes: 4 } })), { status: 200 }));
    vi.stubGlobal('__DSH_FILE_UPLOAD__', { fetch: pageUpload });
    const b = await graph();
    await b.ctx.fileUpload.upload('cloud-session', new Uint8Array([1, 2, 3, 4]), 'report.txt');
    expect(b.mock.log.requests('fileUploads/upload')).toHaveLength(1); expect(pageUpload).not.toHaveBeenCalled();
    await b.ctx.fileUpload.upload('cloud-session', new Blob(['data']), 'report.txt');
    expect(pageUpload).toHaveBeenCalledOnce();
    expect(pageUpload.mock.calls[0][0]).toContain('sessionId=cloud-session');
    expect(b.mock.log.requests('fileUploads/upload')).toHaveLength(1);
  });

  it('demonstrates that the stock remote-access plugin reads the page owner baseline before cloud authority arrives', async () => {
    vi.stubGlobal('__DSH_REMOTE_ACCESS__', { type: 'baseline', owner: true });
    const mock = carrier(); mock.stream('remoteAccess/follow', () => {});
    const b = await graph(mock);
    expect(b.ctx.connection.isLoopback).toBe(false);
    expect(b.ctx.remoteAccess.source('session', 'unrelated-session', 'session/prompt').getSnapshot()).toBe(true);
    // This is the unsafe stock-plugin behavior, not a capability granted by the cloud carrier.
    expect(mock.log.requests('session/prompt')).toHaveLength(0);
  });

  it('demonstrates that a per-Session addFiles contribution cannot override the native composer inject', async () => {
    const pathFor = vi.fn(() => '/controlled-local-fixture/report.txt');
    vi.stubGlobal('__DSH_HOST_PATHS__', { pathFor });
    const b = await graph();
    await b.ctx.plugin(settings).await(); await b.ctx.plugin(locale).await();
    // This fixture has no workspace/navigation authority. Only the published UI
    // navigation interface is supplied; Session/Controller/renderer remain real.
    b.ctx.provide('uiWorkspace', { openSession() { throw new Error('navigation unavailable'); }, async openWorkspace() { throw new Error('navigation unavailable'); } });
    b.ctx.slots.provideRoot({ hooks: { workspaces: createSnapshotStore({ phase: 'ready', items: [] }) } });
    b.ctx.slots.register({ name: 'root', children: { main: { kind: 'keyed', scope: 'root' }, 'settings.general.item': { kind: 'list', scope: 'root' } } }, () => null);
    await b.ctx.plugin(conversation).await();
    const reference = b.ctx.sessions.retain('cloud-session', { source: 'controllerOperation' }); await reference.ready;
    const safeAddFiles = vi.fn(() => null);
    b.ctx.uiSession.provide({ props: ['addFiles'], resolve: () => ({ props: { addFiles: safeAddFiles } }) });
    expect(b.ctx.uiSession.bindingSource(reference).getSnapshot().props.addFiles).toBe(safeAddFiles);
    const nativeBar = b.ctx.slots.entries('conversation.composer.bar')[0];
    const injected = nativeBar.inject('cloud-session');
    expect(injected.addFiles).not.toBe(safeAddFiles);
    expect(injected.addFiles([new File(['data'], 'report.txt', { type: 'text/plain' })])).toBeNull();
    expect(pathFor).toHaveBeenCalledOnce(); expect(safeAddFiles).not.toHaveBeenCalled();
    const input = b.ctx.conversation.input.for(reference.binding.ctx).state.getSnapshot();
    expect(input.draft).toContain('controlled-local-fixture/report.txt');
    expect(b.mock.log.requests('fileUploads/upload')).toHaveLength(0);
    reference.release();
  });

  it('uses only trusted non-owner current-session grants with a public per-graph access adapter', async () => {
    const pageOwner = vi.fn(() => ({ type: 'baseline', owner: true }));
    Object.defineProperty(globalThis, '__DSH_REMOTE_ACCESS__', { get: pageOwner, configurable: true });
    // Register cleanup even though the getter is deliberately never evaluated.
    disposers.push(async () => { Reflect.deleteProperty(globalThis, '__DSH_REMOTE_ACCESS__'); });
    const mock = carrier(); mock.stream('remoteAccess/follow', () => {});
    const b = await graph(mock, true);
    const current = b.ctx.remoteAccess.source('session', 'cloud-session', 'session/prompt');
    expect(current.getSnapshot()).toBe(false);
    mock.streams.push('remoteAccess/follow', { type: 'baseline', owner: false, grants: [
      { resource: { kind: 'session', id: 'cloud-session' }, actions: ['session/prompt', 'session/cancel'] },
      { resource: { kind: 'session', id: 'unrelated-session' }, actions: ['session/prompt'] },
    ] });
    await vi.waitFor(() => expect(current.getSnapshot()).toBe(true));
    expect(b.ctx.remoteAccess.source('session', 'cloud-session', 'session/cancel').getSnapshot()).toBe(false);
    expect(b.ctx.remoteAccess.source('session', 'unrelated-session', 'session/prompt').getSnapshot()).toBe(false);
    expect(pageOwner).not.toHaveBeenCalled();
    const ready = Promise.withResolvers<void>();
    mock.stream('$events', (_args, stream) => { void ready.promise.then(() => stream.push({ type: 'ready', clientId: 'fresh', host: { home: '/cloud' } })); });
    b.ctx.connection.reconnect();
    await vi.waitFor(() => expect(current.getSnapshot()).toBe(false));
    ready.resolve();
    await vi.waitFor(() => expect(b.ctx.connection.generation.getSnapshot()?.id).toBe(2));
    await mock.streams.opened('remoteAccess/follow', 2);
    expect(current.getSnapshot()).toBe(false);
    mock.streams.push('remoteAccess/follow', { type: 'baseline', owner: true });
    await new Promise(resolve => setTimeout(resolve, 0));
    expect(current.getSnapshot()).toBe(false);
    await b.ctx.fiber.dispose(); expect(current.getSnapshot()).toBe(false);
  });

  it('uploads Blob bytes through the real generated cloud Remote without reading page hooks', async () => {
    const pageUpload = vi.fn(() => { throw new Error('page hook must not be read'); });
    Object.defineProperty(globalThis, '__DSH_FILE_UPLOAD__', { get: pageUpload, configurable: true });
    disposers.push(async () => { Reflect.deleteProperty(globalThis, '__DSH_FILE_UPLOAD__'); });
    const b = await graph(carrier(), true), progress = vi.fn();
    const result = await b.ctx.fileUpload.upload('cloud-session', new Blob(['data']), 'report.txt', undefined, progress);
    expect(result).toMatchObject({ ok: true, value: { receiptId: 'fixture-receipt' } });
    expect(b.mock.log.requests('fileUploads/upload')).toHaveLength(1);
    expect(JSON.stringify(b.mock.log.requests('fileUploads/upload'))).toContain('ZGF0YQ==');
    expect(pageUpload).not.toHaveBeenCalled(); expect(progress).toHaveBeenCalledWith({ loaded: 4, total: 4 });
    await expect(b.ctx.fileUpload.upload('local-session', new Blob(['data']))).rejects.toThrow('outside current');
    await expect(b.ctx.fileUpload.upload('cloud-session', new Blob(['x'.repeat(1025)]))).rejects.toThrow('limit');
    const cancelled = new AbortController(); cancelled.abort(new Error('cancelled'));
    await expect(b.ctx.fileUpload.upload('cloud-session', new Blob(['data']), undefined, cancelled.signal)).rejects.toThrow('cancelled');
    expect(b.mock.log.requests('fileUploads/upload')).toHaveLength(1);
