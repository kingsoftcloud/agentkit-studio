      nativeModules: () => ({ Context, React, connection: { installConnection }, typert, gateway, remotes, renderer, sessions, uiSession, settings, locale, conversation, attachment, createSnapshotStore }),
      window: { localStorage: next.storage, crypto: webcrypto, FileReader, Blob } });
