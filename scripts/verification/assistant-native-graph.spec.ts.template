  it.each([false, true])('confirms the same native request without resending restored input, preserving later edits=%s', async (edited) => {
    Object.defineProperty(document, 'fonts', { value: new EventTarget(), configurable: true });
    Object.defineProperty(Range.prototype, 'getBoundingClientRect', { configurable: true, value: () => new DOMRect() });
    Object.defineProperty(Range.prototype, 'getClientRects', { configurable: true, value: () => [] });
    disposers.push(async () => { Reflect.deleteProperty(Range.prototype, 'getBoundingClientRect'); Reflect.deleteProperty(Range.prototype, 'getClientRects'); });
    const mock = carrier(), b = pollingCarrier(mock); let lost = true;
    const execute = async (agent: string, operation: string, value: any, signal?: AbortSignal) => {
      const result = await b.execute(agent, operation, value, signal);
      if (operation === 'native-call' && value.endpoint === 'session/prompt' && lost) throw new Error('controlled lost ACK');
      return result;
    };
    const modules = { Context, React, connection: { installConnection }, typert, gateway, remotes, renderer, sessions, uiSession, settings, locale, conversation, attachment, createSnapshotStore };
    const transport = await createAssistantNativeTransport({ execute, agentId: 'cloud-agent', storage: b.storage, crypto: webcrypto });
    const container = document.createElement('div'); document.body.append(container);
    let cloud: Awaited<ReturnType<typeof createAssistantNativeGraph>>;
    await act(async () => { cloud = await createAssistantNativeGraph({ modules, transport, window, container }); });
    disposers.push(async () => { await act(async () => { await cloud.dispose(); }); container.remove(); });
    const input = cloud!.ctx.conversation.input.for(cloud!.reference.binding.ctx);
    const addFiles = cloud!.ctx.slots.entries('conversation.composer.bar')[0].inject('cloud-session').addFiles;
    await act(async () => { addFiles([new File(['data'], 'report.txt', { type: 'text/plain' })]); });
    await vi.waitFor(() => expect(b.calls.filter(call => call.operation === 'attachment-upload')).toHaveLength(1));
    await act(async () => { input.setDraft('Cloud composer message'); input.submit(); });
    await vi.waitFor(() => { expect(transport.getState().pending).not.toBeNull(); expect(input.state.getSnapshot().draft).toBe('Cloud composer message'); });
    if (edited) await act(async () => { input.setDraft('Keep my later edits'); });
    lost = false;
    let confirmed: { accepted: boolean; reset: boolean };
    await act(async () => { confirmed = await cloud!.confirm(); });
    expect(confirmed!).toEqual({ accepted: true, reset: !edited });
    const ids = () => b.calls.filter(call => call.operation === 'native-call' && call.value.endpoint === 'session/prompt').map(call => call.value.payload.args.request.requestId);
    expect(ids()).toHaveLength(2); expect(ids()[0]).toBe(ids()[1]);
    if (confirmed!.reset) {
      await act(async () => { await cloud!.dispose(); });
      const restored = await createAssistantNativeTransport({ execute, agentId: 'cloud-agent', storage: b.storage, crypto: webcrypto });
      await act(async () => { cloud = await createAssistantNativeGraph({ modules, transport: restored, window, container }); });
      const fresh = cloud!.ctx.conversation.input.for(cloud!.reference.binding.ctx);
      expect(fresh.state.getSnapshot()).toMatchObject({ draft: '', attachmentIds: [] });
      await act(async () => { fresh.submit(); });
      expect(ids()).toHaveLength(2);
    } else {
      expect(input.state.getSnapshot().draft).toBe('Keep my later edits');
      expect(input.state.getSnapshot().attachmentIds).toHaveLength(1);
    }
    expect(b.memory.size).toBe(0);
  });

