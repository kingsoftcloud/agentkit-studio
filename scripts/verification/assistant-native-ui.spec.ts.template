function pageFixture(initial = {}, cancel: any = { accepted: true }, snapshotDeferred?: Promise<any>, options: any = {}) {
  const native = fixture();
  let snapshot = { messages: [], events: [], hasMore: false, asOfSeq: 1, status: 'idle', currentTurn: 1, turnStartSeq: 0, capabilities: { history: { nativeEvents: true }, execution: { scopedCancel: true } }, ...initial };
  const values = new Map<string, string>(), timers = new Map<number, () => void>(), delays = new Map<number, number>(); let serial = 0, requestSerial = 0;
  const remote = { assistantSetupStatus: vi.fn().mockResolvedValue(options.setup || { state: 'NOT_STARTED' }), assistantSetupOptions: vi.fn().mockResolvedValue(options.setupOptions), assistantCatalog: vi.fn().mockResolvedValue({ items: options.items || [{ metadata: { id: 'cloud-owned', name: 'Cloud assistant' } }] }),
    assistantExecute: vi.fn(async (_agentId: string, operation: string, input: any, signal?: AbortSignal) => {
      if (options.operation && operation !== 'snapshot') return options.operation(_agentId, operation, input, signal);
      if (operation === 'snapshot') return options.snapshot ? options.snapshot(_agentId) : snapshotDeferred || snapshot;
      if (operation === 'cancel-turn') { if (cancel instanceof Error) throw cancel; return cancel; }
      if (operation === 'submit') return { accepted: true, requestId: input.requestId };
      throw new Error('Unexpected page operation: ' + operation);
    }) };
  const pageWindow = { localStorage: { getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => values.set(key, value), removeItem: (key: string) => values.delete(key) },
    FileReader: window.FileReader, crypto: { randomUUID: () => `ui-request-${++requestSerial}` }, setTimeout: (fn: () => void, delay: number) => { timers.set(++serial, fn); delays.set(serial, delay); return serial; }, clearTimeout: (id: number) => { timers.delete(id); delays.delete(id); },
    addEventListener: window.addEventListener.bind(window), removeEventListener: window.removeEventListener.bind(window), dispatchEvent: window.dispatchEvent.bind(window), CustomEvent: window.CustomEvent };
  const actions = { confirm: vi.fn().mockResolvedValue(true) };
  const Page = createAssistantPage({ ui: { ...native.ui, inputStyle: () => ({}), AssistantTranscript: native.component,
    ComputerConnection: () => h('span', { 'data-controlled-connection': true }, 'Controlled connection') }, hostRemote: remote, actions, window: pageWindow });
  return { Page, remote, actions, values, timers, native, setSnapshot: (next: any) => { snapshot = { ...snapshot, ...next }; }, async poll() {
    const next = [...timers.entries()].sort((a, b) => (delays.get(a[0]) || 0) - (delays.get(b[0]) || 0))[0]; expect(next).toBeTruthy(); timers.delete(next![0]); await act(async () => { next![1](); });
  } };
}

describe('Studio assistant page with real session controller and React', () => {
  it('shows the managed permission policy from the current snapshot and the notice before setup', async () => {
    const f = pageFixture({ capabilities: { execution: { managed: true, profile: 'workspace-managed/v1', permission: 'workspace-write' }, approval: { interactive: true } } });
    const view = render(h(f.Page));
    await view.findByText('助理可在独立云端工作区内读写和搜索；敏感操作需逐次审批。');
    expect(view.queryByText(/此云端会话按只读权限执行/)).toBeNull(); view.unmount();
    const setup = pageFixture({}, undefined, undefined, { items: [], setupOptions: { optionsId: 'options-one', memories: [{ id: 'memory-one', name: 'My memory' }], model: { name: 'Cloud model' }, billingNotice: 'Controlled billing notice', permissionNotice: '在隔离工作区可读写；敏感操作会逐次询问。' } });
    const opening = render(h(setup.Page));
    await opening.findByRole('button', { name: '开通个人助理' });
    expect(opening.getByText('在隔离工作区可读写；敏感操作会逐次询问。')).toBeTruthy();
    expect(setup.remote.assistantExecute).not.toHaveBeenCalled();
  });
  it('keeps accepted cancellation in stopping state until a terminal cloud snapshot', async () => {
    const f = pageFixture({ status: 'running' }), view = render(h(f.Page));
    fireEvent.click(await view.findByRole('button', { name: '停止', exact: true }));
    await waitFor(() => expect((view.getByRole('button', { name: '正在停止…' }) as HTMLButtonElement).disabled).toBe(true));
    expect(view.getByText('正在等待云端确认停止…')).toBeTruthy();
    expect(f.actions.confirm).toHaveBeenCalledTimes(1);
    expect(f.remote.assistantExecute.mock.calls.filter(call => call[1] === 'cancel-turn')).toHaveLength(1);
    f.setSnapshot({ status: 'cancelled', asOfSeq: 2, events: [at(2, 'turn/end', { turn: 1, reason: { kind: 'aborted' } })] }); await f.poll();
    expect(view.getByText('任务已停止。')).toBeTruthy(); expect(view.queryByRole('button', { name: '正在停止…' })).toBeNull();
    view.unmount(); expect(f.timers.size).toBe(0); expect(f.remote.assistantExecute.mock.calls.filter(call => call[1] === 'cancel-turn')).toHaveLength(1);
  });
  it.each([{ name: 'rejected', reply: { accepted: false }, warning: /未接受停止请求/ }, { name: 'unknown', reply: new Error('controlled disconnect'), warning: /停止结果尚未确认/ }])('keeps $name cancellation visible while the cloud task continues', async ({ reply, warning }) => {
    const f = pageFixture({ status: 'running' }, reply), view = render(h(f.Page));
