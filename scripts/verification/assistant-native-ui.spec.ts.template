const cleanups: Array<() => void> = [];
afterEach(async () => { cleanup(); for (const dispose of cleanups.splice(0)) await dispose(); vi.restoreAllMocks(); });
const h = React.createElement;
const image = { attachmentId: 'sha256:' + 'a'.repeat(64), mediaType: 'image/png', name: 'chart.png', bytes: 4, width: 1, height: 1 };
const imageResult = { attachment: image, data: 'iVBORw==' };
const at = (seq: number, type: string, data: any, extra = {}) => ({ seq, type, data, time: 1_700_000_000_000 + seq, ...extra });
const msg = (id: string, content: any[], source = { kind: 'user', rpcId: id }) => ({ id, role: 'user', content, source });
function history({ userContent = [{ type: 'text', text: 'Read the report' }], toolContent = [{ type: 'text', text: 'Tool result visible after expansion' }], isError = false } = {}) {
  return [
    at(1, 'turn/start', { turn: 1 }),
    at(2, 'user/message', msg('request-1', userContent), { surfaceOp: 'append' }),
    at(3, 'step/start', { turn: 1, step: 1 }),
    at(4, 'tool/call', { turn: 1, step: 1, callId: 'call-read', name: 'read_report', arguments: '{"path":"cloud-report"}' }),
    at(5, 'tool/result', { turn: 1, step: 1, message: { id: 'tool-result', role: 'tool', toolCallId: 'call-read', source: { kind: 'tool', callId: 'call-read' }, content: toolContent, isError } }, { surfaceOp: 'append' }),
    at(6, 'step/end', { turn: 1, step: 1 }),
    at(7, 'step/start', { turn: 1, step: 2 }),
    at(8, 'assistant/message', { turn: 1, step: 2, stream: [], message: { id: 'reply-1', role: 'assistant', source: { kind: 'model', provider: 'controlled', model: 'controlled' }, content: [{ type: 'text', text: '## Native rendered answer\n\n[unsafe](javascript:alert(1))\n\n**Ready**' }] } }, { surfaceOp: 'append' }),
    at(9, 'step/end', { turn: 1, step: 2 }),
    at(10, 'turn/end', { turn: 1, reason: { kind: 'completed' } }),
  ];
}
function fixture(remote = vi.fn().mockResolvedValue(imageResult)) {
  const ctx = new Context();
  const events = new ConversationEventRegistry(ctx), views = new ConversationViewRegistry(ctx), groups = new ConversationGroupRegistry(ctx, views);
  ctx.provide('uiConversation', { events, views, groups } as never);
  // Match the mounted production registry: even the inactive Trajectory target
  // consumes lifecycle events during assembly, so Chat-only definitions hide bugs.
  registerConversationNodes(ctx);
  registerTrajectoryAssistantDefinition(ctx);
  const conversation = createAssistantConversation({ ConversationNodeAssembler });
  const unbind = conversation.bind({ events, views, groups });
  cleanups.push(async () => { unbind(); await ctx.fiber.dispose(); });
  const urls = { createObjectURL: vi.fn((blob: Blob) => `blob:assistant-${blob.size}-${Math.random()}`), revokeObjectURL: vi.fn() };
  const hostRemote = { assistantExecute: remote, readFile: vi.fn(() => { throw Error('local read prohibited'); }), openFile: vi.fn(() => { throw Error('local open prohibited'); }) };
  const ui = { React, BRAND: { inkMuted: '#456', border: '#ddd', accentSoft: '#eee' }, MarkdownText, MarkdownDelegateProvider, DisclosureRow, StateDot, ImageLightbox, FileTypeIcon, Button, RiskConfirmation, buttonStyle: () => ({}) };
  const component = createAssistantTranscript({ ui, hostRemote, assistantConversation: conversation, window: { URL: urls, Blob: window.Blob, document: window.document, atob: window.atob.bind(window) } });
  const props = (events: any[], images = true, agentId = 'cloud-owned') => ({ agentId, messages: [], view: { events: displayEvents(events), hasMore: false, capabilities: { history: { nativeEvents: true }, display: { images, files: false } } } });
  return { component, props, conversation, urls, hostRemote, ui };
}

