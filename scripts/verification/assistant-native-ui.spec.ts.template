const fileReceipt = { kind: 'image', receiptId: 'upload-receipt-1', mediaType: 'image/png', attachment: { attachmentId: `sha256:${'f'.repeat(64)}`, name: 'upload.png', bytes: 4 } };
const uploadCapabilities = { input: { attachments: true, images: true, files: true }, display: { images: true, files: true }, history: { nativeEvents: true } };
describe('Assistant attachment composer and verified cloud downloads', () => {
  it('uploads with native Button, blocks send until receipt, sends image-only and persists no inline bytes', async () => {
    const upload = Promise.withResolvers<any>();
    const f = pageFixture({ capabilities: uploadCapabilities }, undefined, undefined, { operation: (_id: string, operation: string, input: any) => operation === 'attachment-upload' ? upload.promise : { accepted: true, requestId: input.requestId } });
    const view = render(h(f.Page)); await view.findByRole('button', { name: '添加附件' });
    const input = view.getByLabelText('上传附件') as HTMLInputElement;
    fireEvent.change(input, { target: { files: [new File(['abcd'], 'upload.png', { type: 'image/png' })] } });
    await view.findByText('正在上传，等待云端回执…');
    expect((view.getByRole('button', { name: '发送', exact: true }) as HTMLButtonElement).disabled).toBe(true);
    expect(view.getByRole('progressbar').hasAttribute('value')).toBe(false);
    expect([...f.values.values()].join('')).not.toContain('YWJjZA==');
    await act(async () => upload.resolve(fileReceipt));
    await view.findByText('已上传，等待发送');
    expect((view.getByRole('button', { name: '发送', exact: true }) as HTMLButtonElement).disabled).toBe(false);
    fireEvent.click(view.getByRole('button', { name: '发送', exact: true }));
    await waitFor(() => expect(view.queryByLabelText('待发送附件')).toBeNull());
    const submit = f.remote.assistantExecute.mock.calls.find(call => call[1] === 'submit')![2];
    expect(submit.content).toEqual([{ type: 'image', receiptId: fileReceipt.receiptId, mediaType: 'image/png', name: 'upload.png' }]);
    expect(submit.attachments).toBeUndefined(); expect(submit.text).toBeUndefined();
    expect([...f.values.values()].join('')).not.toContain('YWJjZA==');
    expect(view.getByLabelText('消息附件').textContent).toContain('upload.png');
  });
  it('cancels in-flight uploads, ignores their late receipt, then supports remove and fresh paste', async () => {
    const upload = Promise.withResolvers<any>(); let count = 0;
    const f = pageFixture({ capabilities: uploadCapabilities }, undefined, undefined, { operation: () => ++count === 1 ? upload.promise : Promise.resolve(fileReceipt) });
    const view = render(h(f.Page)); await view.findByRole('button', { name: '添加附件' });
    fireEvent.change(view.getByLabelText('上传附件'), { target: { files: [new File(['abcd'], 'upload.png', { type: 'image/png' })] } });
    await view.findByText('正在上传，等待云端回执…');
    const uploading = f.remote.assistantExecute.mock.calls.find(call => call[1] === 'attachment-upload')!;
    fireEvent.click(view.getByRole('button', { name: '取消上传' }));
    expect(uploading[3]!.aborted).toBe(true); expect(view.getByText('上传已取消，尚未发送给助理')).toBeTruthy();
    await act(async () => upload.resolve(fileReceipt)); expect(view.queryByText('已上传，等待发送')).toBeNull();
    fireEvent.click(view.getByRole('button', { name: '移除附件：upload.png' })); expect(view.queryByLabelText('待发送附件')).toBeNull();
    fireEvent.paste(view.getByLabelText('发给助理'), { clipboardData: { files: [new File(['abcd'], 'upload.png', { type: 'image/png' })], getData: () => '' } });
    await view.findByText('已上传，等待发送');
    expect(f.remote.assistantExecute.mock.calls.filter(call => call[1] === 'attachment-upload')).toHaveLength(2);
    expect(f.remote.assistantExecute.mock.calls.some(call => call[1] === 'submit')).toBe(false);
  });
  it('keeps failed uploads visible for retry and preserves ready receipts across page remount', async () => {
    let count = 0;
    const f = pageFixture({ capabilities: uploadCapabilities }, undefined, undefined, { operation: () => { if (++count === 1) throw Error('受控上传失败'); return fileReceipt; } });
    const first = render(h(f.Page)); await first.findByRole('button', { name: '添加附件' });
    fireEvent.drop(first.getByLabelText('发给助理').closest('form')!, { dataTransfer: { files: [new File(['abcd'], 'upload.png', { type: 'image/png' })] } });
    fireEvent.click(await first.findByRole('button', { name: '重试上传' }));
    await first.findByText('已上传，等待发送'); first.unmount();
    const second = render(h(f.Page)); await second.findByText('已上传，等待发送');
    expect(count).toBe(2); expect((second.getByRole('button', { name: '发送', exact: true }) as HTMLButtonElement).disabled).toBe(false);
  });
  it('does not upload attachments on older clouds, and blocks unsupported image types locally', async () => {
    const old = pageFixture(), first = render(h(old.Page)); await first.findByLabelText('发给助理');
    expect(first.queryByRole('button', { name: '添加附件' })).toBeNull(); first.unmount();
    const f = pageFixture({ capabilities: uploadCapabilities }), view = render(h(f.Page)); await view.findByRole('button', { name: '添加附件' });
    fireEvent.change(view.getByLabelText('上传附件'), { target: { files: [new File(['<svg/>'], 'active.svg', { type: 'image/svg+xml' })] } });
    expect(view.getByRole('alert').textContent).toContain('暂不支持这种图片格式');
    expect(f.remote.assistantExecute.mock.calls.some(call => call[1] === 'attachment-upload')).toBe(false);
  });
  it('downloads only native file references and leaves generated paths inert even with download capability', async () => {
    const file = { attachmentId: `sha256:${'c'.repeat(64)}`, name: 'report.html', bytes: 4 };
    const remote = vi.fn().mockResolvedValue({ attachment: file, data: 'YWJjZA==' });
    const f = fixture(remote), events = history({ userContent: [{ type: 'file', attachment: file }] });
    events.push(at(11, 'deliverables/presented', { turn: 1, callId: 'deliver', files: [{ path: '/cloud/private/generated.html', ...file, name: 'generated.html' }] }));
    const props = f.props(events); props.view.capabilities.display.files = true;
    const downloads: any[] = [];
    vi.spyOn(window.HTMLAnchorElement.prototype, 'click').mockImplementation(function () { downloads.push({ href: this.href, download: this.download }); });
    const view = render(h(f.component, props));
    const generated = view.getByText('generated.html').closest('[data-assistant-file]')!;
    expect(generated.querySelector('button,a')).toBeNull(); expect(generated.textContent).toContain('不支持安全下载');
    fireEvent.click(view.getByRole('button', { name: '下载文件：report.html' }));
    await waitFor(() => expect(downloads).toHaveLength(1));
    expect(downloads[0].href).toMatch(/^blob:/); expect(downloads[0].download).toBe('report.html');
    expect(remote.mock.calls[0].slice(0, 3)).toEqual(['cloud-owned', 'file-read', { attachmentId: file.attachmentId }]);
    expect(f.hostRemote.openFile).not.toHaveBeenCalled(); expect(f.hostRemote.readFile).not.toHaveBeenCalled();
    view.unmount(); expect(f.urls.revokeObjectURL).toHaveBeenCalledTimes(1);
  });
  it('keeps download failure inline and retries safely without local navigation', async () => {
    const file = { attachmentId: `sha256:${'c'.repeat(64)}`, name: 'report.txt', bytes: 4 };
    const remote = vi.fn().mockRejectedValueOnce(Error('Unavailable')).mockResolvedValue({ attachment: file, data: 'YWJjZA==' });
    const f = fixture(remote), props = f.props(history({ userContent: [{ type: 'file', attachment: file }] })); props.view.capabilities.display.files = true;
    const click = vi.spyOn(window.HTMLAnchorElement.prototype, 'click').mockImplementation(() => {});
    const view = render(h(f.component, props)); fireEvent.click(view.getByRole('button', { name: '下载文件：report.txt' }));
    await view.findByText('文件下载失败，请重试');
    fireEvent.click(view.getByRole('button', { name: '下载文件：report.txt' }));
    await waitFor(() => expect(click).toHaveBeenCalledTimes(1)); expect(remote).toHaveBeenCalledTimes(2);
  });
});

const approval = () => ({ kind: 'approval', requestId: 'approval-1', generation: 'host-generation-1', hostId: 'cloud-host', sessionId: 'cloud-session', turn: 1, turnStartSeq: 0, toolName: 'write_report', reason: '保存报告', presentation: '保存报告', canAllow: true, expiresAt: Date.now() + 120000, choices: ['allowed-once', 'rejected'] });
describe('Assistant live native approval confirmation', () => {
  it('does not turn history audit rows or disabled live requests into approval buttons', async () => {
    const f = pageFixture({ status: 'running', events: [at(1, 'approval/asked', { toolName: 'write_report' })], pendingInteractions: [approval()], capabilities: { history: { nativeEvents: true }, approval: { interactive: false, reason: 'policy-never' } } });
    const view = render(h(f.Page)); await view.findByText(/历史记录不能再次批准/);
    expect(view.queryByRole('button', { name: '允许这一次' })).toBeNull(); expect(view.queryByRole('button', { name: '拒绝' })).toBeNull();
  });
  it('requires the real native risk acknowledgement and sends a scope-bound one-shot decision', async () => {
    const request = approval();
    const f = pageFixture({ status: 'running', pendingInteractions: [request], capabilities: { approval: { interactive: true, reason: 'available' } } }, undefined, undefined,
      { operation: (_id: string, _operation: string, input: any) => ({ accepted: true, outcome: input.decision }) });
    const view = render(h(f.Page)); fireEvent.click(await view.findByRole('button', { name: '允许这一次' }));
    const dialog = view.getByRole('dialog', { name: '允许这一次操作' });
    const confirm = within(dialog).getByRole('button', { name: '确认允许这一次' }) as HTMLButtonElement;
    expect(confirm.disabled).toBe(true); fireEvent.click(within(dialog).getByRole('checkbox')); expect(confirm.disabled).toBe(false);
    fireEvent.click(confirm); await waitFor(() => expect(view.queryByRole('dialog')).toBeNull());
    await view.findByText('决定已送达，等待云端处理。');
    const call = f.remote.assistantExecute.mock.calls.find(row => row[1] === 'approval-decide')!;
    expect(call[2]).toEqual({ requestId: request.requestId, generation: request.generation, hostId: request.hostId, sessionId: request.sessionId, turn: 1, turnStartSeq: 0, decision: 'allowed-once' });
    expect(view.queryByText('工具已执行')).toBeNull();
    expect((view.getByRole('button', { name: '允许这一次' }) as HTMLButtonElement).disabled).toBe(true);
    f.setSnapshot({ pendingInteractions: [], status: 'completed', asOfSeq: 2 }); await f.poll();
    expect(view.queryByLabelText('待审批：write_report')).toBeNull();
  });
  it('dismisses confirmation when its live request is replaced and cannot approve the replacement', async () => {
    const request = approval();
    const f = pageFixture({ status: 'running', pendingInteractions: [request], capabilities: { approval: { interactive: true } } });
    const view = render(h(f.Page)); fireEvent.click(await view.findByRole('button', { name: '允许这一次' }));
    fireEvent.click(view.getByRole('checkbox')); expect(view.getByRole('dialog')).toBeTruthy();
    f.setSnapshot({ pendingInteractions: [{ ...request, requestId: 'approval-new' }], asOfSeq: 2 }); await f.poll();
    expect(view.queryByRole('dialog')).toBeNull();
    expect(f.remote.assistantExecute.mock.calls.some(row => row[1] === 'approval-decide')).toBe(false);
    fireEvent.click(view.getByRole('button', { name: '允许这一次' }));
    expect((view.getByRole('button', { name: '确认允许这一次' }) as HTMLButtonElement).disabled).toBe(true);
    fireEvent.click(view.getByRole('button', { name: '返回' })); expect(view.queryByRole('dialog')).toBeNull();
  });
});

describe('Assistant approval presentation and deny-only requests', () => {
  it('shows localized safe presentation even when raw reason is absent', async () => {
    const request = { ...approval(), reason: undefined, presentation: '将报告保存到云端项目目录', displayReason: { zh: '将报告保存到云端项目目录' } };
    const f = pageFixture({ status: 'running', pendingInteractions: [request], capabilities: { approval: { interactive: true } } });
    const view = render(h(f.Page)); await view.findByText('将报告保存到云端项目目录');
    fireEvent.click(view.getByRole('button', { name: '允许这一次' }));
    expect(view.getByRole('dialog').textContent).toContain('将报告保存到云端项目目录');
    fireEvent.keyDown(view.getByRole('checkbox'), { key: 'Escape' });
    expect(view.queryByRole('dialog')).toBeNull();
    expect(f.remote.assistantExecute.mock.calls.some(row => row[1] === 'approval-decide')).toBe(false);
  });
  it('keeps requests with unavailable details visible but only permits rejection', async () => {
    const request = { ...approval(), reason: undefined, presentation: '操作详情不可用，当前请求只能拒绝', canAllow: false, choices: ['rejected'] };
    const f = pageFixture({ status: 'running', pendingInteractions: [request], capabilities: { approval: { interactive: true } } }, undefined, undefined,
      { operation: (_id: string, _operation: string, input: any) => ({ accepted: true, outcome: input.decision }) });
    const view = render(h(f.Page)); await view.findByText('操作详情不可用，当前请求只能拒绝');
    expect(view.queryByRole('button', { name: '允许这一次' })).toBeNull();
    fireEvent.click(view.getByRole('button', { name: '拒绝' }));
    await waitFor(() => expect(f.remote.assistantExecute.mock.calls.some(row => row[1] === 'approval-decide' && row[2].decision === 'rejected')).toBe(true));
  });
});
