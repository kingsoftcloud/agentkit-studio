// @vitest-environment jsdom
import * as React from 'react';
import { Context, Service } from '@deepseek-ai/cordis';
import { createSnapshotStore } from '@deepseek-ai/dsh-client-store';
import * as renderer from '@deepseek-ai/dsh-client-ui-renderer/client';
import * as locale from '@deepseek-ai/dsh-client-locale/client';
import * as schedule from '@deepseek-ai/dsh-client-ui-schedule/client';
import { act, fireEvent, render, screen, waitFor, within } from '@testing-library/react';
import { afterEach, expect, it, vi } from 'vitest';
import { createAssistantScheduleGraph } from '@studio/src/client/dsh/assistant-schedule-graph.mjs';
import { createAssistantNativeSchedule } from '@studio/src/client/components/assistant-native-schedule.mjs';
const disposers: Array<() => Promise<void>> = [];
afterEach(async () => { for (const dispose of disposers.splice(0).reverse()) await dispose(); vi.unstubAllGlobals(); });

it('native cloud task manager edits complete CAS record, reads delivery history, and deletes without a local Session', async () => {
  vi.stubGlobal('ResizeObserver', class { observe() {} unobserve() {} disconnect() {} });
  const initial = { id: 'task-one', kind: 'weekly', title: 'Weekly report', prompt: 'Check report', scheduledAt: '2030-01-01T09:00:00.000Z', time: '09:00:00.000', timeZone: 'UTC', weekdays: [1, 3] };
  let current: any = { ...initial }, removed = false;
  const calls: Array<{ operation: string; input: any }> = [];
  const execute = async (agentId: string, operation: string, input: any) => {
    expect(agentId).toBe('assistant-one'); expect(input.conversation).toBe('personal'); expect(input.sessionId).toBeUndefined();
    calls.push({ operation, input });
    if (operation === 'schedule-catalog') return { sessionId: 'cloud-one', items: removed ? [] : [{ ...current, sessionId: 'cloud-one', status: 'active' }] };
    if (operation === 'schedule-update') {
      expect(input.expected).toEqual(initial);
      current = { ...current, ...(input.title === undefined ? {} : { title: input.title }) };
      return { id: current.id, updated: true, record: current };
    }
    if (operation === 'schedule-history') return { id: 'task-one', records: [{ scheduledAt: '2026-10-19T09:00:00.000Z', deliveredAt: '2026-10-19T09:00:01.000Z', messageId: 'delivery-one', prompt: 'Earlier instruction' }], earlierRecordsUnavailable: false, earlierRecordsPruned: false, retention: { days: 30, records: 200 } };
    if (operation === 'schedule-delete') { removed = true; return { id: 'task-one', deleted: true }; }
    throw new Error('Unscoped operation: ' + operation);
  };
  const graph = await createAssistantScheduleGraph({ modules: { Context, Service, React, renderer, locale, schedule, createSnapshotStore }, execute,
    agentId: 'assistant-one', sessionId: 'cloud-one', onConversation: vi.fn() });
  const container = document.createElement('div'); document.body.append(container);
  disposers.push(async () => { await act(async () => { await graph.dispose(); }); container.remove(); });
  await act(async () => { graph.mount(container); });
  await waitFor(() => expect(screen.getByText('Weekly report')).toBeTruthy());
  fireEvent.click(screen.getByText('Weekly report'));
  const title = screen.getByRole('textbox', { name: 'Automation task name' });
  fireEvent.change(title, { target: { value: 'Revised report' } });
  fireEvent.blur(title);
  fireEvent.click(screen.getByRole('button', { name: 'Save changes' }));
  await waitFor(() => expect(calls.filter(call => call.operation === 'schedule-update')).toHaveLength(1));
  fireEvent.click(screen.getByRole('tab', { name: 'Records' }));
  await waitFor(() => expect(screen.getByText('Earlier instruction')).toBeTruthy());
  expect(calls.find(call => call.operation === 'schedule-history')?.input).toMatchObject({ id: 'task-one', limit: 20 });
  expect(graph.ctx.get('sessions')).toBeUndefined();
  expect(graph.ctx.get('sessionController')).toBeUndefined();
  fireEvent.click(screen.getByRole('button', { name: 'Automation task actions' }));
  fireEvent.click(screen.getByRole('menuitem', { name: 'Delete task' }));
  fireEvent.click(within(screen.getByRole('dialog')).getByRole('button', { name: 'Confirm deletion' }));
  await waitFor(() => expect(calls.filter(call => call.operation === 'schedule-delete')).toHaveLength(1));
  expect(calls.every(call => call.operation.startsWith('schedule-'))).toBe(true);
});

it.each(['switch-agent', 'unmount'] as const)('native task mutation stays with its original cloud owner after %s before acknowledgement', async transition => {
  vi.stubGlobal('ResizeObserver', class { observe() {} unobserve() {} disconnect() {} });
  const records = new Map([
    ['assistant-one', { id: 'task-one', kind: 'every', title: 'First assistant task', prompt: 'First instruction', scheduledAt: '2030-01-01T09:00:00.000Z', everySeconds: 3600 }],
    ['assistant-two', { id: 'task-two', kind: 'every', title: 'Second assistant task', prompt: 'Second instruction', scheduledAt: '2030-01-01T09:00:00.000Z', everySeconds: 7200 }],
  ]);
  const calls: Array<{ agentId: string; operation: string; input: any; signal: AbortSignal }> = [];
  let acknowledge!: () => void;
  const assistantExecute = async (agentId: string, operation: string, input: any, signal: AbortSignal) => {
    calls.push({ agentId, operation, input, signal });
    const record = records.get(agentId)!;
    if (operation === 'schedule-catalog') return { sessionId: agentId === 'assistant-one' ? 'cloud-one' : 'cloud-two', items: [{ ...record, sessionId: agentId === 'assistant-one' ? 'cloud-one' : 'cloud-two', status: 'active' }] };
    if (operation === 'schedule-update') {
      expect(agentId).toBe('assistant-one'); expect(input.expected).toEqual(record);
      // The server may have accepted a write even when its acknowledgement arrives after view disposal.
      await new Promise<void>(resolve => { acknowledge = resolve; });
      const updated = { ...record, title: input.title }; records.set(agentId, updated);
      return { id: record.id, updated: true, record: updated };
    }
    throw new Error('Unexpected cloud mutation: ' + operation);
  };
  const AssistantNativeSchedule = createAssistantNativeSchedule({ ui: { React, BRAND: {}, Button: 'button' },
    hostRemote: { assistantExecute }, nativeModules: () => ({ Context, Service, React, renderer, locale, schedule, createSnapshotStore }) });
  const view = render(React.createElement(AssistantNativeSchedule, { agentId: 'assistant-one', sessionId: 'cloud-one', onConversation: vi.fn() }));
  disposers.push(async () => { await act(async () => { view.unmount(); await Promise.resolve(); }); });
  await waitFor(() => expect(screen.getByText('First assistant task')).toBeTruthy());
  fireEvent.click(screen.getByText('First assistant task'));
  const title = screen.getByRole('textbox', { name: 'Automation task name' });
  fireEvent.change(title, { target: { value: 'Late first assistant result' } }); fireEvent.blur(title);
  fireEvent.click(screen.getByRole('button', { name: 'Save changes' }));
  await waitFor(() => expect(calls.filter(call => call.operation === 'schedule-update')).toHaveLength(1));
  const pending = calls.find(call => call.operation === 'schedule-update')!;
  await act(async () => {
    if (transition === 'switch-agent') view.rerender(React.createElement(AssistantNativeSchedule, { agentId: 'assistant-two', sessionId: 'cloud-two', onConversation: vi.fn() }));
    else view.unmount();
    await Promise.resolve();
  });
  expect(pending.signal.aborted).toBe(true);
  if (transition === 'switch-agent') await waitFor(() => expect(screen.getByText('Second assistant task')).toBeTruthy());
  await act(async () => { acknowledge(); await Promise.resolve(); });
  expect(records.get('assistant-one')?.title).toBe('Late first assistant result');
  expect(records.get('assistant-two')?.title).toBe('Second assistant task');
  expect(calls.filter(call => call.operation !== 'schedule-catalog')).toEqual([pending]);
  expect(calls.every(call => call.input.conversation === 'personal' && call.input.sessionId === undefined)).toBe(true);
  expect(screen.queryByText('Late first assistant result')).toBeNull();
  expect(screen.queryByRole('alert')).toBeNull();
  if (transition === 'switch-agent') expect(screen.getByText('Second assistant task')).toBeTruthy();
});
