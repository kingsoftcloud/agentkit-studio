+/** Keep the real provider on each row. The current alias wins its duplicate
+ * so reopening the menu preserves its selected route and capabilities. */
+export function presentationGroups(groups: readonly ModelProviderGroup[], selected: ModelSelection | null) {
+  const output = new Map<string, { provider: { id: string; name: string }
+    rows: Map<string, ModelProviderGroup['models'][number] & {
+      route: { id: string; name: string }
+    }> }>()
+  for (const group of groups) {
+    for (const model of group.models) {
+      const provider = model.presentationProvider ?? { id: group.id, name: group.name }
+      let display = output.get(provider.id)
+      if (display === undefined) {
+        display = { provider, rows: new Map() }
+        output.set(provider.id, display)
+      }
+      const previous = display.rows.get(model.id)
+      const current = selected?.provider === group.id && selected.model === model.id
+      const previousCurrent = selected?.provider === previous?.route.id && selected?.model === model.id
+      if (previous === undefined || current || !previousCurrent && previous.route.id !== provider.id && group.id === provider.id) {
+        display.rows.set(model.id, { ...model, route: { id: group.id, name: group.name } })
+      }
+    }
+  }
+  return [...output.values()].map(group => ({ id: group.provider.id, provider: group.provider, models: [...group.rows.values()] }))
+}
