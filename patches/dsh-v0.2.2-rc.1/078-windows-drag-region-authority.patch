@@ -0,0 +1,194 @@
+import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import {
+  installWindowsDragRegion,
+  readProductPluginInventory,
+  WINDOWS_DRAG_DIAGNOSTIC_FILE,
+  WINDOWS_DRAG_REGION_CSS,
+  WINDOWS_DRAG_STRIP_MARKER,
+  windowsDragBootstrapScript,
+  windowsDragSnapshotScript,
+  type DragRegionWindow,
+} from '../src/windows-drag-region.ts'
+
+const roots: string[] = []
+afterEach(async () => {
+  vi.useRealTimers()
+  await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true })))
+})
+
+async function scratch(): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), 'desktop-drag-region-'))
+  roots.push(root)
+  return root
+}
+
+class FakeWebContents {
+  readonly css: { css: string; options?: { cssOrigin?: 'user' | 'author' } }[] = []
+  readonly scripts: string[] = []
+  url = 'dsh://app/'
+  snapshot: unknown = { url: 'dsh://app/', html: { marker: true, style: { computed: 'no-drag' } } }
+  private readonly listeners = new Map<string, (() => void)[]>()
+  insertCSS = vi.fn(async (css: string, options?: { cssOrigin?: 'user' | 'author' }) => {
+    this.css.push({ css, options })
+    return 'inserted-css-key'
+  })
+  executeJavaScript = vi.fn(async (code: string) => {
+    this.scripts.push(code)
+    return this.snapshot
+  })
+  getURL = (): string => this.url
+  on(event: string, listener: () => void): this {
+    this.listeners.set(event, [...this.listeners.get(event) ?? [], listener])
+    return this
+  }
+  emit(event: string): void {
+    for (const listener of this.listeners.get(event) ?? []) listener()
+  }
+}
+
+class FakeWindow implements DragRegionWindow {
+  readonly webContents = new FakeWebContents()
+  readonly events = new Map<string, (() => void)[]>()
+  destroyed = false
+  fullscreen = false
+  on(event: string, listener: () => void): this {
+    this.events.set(event, [...this.events.get(event) ?? [], listener])
+    return this
+  }
+  emit(event: string): void {
+    for (const listener of this.events.get(event) ?? []) listener()
+  }
+  isDestroyed(): boolean { return this.destroyed }
+  isFullScreen(): boolean { return this.fullscreen }
+}
+
+async function settled(): Promise<void> {
+  await Promise.resolve()
+  await new Promise(resolve => setTimeout(resolve, 0))
+  await Promise.resolve()
+}
+
+function environment(logPath: string, overrides: Record<string, unknown> = {}) {
+  return {
+    app: { name: 'AgentKit Studio', version: '0.2.2-rc.1', electron: '44.0.0', platform: 'win32', arch: 'x64' },
+    logPath,
+    now: () => new Date('2026-11-07T00:00:00.000Z'),
+    ...overrides,
+  }
+}
+
