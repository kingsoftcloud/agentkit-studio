diff --git a/apps/desktop/tests/studio-paths.spec.ts b/apps/desktop/tests/studio-paths.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89a9a8e873e90f4b6d2ab51ab6c7171b44ab5ed0
--- /dev/null
+++ b/apps/desktop/tests/studio-paths.spec.ts
@@ -0,0 +1,13 @@
+import { expect, it } from 'vitest'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+const sharedHome = join(tmpdir(), 'studio-paths-shared-dsh')
+import { resolveDesktopPaths } from '../src/paths.ts'
+it('Windows Studio isolates plugin state while retaining the DSH home', () => {
+  expect(resolveDesktopPaths(sharedHome, 'win32', 'AgentKit Studio')).toEqual({
+    profile: join(sharedHome, 'profiles', 'desktop-agentkit-studio'),
+    lock: join(sharedHome, 'profiles', 'desktop-agentkit-studio', 'lock'),
+  })
+  expect(resolveDesktopPaths(sharedHome, 'darwin', 'AgentKit Studio').profile).toBe(join(sharedHome, 'profiles', 'desktop'))
+  expect(resolveDesktopPaths(sharedHome, 'win32', 'DeepSeek Harness').profile).toBe(join(sharedHome, 'profiles', 'desktop'))
+})
