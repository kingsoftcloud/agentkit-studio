diff --git a/apps/desktop-host/src/plugin-market-default.ts b/apps/desktop-host/src/plugin-market-default.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ef40fa697a5698b2624484df412b751276487f8
--- /dev/null
+++ b/apps/desktop-host/src/plugin-market-default.ts
@@ -0,0 +1,47 @@
+/** Desktop release defaults persisted through the official plugin market settings. */
+
+import { readFile, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { readProfileManifest, type ProfileManifest } from '@deepseek-ai/dsh-app-boot'
+
+interface PluginMarket {
+  listIndexes(): { readonly url: string }[]
+  setIndexes(urls: string[]): Promise<void>
+}
+
+/**
+ * Put the packaged index first once per Desktop version and URL for this profile.
+ * @param runtimeDir - The installation's sealed runtime directory.
+ * @param profileDir - The user's external Desktop profile.
+ * @param market - Plugin market service from the fully booted profile.
+ */
+export async function applyDefaultPluginIndex(
+  runtimeDir: string, profileDir: string, market: PluginMarket | undefined,
+): Promise<void> {
+  if (market === undefined) return
+  const runtime = readProfileManifest('dsh desktop', runtimeDir) as ProfileManifest & {
+    dsh?: { profile?: { defaultPluginIndexUrl?: unknown } }
+  }
+  const version = runtime.version
+  const url = runtime.dsh?.profile?.defaultPluginIndexUrl
+  if (typeof url !== 'string' || url === '' || typeof version !== 'string') return
+
+  const marker = join(profileDir, 'desktop-default-plugin-index.json')
+  const previous = await readFile(marker, 'utf8')
+    .then(text => JSON.parse(text) as { url?: unknown; version?: unknown } | null)
+    .catch((error: NodeJS.ErrnoException) => {
+      if (error.code !== 'ENOENT' && !(error instanceof SyntaxError)) throw error
+      return null
+    })
+  if (previous?.url === url && previous.version === version) return
+
+  const indexes = new Map([[url, url]])
+  for (const { url: existing } of market.listIndexes()) {
+    const key = URL.parse(existing)?.href ?? existing
+    // Keep the first position, preferring a canonical spelling when both exist.
+    if (!indexes.has(key) || existing === key) indexes.set(key, existing)
+  }
+  await market.setIndexes([...indexes.values()])
+  // An interrupted or failed settings write must remain eligible on the next launch.
+  await writeFile(marker, `${JSON.stringify({ url, version })}\n`, { mode: 0o600 })
+}
diff --git a/apps/desktop-host/tests/plugin-market-default.spec.ts b/apps/desktop-host/tests/plugin-market-default.spec.ts
