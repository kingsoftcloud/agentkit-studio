index 0000000000000000000000000000000000000000..f7274f0cf81b798dc1590d1c68bf19b223dc0bb2
--- /dev/null
+++ b/apps/desktop-host/tests/plugin-market-default.spec.ts
@@ -0,0 +1,75 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import { applyDefaultPluginIndex } from '../src/plugin-market-default.ts'
+
+const productIndex = 'https://market.example.org/studio/index.json'
+const communityIndex = 'http://127.0.0.1:3080/api/agentkit.plugin-market/index.json'
+const userIndex = 'https://user-market.example.org/index.json'
+const roots: string[] = []
+
+function fixture(indexes: string[] = []) {
+  const runtime = mkdtempSync(join(tmpdir(), 'desktop-default-market-'))
+  roots.push(runtime)
+  const profile = join(runtime, 'profile')
+  mkdirSync(profile)
+  function release(version: string, defaultPluginIndexUrl?: string) {
+    writeFileSync(join(runtime, 'package.json'), JSON.stringify({
+      version, dsh: { profile: { defaultPluginIndexUrl } },
+    }))
+  }
+  const market = {
+    listIndexes: () => indexes.map(url => ({ url })),
+    setIndexes: vi.fn(async (urls: string[]) => { indexes = urls }),
+  }
+  return { release, market, apply: () => applyDefaultPluginIndex(runtime, profile, market) }
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+it('puts the configured source first on a clean profile and honors removals until the next Desktop release', async () => {
+  const { apply, market, release } = fixture()
+  release('1.2.3', productIndex)
+  await apply()
+  expect(market.setIndexes).toHaveBeenCalledExactlyOnceWith([productIndex])
+  await market.setIndexes([userIndex])
+  market.setIndexes.mockClear()
+  await apply()
+  expect(market.setIndexes).not.toHaveBeenCalled()
+
+  release('1.2.4', productIndex)
+  await apply()
+  expect(market.setIndexes).toHaveBeenCalledExactlyOnceWith([productIndex, userIndex])
+})
+
+it('retains existing sources in order and deduplicates equivalent URLs on upgrade', async () => {
+  const { apply, market, release } = fixture([
+    communityIndex, 'https://USER-market.example.org:443/index.json', 'https://Market.Example.org:443/studio/index.json',
+    userIndex, productIndex, communityIndex,
+  ])
+  release('1.2.4', productIndex)
+  await apply()
+  expect(market.setIndexes).toHaveBeenCalledExactlyOnceWith([productIndex, communityIndex, userIndex])
+
+  const newIndex = 'https://market.example.org/studio/new-index.json'
+  release('1.2.4', newIndex)
+  await apply()
+  expect(market.setIndexes).toHaveBeenLastCalledWith([newIndex, productIndex, communityIndex, userIndex])
+})
+
+it('leaves profiles alone with no configured product source and retries a failed settings write', async () => {
+  const { apply, market, release } = fixture([userIndex])
+  release('1.2.3')
+  await apply()
+  expect(market.setIndexes).not.toHaveBeenCalled()
+
+  release('1.2.4', productIndex)
+  market.setIndexes.mockRejectedValueOnce(new Error('settings unavailable'))
+  await expect(apply()).rejects.toThrow('settings unavailable')
+  await apply()
+  expect(market.setIndexes).toHaveBeenCalledTimes(2)
+  expect(market.setIndexes).toHaveBeenLastCalledWith([productIndex, userIndex])
+})
