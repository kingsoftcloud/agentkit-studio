+/** The same version card for a host-managed, separately verified release catalog. */
+export function ManagedVersionSection({ versions, t }: { readonly versions: ManagedItemVersions; readonly t: Translate }): ReactNode {
+  const [open, setOpen] = useState(false)
+  const glyph = versions.checking ? <StateDot state="ongoing" size={14} />
+    : versions.tone === 'info' ? <IconDownloadOutlineRegular size={14} />
+      : versions.tone === 'success' ? <IconCheckOutlineRegular size={14} />
+        : <IconWarningOutlineRegular size={14} />
+  const summary = <>
+    <Glyph tone={versions.tone}>{glyph}</Glyph>
+    <span className={css.versionSummaryText}>
+      <span className={css.versionSummaryTitle}>{versions.title}</span>
+      {versions.subtitle === undefined ? null : <span className={css.versionSummarySub}>{versions.subtitle}</span>}
+    </span>
+  </>
+  return (
+    <section className={css.detailSection} data-plugin-versions>
+      <div className={css.sectionHead}>
+        <h4 className={css.sectionTitle}>{t('versionsTitle')}</h4>
+        <span className={css.versionSpacer} />
+        <Button variant="ghost" size="sm" icon={<IconRefreshOutlineRegular size={13} />} disabled={versions.checking} onClick={versions.onCheck}>
+          {t('versionsRecheck')}
+        </Button>
+      </div>
+      <div className={css.versionPanel}>
+        {versions.rows.length > 0
+          ? <button type="button" className={css.versionSummary} aria-expanded={open} onClick={() => { setOpen(!open) }}>
+            {summary}
+            <span className={css.versionSummaryEnd}>
+              {open ? t('versionsCollapse') : (versions.expandLabel ?? t('versionsDetails'))}
+              <IconChevronDownOutlineRegular className={css.detailsChevron} aria-hidden="true" />
+            </span>
+          </button>
+          : <div className={css.versionSummary} role="status">{summary}</div>}
+        {open && versions.rows.length > 0 ? <div className={css.versionBody}>
