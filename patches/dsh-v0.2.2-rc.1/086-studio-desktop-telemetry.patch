diff --git a/apps/desktop/src/studio-telemetry.ts b/apps/desktop/src/studio-telemetry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..75751600dc912c5b7ec286f71a8fdbe5da621ad6
--- /dev/null
+++ b/apps/desktop/src/studio-telemetry.ts
@@ -0,0 +1,112 @@
+import { randomUUID } from 'node:crypto'
+import { readFile, rename, rm, stat, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { app, dialog, type BrowserWindow } from 'electron'
+import { desktopUpdateChannel } from './update-channel.ts'
+import type { StudioTelemetryStatus } from './ipc.ts'
+
+async function purgeOutbox(directory: string): Promise<void> {
+  const path = join(directory, 'outbox.jsonl')
+  const temporary = join(directory, 'outbox-' + randomUUID() + '.tmp')
+  try {
+    if ((await stat(path)).size > 6 * 1024 * 1024) return
+    const first = (await readFile(path, 'utf8')).split('\n', 1)[0]
+    const state = JSON.parse(first ?? '') as Record<string, unknown>
+    if (state.version !== 1) return
+    await writeFile(temporary, JSON.stringify({ ...state, launch: null, update: null, finishedRuns: {}, retryAt: 0 }) + '\n',
+      { mode: 0o600, flag: 'wx' })
+    await rename(temporary, path)
+  } catch { /* Missing state is normal and on-disk choices take precedence on upgrade. */ }
+  finally { await rm(temporary, { force: true }).catch(() => {}) }
+}
+
+export interface StudioTelemetry {
+  status(): StudioTelemetryStatus
+  applyNotice(choice: 'continue' | 'off'): Promise<StudioTelemetryStatus>
+  setPreference(category: unknown, enabled: unknown): Promise<StudioTelemetryStatus>
+  stopAll(options?: { clear?: boolean }): Promise<StudioTelemetryStatus>
+  preview(): string
+  beginLaunch(): void
+  finishLaunch(outcome: 'ready' | 'failed' | 'canceled', duration?: number): void
+  activity(): void
+  track(name: string, props: Record<string, unknown>): void
+  startUpdate(targetVersion: string): Promise<void>
+  finishUpdate(outcome: 'applied' | 'failed'): void
+  localRun(message: Record<string, unknown>): void
+  drain(): Promise<void>
+}
+
+interface StudioTelemetryExports {
+  resolveDesktopTelemetryConfig(options: {
+    release: unknown
+    selfHosted: string | undefined
+    disabled: string | undefined
+    packaged: boolean
+  }): unknown
+  createDesktopTelemetry(options: {
+    directory: string
+    config: unknown
+    dimensions: Record<string, string>
+  }): Promise<StudioTelemetry>
+}
+
+/**
+ * Load the Studio-owned sender from immutable packaging inputs. Native DSH
+ * artifacts don't carry it. A development run may point at its own staged inputs.
+ */
+export async function openStudioTelemetry(): Promise<StudioTelemetry | undefined> {
+  const source = app.isPackaged ? join(process.resourcesPath, 'studio-telemetry') : process.env.DSH_STUDIO_TELEMETRY_RESOURCES
+  if (!source) return undefined
+  const directory = join(app.getPath('userData'), 'studio-telemetry')
+  try {
+    const release = JSON.parse(await readFile(join(source, 'policy.json'), 'utf8')) as { buildOff?: boolean }
+    if (release.buildOff === true) {
+      await purgeOutbox(directory)
+      return undefined
+    }
+    const api = await import(pathToFileURL(join(source, 'desktop.mjs')).href) as StudioTelemetryExports
+    const config = api.resolveDesktopTelemetryConfig({
+      release, selfHosted: process.env.AGENTKIT_TELEMETRY_ENDPOINT,
+      disabled: process.env.AGENTKIT_TELEMETRY_DISABLED, packaged: app.isPackaged,
+    })
+    const manifest: unknown = JSON.parse(await readFile(join(app.getAppPath(), 'package.json'), 'utf8'))
+    return await api.createDesktopTelemetry({ directory, config, dimensions: {
+      app_version: app.getVersion(), channel: desktopUpdateChannel(manifest),
+      platform: process.platform, arch: process.arch,
+    } })
+  } catch {
+    console.warn('Studio telemetry is unavailable')
+    return undefined
+  }
+}
+
+/** Returns without a decision if the user closes or postpones the notice. */
+export async function showStudioTelemetryNotice(
+  window: BrowserWindow, telemetry: StudioTelemetry, locale: string,
+): Promise<void> {
+  const state = telemetry.status()
+  if (!state.noticePending || !state.endpoint || window.isDestroyed()) return
+  const zh = locale.toLowerCase().startsWith('zh')
+  const options = zh ? {
+    message: '数据与隐私',
+    detail: '基础统计用于了解安装环境的活跃、版本、启动和更新情况。崩溃统计和本地 Run 统计由你分别开启。遥测使用随机安装标识，包含类型、时长和计数。凭证、会话和完整日志保留在本机。接收方为 '
+      + state.endpoint + (state.selfHosted ? '，由自建服务管理留存和删除。' : '，事件保留 90 天。')
+      + '你可以在设置的「隐私与数据」中查看上报内容、关闭或清除本地数据，并按隐私说明请求删除已发送事件。',
+    buttons: ['继续', '关闭基础统计并继续', '稍后'],
+  } : {
+    message: 'Data and privacy',
+    detail: 'Basic statistics cover opening Studio, versions, startup and updates. Crash counts and local run statistics each have their own switch. Reports use a random installation ID and contain categories, durations and counts. Credentials, conversations and full logs stay local. Data is sent to '
+      + state.endpoint + (state.selfHosted ? '. The self-hosted service manages retention and deletion.' : ' and kept for 90 days.')
+      + ' In Settings you can inspect reports, turn collection off or clear local data, and follow the privacy notice to request deletion of sent data.',
+    buttons: ['Continue', 'Turn off basic statistics and continue', 'Later'],
+  }
+  const detail = options.detail + (state.defaultBasic
+    ? (zh ? '\n\n此版本默认开启基础统计。' : '\n\nBasic statistics are on by default for this distribution.')
+    : (zh ? '\n\n此版本默认关闭基础统计，可在设置中开启。' : '\n\nBasic statistics are off by default. You can enable them in Settings.'))
+  const { response } = await dialog.showMessageBox(window, {
+    type: 'info', message: options.message, detail, buttons: options.buttons,
+    defaultId: 0, cancelId: 2, noLink: true,
+  })
+  if (response === 0 || response === 1) await telemetry.applyNotice(response === 0 ? 'continue' : 'off')
+}
