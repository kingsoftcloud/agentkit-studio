index 0000000000000000000000000000000000000000..d45132a65c480b1babede13b1a70827053fc3afc
--- /dev/null
+++ b/apps/desktop/tests/package-ci-metadata.spec.ts
@@ -0,0 +1,42 @@
+import { mkdtemp, mkdir, rm, stat, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { createRequire } from 'node:module'
+import { expect, it } from 'vitest'
+import { createElectronBuilderConfig } from '../scripts/electron-builder-config.mjs'
+
+const require = createRequire(import.meta.url)
+const { FileMatcher } = require('app-builder-lib/out/fileMatcher.js') as typeof import('app-builder-lib/out/fileMatcher.js')
+
+it('excludes unused Coveralls configuration in both runtime copy rules while retaining runtime files', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-package-ci-'))
+  const expected = new Map([
+    ['package.json', true], ['.coveralls.yml', false],
+    ['node_modules/debug/index.js', true], ['node_modules/debug/LICENSE', true],
+    ['node_modules/debug/package.json', true], ['node_modules/debug/.coveralls.yml', false],
+    ['node_modules/debug/.coveralls.yaml', false], ['node_modules/outer/node_modules/debug/.coveralls.yml', false],
+    ['node_modules/@earendil-works/pi-ai/dist/providers/data/.manifest.json', true],
+  ])
+  try {
+    for (const name of expected.keys()) {
+      const path = join(root, name)
+      await mkdir(dirname(path), { recursive: true })
+      await writeFile(path, 'synthetic fixture only\n')
+    }
+    const config = createElectronBuilderConfig({
+      DSH_DESKTOP_APP_ID: 'com.kingsoftcloud.agentkit-studio.local',
+      DSH_DESKTOP_TARGET_PLATFORM: 'darwin', DSH_DESKTOP_TARGET_ARCH: 'arm64', DSH_DESKTOP_UNSIGNED: '1',
+    }, 'darwin', 'arm64', root)
+    const copies = config.files.filter(file => typeof file !== 'string')
+    expect(copies).toHaveLength(2)
+    for (const copy of copies) {
+      const matcher = new FileMatcher(copy.from, copy.to, pattern => pattern, [...copy.filter])
+      const filter = matcher.createFilter()
+      for (const [name, included] of expected) {
+        if (copy.from !== root && !name.startsWith('node_modules/')) continue
+        const file = join(root, name)
+        expect(filter(file, await stat(file)), `${copy.to}: ${name}`).toBe(included)
+      }
+    }
+  } finally { await rm(root, { recursive: true, force: true }) }
+})
