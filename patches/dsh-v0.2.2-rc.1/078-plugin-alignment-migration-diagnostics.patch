--- /dev/null
+++ b/apps/desktop/src/window-diagnostic.ts
@@ -0,0 +1,140 @@
+/**
+ * One sample of the loaded document, written after the window finishes loading.
+ *
+ * A client sheet that captions the whole viewport makes every button dead, and
+ * the same window looks identical whether the fix is missing, shadowed by an
+ * older profile copy, or overwritten by the shell. The sample records what the
+ * renderer actually resolved — the computed `-webkit-app-region` of `<html>` and
+ * `<body>`, the presence of the shell drag strip, and how many legacy drag
+ * markers the document still carries — so the next report can name the layer
+ * instead of guessing.
+ */
+
+import { join } from 'node:path'
+import { writeDiagnosticRecord, WINDOW_DIAGNOSTIC_FILE } from './plugin-alignment-log.ts'
+
+/** The part of `webContents` this sample needs; injected so tests dispatch a fake. */
+export interface DiagnosticContents {
+  getURL(): string
+  isDestroyed(): boolean
+  executeJavaScript(code: string): Promise<unknown>
+  on(event: 'did-finish-load', listener: () => void): unknown
+}
+
+/** Where and how the sample is taken. */
+export interface WindowDiagnosticOptions {
+  /** Directory that owns the record, normally `<userData>/logs`. */
+  readonly directory: string
+  readonly platform?: string | undefined
+  /** Product plugin version the Host resolved, when the shell knows it. */
+  readonly pluginVersion?: string | undefined
+  /** Delay after `did-finish-load` before sampling; the client bundle mounts late. */
+  readonly settleMs?: number | undefined
+  readonly now?: (() => number) | undefined
+}
+
+/** The document probes, evaluated inside the renderer. */
+export const WINDOW_SAMPLE_SCRIPT = `(() => {
+  const describe = (element) => {
+    if (element === null || element === undefined) return { computedAppRegion: null, inlineAppRegion: null }
+    const style = getComputedStyle(element)
+    const computed = (style.webkitAppRegion || style.getPropertyValue('-webkit-app-region') || '').trim()
+    return {
+      computedAppRegion: computed === '' ? null : computed,
+      inlineAppRegion: (element.style.webkitAppRegion || '').trim() || null,
+    }
+  }
+  const html = document.documentElement
+  return {
+    url: String(location.href),
+    html: { ...describe(html), windowsTitlebar: html instanceof HTMLElement
+      && html.hasAttribute('data-windows-titlebar') },
+    body: describe(document.body),
+    dragStrip: document.querySelector('[data-studio-window-drag-strip]') !== null,
+    legacyDragMarkers: document.querySelectorAll(
+      '[data-studio-drag-region],[data-studio-header],[data-window-drag]').length,
+  }
+})()`
+
+/**
+ * Keep only the parts of a page URL that identify the document.
+ *
+ * A local Host URL can carry a one-time token in its query string, and a
+ * diagnostic file must never store one.
+ * @param url - URL reported by `webContents.getURL()`.
+ * @returns scheme, host and path only.
+ */
+export function diagnosticUrl(url: string): string {
+  try {
+    const parsed = new URL(url)
+    return `${parsed.origin}${parsed.pathname}`
+  } catch {
+    return url.split(/[?#]/, 1)[0] ?? ''
+  }
+}
+
+/** Coerce the renderer answer into a record without trusting its shape. */
+function sampleRecord(value: unknown): Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return {}
+  const sample = value as Record<string, unknown>
+  const region = (entry: unknown): Record<string, unknown> => {
+    if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) return {}
+    const record = entry as Record<string, unknown>
+    return {
+      computedAppRegion: typeof record.computedAppRegion === 'string' ? record.computedAppRegion : null,
+      ...(typeof record.inlineAppRegion === 'string' ? { inlineAppRegion: record.inlineAppRegion } : {}),
+      ...(typeof record.windowsTitlebar === 'boolean' ? { windowsTitlebar: record.windowsTitlebar } : {}),
+    }
+  }
+  const markers = typeof sample.legacyDragMarkers === 'number' && Number.isFinite(sample.legacyDragMarkers)
+    ? sample.legacyDragMarkers
+    : null
+  return {
+    rendererUrl: typeof sample.url === 'string' ? diagnosticUrl(sample.url) : null,
+    html: region(sample.html),
+    body: region(sample.body),
+    dragStrip: typeof sample.dragStrip === 'boolean' ? sample.dragStrip : null,
+    legacyDragMarkers: markers,
+  }
+}
+
+/**
+ * Sample the document once per successful load and write the record.
+ *
+ * The sample is delayed because the product client mounts after the document
+ * finishes loading; sampling immediately would report the pre-hydration markup
+ * and accuse a working build of missing its drag strip.
+ * @param contents - the window's `webContents`, or a test double.
+ * @param options - record directory and timing.
+ */
+export function installWindowDiagnostic(contents: DiagnosticContents, options: WindowDiagnosticOptions): void {
+  const platform = options.platform ?? process.platform
+  const settle = options.settleMs ?? 2_000
+  contents.on('did-finish-load', () => {
+    const sample = (): void => {
+      if (contents.isDestroyed()) return
+      void contents.executeJavaScript(WINDOW_SAMPLE_SCRIPT)
+        .then(answer => ({ ...sampleRecord(answer) }))
+        .catch((error: unknown) => ({ error: error instanceof Error ? error.message : String(error) }))
+        .then(sample => {
+          writeDiagnosticRecord(options.directory, WINDOW_DIAGNOSTIC_FILE, {
+            schemaVersion: 1,
+            timestamp: new Date(options.now?.() ?? Date.now()).toISOString(),
+            platform,
+            url: diagnosticUrl(contents.getURL()),
+            ...(options.pluginVersion === undefined ? {} : { pluginVersion: options.pluginVersion }),
+            ...sample,
+          })
+        })
+    }
+    const timer: unknown = setTimeout(sample, settle)
+    // A pending sample must not hold the process open during quit.
+    if (typeof timer === 'object' && timer !== null && 'unref' in timer
+      && typeof (timer as { unref?: unknown }).unref === 'function') (timer as { unref(): void }).unref()
+  })
+}
+
+/** Resolve the record path for one directory; exported for the shell's report. */
+export function windowDiagnosticPath(directory: string): string {
+  return join(directory, WINDOW_DIAGNOSTIC_FILE)
+}
