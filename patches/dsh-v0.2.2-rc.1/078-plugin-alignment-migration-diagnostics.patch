@@ -0,0 +1,115 @@
+import { chmodSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import type { PluginAlignmentOutcome } from '../src/bundled-plugin-alignment.ts'
+import {
+  ALIGNMENT_LOG_FILE, LOG_RETENTION, alignmentLogAction, buildAlignmentReport, sanitizeReportValue,
+  writeAlignmentReport, writeDiagnosticRecord,
+} from '../src/plugin-alignment-log.ts'
+
+const roots: string[] = []
+
+function temporaryRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-alignment-log-'))
+  roots.push(root)
+  return root
+}
+
+function outcome(overrides: Partial<PluginAlignmentOutcome>): PluginAlignmentOutcome {
+  return { packageName: '@kingsoftcloud/agentkit-studio', action: 'retired', installationBacked: true, ...overrides }
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+describe('plugin alignment record', () => {
+  it('translates every outcome into the operator vocabulary', () => {
+    expect(alignmentLogAction(outcome({ action: 'retired' }))).toBe('retired')
+    expect(alignmentLogAction(outcome({ action: 'repaired-corrupt' }))).toBe('reinstalled')
+    expect(alignmentLogAction(outcome({ action: 'downgraded' }))).toBe('reinstalled')
+    expect(alignmentLogAction(outcome({ action: 'skipped-equal' }))).toBe('kept')
+    expect(alignmentLogAction(outcome({ action: 'skipped-absent' }))).toBe('kept')
+    expect(alignmentLogAction(outcome({ action: 'kept-newer' }))).toBe('kept')
+    expect(alignmentLogAction(outcome({ action: 'restored', reason: 'locked' }))).toBe('failed')
+    expect(alignmentLogAction(outcome({ action: 'missing-runtime-copy' }))).toBe('failed')
+  })
+
+  it('reports a failure above a migration in the aggregate action', () => {
+    const report = buildAlignmentReport({
+      platform: 'win32',
+      copies: [{ packageName: '@kingsoftcloud/agentkit-studio', path: 'C:\\p', version: '0.0.12' }],
+      outcomes: [
+        outcome({ action: 'retired', previousVersion: '0.0.12', bundledVersion: '0.0.13', resolvedVersion: '0.0.13' }),
+        outcome({ packageName: 'other', action: 'restored', bundledVersion: '1.0.0', reason: 'EBUSY' }),
+      ],
+    })
+    expect(report.action).toBe('failed')
+    expect(report.actions.map(entry => entry.action)).toEqual(['retired', 'failed'])
+    expect(report.actions[1]?.reason).toBe('EBUSY')
+    expect(report.loadedPluginVersion).toBe('0.0.13')
+    expect(report.platform).toBe('win32')
+  })
+
+  it('writes the required fields and keeps five records', () => {
+    const directory = join(temporaryRoot(), 'logs')
+    for (let index = 0; index < LOG_RETENTION + 2; index += 1) {
+      const path = writeAlignmentReport(directory, {
+        outcomes: [outcome({ action: 'skipped-equal', previousVersion: '0.0.13', bundledVersion: '0.0.13', resolvedVersion: '0.0.13' })],
+        copies: [], bundledVersion: '0.0.13', now: () => 1_700_000_000_000 + index,
+      })
+      expect(path).toBe(join(directory, ALIGNMENT_LOG_FILE))
+    }
+    const names = readdirSync(directory).filter(name => name.startsWith(ALIGNMENT_LOG_FILE)).sort()
+    expect(names).toEqual([
+      ALIGNMENT_LOG_FILE, `${ALIGNMENT_LOG_FILE}.1`, `${ALIGNMENT_LOG_FILE}.2`,
+      `${ALIGNMENT_LOG_FILE}.3`, `${ALIGNMENT_LOG_FILE}.4`,
+    ])
+    const latest = JSON.parse(readFileSync(join(directory, ALIGNMENT_LOG_FILE), 'utf8')) as Record<string, unknown>
+    expect(latest).toMatchObject({
+      schemaVersion: 1, action: 'kept', bundledPluginVersion: '0.0.13', loadedPluginVersion: '0.0.13',
+      profileCopies: [],
+    })
+    expect(typeof latest.timestamp).toBe('string')
+    expect(typeof latest.platform).toBe('string')
+  })
+
+  it('never writes credential-shaped properties', () => {
+    const directory = join(temporaryRoot(), 'logs')
+    // A future caller adding credentials to a record must not leak them.
+    const path = writeDiagnosticRecord(directory, ALIGNMENT_LOG_FILE, {
+      schemaVersion: 1, accessToken: 'leaked', nested: { apiKey: 'leaked', keep: 'visible' },
+    })
+    const body = readFileSync(path!, 'utf8')
+    expect(body).not.toContain('leaked')
+    expect(body).toContain('visible')
+    expect(sanitizeReportValue({ authToken: 'x' })).toEqual({})
+  })
+
+  it('bounds one record instead of dropping it', () => {
+    const directory = join(temporaryRoot(), 'logs')
+    const path = writeDiagnosticRecord(directory, ALIGNMENT_LOG_FILE, {
+      schemaVersion: 1, filler: 'x'.repeat(400_000),
+    })
+    expect(path).toBe(join(directory, ALIGNMENT_LOG_FILE))
+    expect(readFileSync(path!, 'utf8').length).toBeLessThanOrEqual(262_144)
+  })
+
+  it('returns undefined instead of throwing when the directory cannot be written', () => {
+    const root = temporaryRoot()
+    const directory = join(root, 'logs')
+    mkdirSync(directory, { recursive: true })
+    writeFileSync(join(directory, 'occupied'), 'x')
+    chmodSync(directory, 0o500)
+    try {
+      expect(writeAlignmentReport(directory, { outcomes: [outcome({ action: 'retired' })] })).toBeUndefined()
+    } finally {
+      chmodSync(directory, 0o700)
+    }
+    // A path that is a file, not a directory, is equally survivable.
+    const blocked = join(root, 'logs-file')
+    writeFileSync(blocked, 'x')
+    expect(writeAlignmentReport(join(blocked, 'logs'), { outcomes: [] })).toBeUndefined()
+  })
+})
