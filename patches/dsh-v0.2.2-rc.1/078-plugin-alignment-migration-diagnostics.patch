+/**
+ * Startup diagnostics for profile plugin alignment.
+ *
+ * An upgrade that keeps loading an older profile copy of the product plugin is
+ * invisible without a record: the window looks exactly like the broken build.
+ * The shell therefore writes what it compared, what it did, and which version
+ * the Host will load, plus one sample of the loaded document. Records are
+ * bounded so a machine that launches the application every day cannot grow the
+ * directory without limit.
+ */
+
+import { existsSync, mkdirSync, readdirSync, renameSync, rmSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import type { PluginAlignmentOutcome } from './bundled-plugin-alignment.ts'
+
+/** Stable name of the latest alignment record. */
+export const ALIGNMENT_LOG_FILE = 'plugin-alignment.json'
+/** Stable name of the latest window sample. */
+export const WINDOW_DIAGNOSTIC_FILE = 'window-diagnostic.json'
+/** Records kept per name: the current file plus four rotations. */
+export const LOG_RETENTION = 5
+/** Upper bound for one record; a bound record is trimmed, never dropped. */
+export const LOG_MAX_BYTES = 262_144
+
+/** Action vocabulary an operator reads first. */
+export type AlignmentLogAction = 'kept' | 'reinstalled' | 'retired' | 'failed'
+
+/** One profile copy that was inspected for a shadowing product plugin. */
+export interface AlignmentLogCopy {
+  readonly packageName: string
+  readonly path: string
+  readonly version: string | null
+}
+
+/** One alignment decision for one product bundle. */
+export interface AlignmentLogEvent {
+  readonly packageName: string
+  readonly action: AlignmentLogAction
+  readonly previousVersion: string | null
+  readonly bundledVersion: string | null
+  readonly reason?: string
+  readonly warning?: string
+  readonly backupPath?: string
+}
+
+/** The record written for one launch. */
+export interface AlignmentReport {
+  readonly schemaVersion: 1
+  readonly timestamp: string
+  readonly platform: string
+  readonly bundledPluginVersion: string | null
+  readonly loadedPluginVersion: string | null
+  readonly action: AlignmentLogAction
+  readonly actions: readonly AlignmentLogEvent[]
+  readonly profileCopies: readonly AlignmentLogCopy[]
+}
+
+/** Inputs the shell gathers before writing the record. */
+export interface AlignmentReportInput {
+  readonly platform?: string | undefined
+  readonly bundledVersion?: string | undefined
+  readonly loadedVersion?: string | undefined
+  readonly copies?: readonly AlignmentLogCopy[] | undefined
+  readonly outcomes: readonly PluginAlignmentOutcome[]
+  readonly now?: (() => number) | undefined
+}
+
+/** Properties that must never reach a diagnostic file. */
+const FORBIDDEN_KEY = /token|secret|passw(?:or)?d|authorization|cookie|credential|api[-_]?key/i
+/** Longest diagnostic string kept verbatim; stack traces are not wanted here. */
+const MAX_TEXT = 512
+
+/**
+ * Translate an alignment outcome into the operator-facing vocabulary.
+ *
+ * Retirement and quarantine both put the installation copy back in charge, so a
+ * repaired or downgraded profile reads as `reinstalled`; a degraded run reads as
+ * `failed` and carries its reason.
+ * @param outcome - one outcome from {@link alignBundledProductPlugins}.
+ * @returns the action recorded for that bundle.
+ */
+export function alignmentLogAction(outcome: PluginAlignmentOutcome): AlignmentLogAction {
+  switch (outcome.action) {
+    case 'retired': return 'retired'
+    case 'repaired-corrupt':
+    case 'downgraded': return 'reinstalled'
+    case 'skipped-equal':
+    case 'skipped-absent':
+    case 'kept-newer': return 'kept'
+    default: return 'failed'
+  }
+}
+
+/** Aggregate order: a failure outranks a migration, which outranks an unchanged profile. */
+const ACTION_PRECEDENCE: readonly AlignmentLogAction[] = ['failed', 'retired', 'reinstalled', 'kept']
+
+/** Shorten one diagnostic string without cutting a surrogate pair in half. */
+function clamp(value: string, limit = MAX_TEXT): string {
+  if (value.length <= limit) return value
+  let end = limit
+  const code = value.charCodeAt(end - 1)
+  if (code >= 0xd800 && code <= 0xdbff) end -= 1
+  return `${value.slice(0, end)}...`
+}
+
+/**
+ * Drop secret-shaped properties and bound every string.
+ *
+ * The record is built from paths, versions and error messages, none of which
+ * carry credentials; this guard keeps a later field addition from turning the
+ * file into a credential leak.
+ * @param value - candidate report value.
+ * @returns the same shape with secret-shaped keys removed and text bounded.
+ */
+export function sanitizeReportValue(value: unknown): unknown {
+  if (typeof value === 'string') return clamp(value)
+  if (typeof value === 'number' || typeof value === 'boolean' || value === null) return value
+  if (Array.isArray(value)) return value.map(entry => sanitizeReportValue(entry))
+  if (typeof value !== 'object') return undefined
+  const result: Record<string, unknown> = {}
+  for (const [key, entry] of Object.entries(value as Record<string, unknown>)) {
+    if (FORBIDDEN_KEY.test(key)) continue
+    const sanitized = sanitizeReportValue(entry)
+    if (sanitized !== undefined) result[key] = sanitized
+  }
+  return result
+}
+
+/** Build the record for one launch from the outcomes and the copies that were seen. */
+export function buildAlignmentReport(input: AlignmentReportInput): AlignmentReport {
+  const actions: AlignmentLogEvent[] = input.outcomes.map(outcome => ({
+    packageName: outcome.packageName,
+    action: alignmentLogAction(outcome),
+    previousVersion: outcome.previousVersion ?? null,
+    bundledVersion: outcome.bundledVersion ?? null,
+    ...(outcome.action === 'restored' && outcome.reason !== undefined ? { reason: clamp(outcome.reason) } : {}),
+    ...(outcome.warning === undefined ? {} : { warning: clamp(outcome.warning) }),
+    ...(outcome.backupPath === undefined ? {} : { backupPath: outcome.backupPath }),
+  }))
+  const observed = new Set(actions.map(entry => entry.action))
+  const action = ACTION_PRECEDENCE.find(candidate => observed.has(candidate)) ?? 'kept'
+  const primary = input.outcomes.find(outcome => outcome.resolvedVersion !== undefined)
+  return {
+    schemaVersion: 1,
+    timestamp: new Date(input.now?.() ?? Date.now()).toISOString(),
+    platform: input.platform ?? process.platform,
+    bundledPluginVersion: input.bundledVersion ?? primary?.bundledVersion ?? null,
+    loadedPluginVersion: input.loadedVersion ?? primary?.resolvedVersion ?? null,
+    action,
+    actions,
+    profileCopies: (input.copies ?? []).slice(0, 32).map(copy => ({
+      packageName: copy.packageName, path: copy.path, version: copy.version,
+    })),
+  }
+}
+
+/** Move the current record to `.1` and shift older rotations down one slot. */
+function rotateLog(path: string, retention: number): void {
+  for (let index = retention - 1; index >= 1; index -= 1) {
+    const from = `${path}.${String(index)}`
+    if (!existsSync(from)) continue
+    const to = `${path}.${String(index + 1)}`
+    rmSync(to, { force: true })
+    renameSync(from, to)
+  }
+  rmSync(`${path}.${String(retention)}`, { force: true })
+  if (existsSync(path)) renameSync(path, `${path}.1`)
+}
+
+/** Remove rotations a smaller retention no longer owns. */
+function pruneRotations(directory: string, name: string, retention: number): void {
+  let names: string[]
+  try {
+    names = readdirSync(directory)
+  } catch {
+    return
+  }
+  for (const entry of names) {
+    const match = /^(.*)\.(\d+)$/.exec(entry)
+    if (match === null || match[1] !== name) continue
+    if (Number.parseInt(match[2] ?? '0', 10) <= retention) continue
+    rmSync(join(directory, entry), { force: true })
+  }
+}
+
+/**
+ * Write one JSON record under a bounded retention.
+ *
+ * Every failure is swallowed: startup diagnostics must never become a startup
+ * failure, and a read-only data directory simply means no record this launch.
+ * @param directory - log directory, normally `<userData>/logs`.
+ * @param name - record file name inside the directory.
+ * @param value - report object; secret-shaped properties are removed first.
+ * @returns the written path, or undefined when nothing was written.
+ */
+export function writeDiagnosticRecord(directory: string, name: string, value: unknown): string | undefined {
+  try {
+    mkdirSync(directory, { recursive: true, mode: 0o700 })
+    const path = join(directory, name)
+    let body = `${JSON.stringify(sanitizeReportValue(value), undefined, 2)}\n`
+    if (Buffer.byteLength(body) > LOG_MAX_BYTES) {
+      const bounded = { ...(value as Record<string, unknown>), truncated: true }
+      body = `${JSON.stringify(sanitizeReportValue(bounded), undefined, 2)}\n`
+      if (Buffer.byteLength(body) > LOG_MAX_BYTES) body = `${body.slice(0, LOG_MAX_BYTES)}\n`
+    }
+    rotateLog(path, LOG_RETENTION)
+    pruneRotations(directory, name, LOG_RETENTION)
+    // Write through a sibling so an interrupted launch never leaves a partial record.
+    const temporary = `${path}.${String(process.pid)}.tmp`
+    writeFileSync(temporary, body, { mode: 0o600 })
+    renameSync(temporary, path)
+    return path
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * Write the startup alignment record.
+ * @param directory - log directory owned by the shell.
+ * @param input - outcomes plus the copies and versions that were observed.
+ * @returns the written path, or undefined when the directory is unusable.
+ */
+export function writeAlignmentReport(directory: string, input: AlignmentReportInput): string | undefined {
+  return writeDiagnosticRecord(directory, ALIGNMENT_LOG_FILE, buildAlignmentReport(input))
+}
