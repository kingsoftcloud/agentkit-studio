+++ b/apps/desktop/tests/window-diagnostic.spec.ts
@@ -0,0 +1,128 @@
+import { chmodSync, mkdirSync, mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+  WINDOW_SAMPLE_SCRIPT, diagnosticUrl, installWindowDiagnostic, windowDiagnosticPath,
+  type DiagnosticContents,
+} from '../src/window-diagnostic.ts'
+import { WINDOW_DIAGNOSTIC_FILE } from '../src/plugin-alignment-log.ts'
+
+const roots: string[] = []
+
+function temporaryRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-window-diagnostic-'))
+  roots.push(root)
+  return root
+}
+
+interface Fake extends DiagnosticContents {
+  /** Trigger the captured `did-finish-load` listener. */
+  load(): void
+  readonly calls: string[]
+}
+
+function fakeContents(options: {
+  url?: string
+  answer?: unknown
+  failure?: Error
+  destroyed?: boolean
+} = {}): Fake {
+  const calls: string[] = []
+  let listener: (() => void) | undefined
+  return {
+    calls,
+    load: () => { listener?.() },
+    getURL: () => options.url ?? 'http://127.0.0.1:49152/?nonce=do-not-store',
+    isDestroyed: () => options.destroyed === true,
+    executeJavaScript: (code: string) => {
+      calls.push(code)
+      return options.failure === undefined ? Promise.resolve(options.answer) : Promise.reject(options.failure)
+    },
+    on: (_event, handler) => { listener = handler },
+  }
+}
+
+/** Give the delayed sample a chance to run. */
+function settle(): Promise<void> {
+  return new Promise(resolve => { setTimeout(resolve, 25) })
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+describe('window diagnostic', () => {
+  it('records the resolved caption state after the load event', async () => {
+    const directory = join(temporaryRoot(), 'logs')
+    const contents = fakeContents({
+      answer: {
+        url: 'http://127.0.0.1:49152/?nonce=do-not-store',
+        html: { computedAppRegion: 'no-drag', inlineAppRegion: 'no-drag', windowsTitlebar: true },
+        body: { computedAppRegion: 'no-drag' },
+        dragStrip: true,
+        legacyDragMarkers: 2,
+      },
+    })
+    installWindowDiagnostic(contents, { directory, platform: 'win32', settleMs: 0, now: () => 1_700_000_000_000 })
+    expect(contents.calls).toHaveLength(0)
+    contents.load()
+    await settle()
+
+    const record = JSON.parse(readFileSync(windowDiagnosticPath(directory), 'utf8')) as Record<string, unknown>
+    expect(record).toMatchObject({
+      schemaVersion: 1,
+      platform: 'win32',
+      // The query string can carry a one-time Host token and is never recorded.
+      url: 'http://127.0.0.1:49152/',
+      rendererUrl: 'http://127.0.0.1:49152/',
+      html: { computedAppRegion: 'no-drag', inlineAppRegion: 'no-drag', windowsTitlebar: true },
+      body: { computedAppRegion: 'no-drag' },
+      dragStrip: true,
+      legacyDragMarkers: 2,
+      timestamp: '2023-11-14T22:13:20.000Z',
+    })
+    expect(readFileSync(windowDiagnosticPath(directory), 'utf8')).not.toContain('do-not-store')
+    expect(contents.calls[0]).toBe(WINDOW_SAMPLE_SCRIPT)
+    expect(windowDiagnosticPath(directory)).toBe(join(directory, WINDOW_DIAGNOSTIC_FILE))
+  })
+
+  it('records an error sample when the renderer cannot answer', async () => {
+    const directory = join(temporaryRoot(), 'logs')
+    const contents = fakeContents({ failure: new Error('frame detached') })
+    installWindowDiagnostic(contents, { directory, settleMs: 0 })
+    contents.load()
+    await settle()
+
+    const record = JSON.parse(readFileSync(windowDiagnosticPath(directory), 'utf8')) as Record<string, unknown>
+    expect(record.error).toContain('frame detached')
+    expect(record.url).toBe('http://127.0.0.1:49152/')
+  })
+
+  it('skips a destroyed window and survives an unusable log directory', async () => {
+    const directory = join(temporaryRoot(), 'logs')
+    const destroyed = fakeContents({ destroyed: true })
+    installWindowDiagnostic(destroyed, { directory, settleMs: 0 })
+    destroyed.load()
+    await settle()
+    expect(destroyed.calls).toHaveLength(0)
+
+    const blocked = join(temporaryRoot(), 'logs')
+    mkdirSync(blocked, { recursive: true })
+    chmodSync(blocked, 0o500)
+    try {
+      const contents = fakeContents({ answer: { html: {}, body: {}, dragStrip: false, legacyDragMarkers: 0 } })
+      installWindowDiagnostic(contents, { directory: blocked, settleMs: 0 })
+      contents.load()
+      await settle()
+      expect(contents.calls).toHaveLength(1)
+    } finally {
+      chmodSync(blocked, 0o700)
+    }
+  })
+
+  it('keeps only the document identity of a page URL', () => {
+    expect(diagnosticUrl('http://127.0.0.1:49152/chat/1?token=abc#frag')).toBe('http://127.0.0.1:49152/chat/1')
+    expect(diagnosticUrl('not a url?token=abc')).toBe('not a url')
+  })
+})
