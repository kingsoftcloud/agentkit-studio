+  const root = temporaryRoot()
+  const home = join(root, '.dsh')
+  const dsh = join(root, 'resources', 'dsh')
+  writePackage(dsh, '@deepseek-ai/dsh-desktop-runtime', '0.2.1-rc.2', {
+    dsh: { profile: { bundles: [DSH_BASE, '@deepseek-ai/dsh-web-app', PRODUCT] } },
+  })
+  writePackage(join(dsh, 'node_modules', '@deepseek-ai', 'dsh-web-app'), '@deepseek-ai/dsh-web-app', '0.2.1-rc.2')
+  if (options.keepDshBase !== false) writePackage(join(dsh, 'node_modules', '@deepseek-ai', 'dsh-base'), DSH_BASE, '0.2.1-rc.2')
+  writePackage(join(dsh, 'node_modules', PRODUCT), PRODUCT, options.bundledVersion ?? '0.0.10', {
+    dependencies: options.bundledDependencies ?? { [DSH_BASE]: '0.2.1-rc.2' },
+  })
+  const profile = join(home, 'profiles', 'desktop-agentkit-studio')
+  writePackage(profile, 'dsh-profile-desktop-agentkit-studio', '0.0.0', {
+    private: true,
+    dependencies: { [PRODUCT]: options.profileVersion ?? '0.0.7' },
+    dsh: { profile: { bundles: [DSH_BASE, '@deepseek-ai/dsh-web-app', PRODUCT] } },
+  })
+  writePackage(join(profile, 'node_modules', PRODUCT), PRODUCT, options.profileVersion ?? '0.0.7')
+  return { root, home, dsh, profile }
+}
+
+function outcomes(input: Fixture) {
+  return alignBundledProductPlugins({ profile: input.profile, runtimeDsh: input.dsh, home: input.home })
+}
+
+function profileDependency(profile: string): string | undefined {
+  return (JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+    dependencies?: Record<string, string>
+  }).dependencies?.[PRODUCT]
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+describe('bundled product plugin alignment', () => {
+  it('retires the older profile copy so the sealed runtime supplies the bundle', () => {
+    const input = fixture()
+    expect(verifyBundledCopy(input.dsh, join(input.dsh, 'node_modules', PRODUCT))).toBeUndefined()
+
+    const result = outcomes(input)
+
+    expect(result).toHaveLength(1)
+    expect(result[0]).toMatchObject({ packageName: PRODUCT, action: 'retired', previousVersion: '0.0.7', bundledVersion: '0.0.10', installationBacked: true })
+    expect(profileDependency(input.profile)).toBeUndefined()
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT))).toBe(false)
+    expect(existsSync(result[0]!.backupPath!)).toBe(true)
+    expect(JSON.parse(readFileSync(join(result[0]!.backupPath!, 'package.json'), 'utf8')).version).toBe('0.0.7')
+    // The installation anchor still resolves the bundled copy the Host loads next.
+    expect(existsSync(join(input.dsh, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+    // Nothing left to do on the next launch.
+    expect(outcomes(input)).toEqual([])
+  })
+
+  it('never throws and keeps the old copy when the bundled copy cannot resolve an in-box package', () => {
+    const input = fixture({ keepDshBase: false })
+    expect(verifyBundledCopy(input.dsh, join(input.dsh, 'node_modules', PRODUCT))).toContain(DSH_BASE)
+
+    const first = outcomes(input)
+    expect(first[0]).toMatchObject({ action: 'restored', installationBacked: false })
+    expect(first[0]?.reason).toContain(DSH_BASE)
+    expect(profileDependency(input.profile)).toBe('0.0.7')
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+    const marker = JSON.parse(readFileSync(join(input.profile, `.alignment-attempt-${'0.0.10'}`), 'utf8'))
+    expect(marker.failures).toBe(1)
+
+    expect(outcomes(input)[0]).toMatchObject({ action: 'restored' })
+    expect(JSON.parse(readFileSync(join(input.profile, '.alignment-attempt-0.0.10'), 'utf8')).failures).toBe(ALIGNMENT_ATTEMPT_LIMIT)
+
+    // The same version stops retrying and still starts on the profile copy.
+    expect(outcomes(input)[0]).toMatchObject({ action: 'skipped-attempt-budget', installationBacked: false })
+    expect(profileDependency(input.profile)).toBe('0.0.7')
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+  })
+
+  it('restores the profile when the manifest rewrite fails after moving the copy', () => {
+    const input = fixture()
+    const manifestPath = join(input.profile, 'package.json')
+    const original = readFileSync(manifestPath, 'utf8')
+    chmodSync(manifestPath, 0o400)
+    try {
+      const result = outcomes(input)
+      expect(result[0]).toMatchObject({ action: 'restored', installationBacked: false })
+      expect(readFileSync(manifestPath, 'utf8')).toBe(original)
+      expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+    } finally {
+      chmodSync(manifestPath, 0o600)
+    }
+  })
+
+  it('keeps a profile copy that is newer than the bundled runtime', () => {
+    const input = fixture({ bundledVersion: '0.0.10', profileVersion: '0.0.12' })
+    expect(outcomes(input)[0]).toMatchObject({ action: 'kept-newer', previousVersion: '0.0.12', installationBacked: false })
+    expect(profileDependency(input.profile)).toBe('0.0.12')
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+  })
+
+  it('cleans up the mirror dependency an earlier .6 launch rewrote into the profile', () => {
+    const input = fixture({ bundledVersion: '0.0.10', profileVersion: '0.0.10' })
+    const manifestPath = join(input.profile, 'package.json')
+    const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as { dependencies: Record<string, string> }
+    manifest.dependencies[PRODUCT] = 'file:../../bundled-plugins/agentkit-studio-0.0.10'
+    writeFileSync(manifestPath, JSON.stringify(manifest, undefined, 2))
+    const result = outcomes(input)
+    expect(result[0]).toMatchObject({ action: 'retired', previousVersion: '0.0.10', bundledVersion: '0.0.10' })
+    expect(profileDependency(input.profile)).toBeUndefined()
+  })
+
+  it('leaves installation-owned bundles and absent product copies untouched', () => {
+    const input = fixture()
+    // A profile dependency on an in-box bundle is never a product-plugin candidate.
+    const manifestPath = join(input.profile, 'package.json')
+    const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as { dependencies: Record<string, string> }
+    manifest.dependencies['@deepseek-ai/dsh-web-app'] = '0.2.1-rc.2'
+    writeFileSync(manifestPath, JSON.stringify(manifest, undefined, 2))
+    writePackage(join(input.profile, 'node_modules', '@deepseek-ai', 'dsh-web-app'), '@deepseek-ai/dsh-web-app', '0.2.1-rc.2')
+
+    const result = outcomes(input)
+    expect(result.map(outcome => outcome.action)).toEqual(['retired'])
+    expect(existsSync(join(input.profile, 'node_modules', '@deepseek-ai', 'dsh-web-app', 'package.json'))).toBe(true)
+    expect(existsSync(join(input.dsh, 'node_modules', '@deepseek-ai', 'dsh-web-app', 'package.json'))).toBe(true)
+
+    rmSync(join(input.profile, 'node_modules', PRODUCT), { recursive: true, force: true })
+    manifest.dependencies[PRODUCT] = '0.0.10'
+    writeFileSync(manifestPath, JSON.stringify(manifest, undefined, 2))
+    expect(outcomes(input)[0]).toMatchObject({ action: 'skipped-absent', installationBacked: true })
+  })
+
+  it('reports a missing runtime copy without touching the profile', () => {
+    const input = fixture()
+    rmSync(join(input.dsh, 'node_modules', PRODUCT), { recursive: true, force: true })
+    expect(outcomes(input)[0]).toMatchObject({ action: 'missing-runtime-copy', installationBacked: false })
+    expect(profileDependency(input.profile)).toBe('0.0.7')
+  })
+})
