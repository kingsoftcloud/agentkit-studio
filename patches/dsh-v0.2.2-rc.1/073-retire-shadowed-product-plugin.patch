+/** Write a minimal package with an explicit version and optional manifest fields. */
+function writePackage(directory: string, name: string, version: string, extra: Record<string, unknown> = {}): string {
+  mkdirSync(directory, { recursive: true })
+  writeFileSync(join(directory, 'package.json'), JSON.stringify({ name, version, type: 'module', ...extra }, undefined, 2))
+  writeFileSync(join(directory, 'index.js'), 'export const identity = 1\n')
+  return directory
+}
