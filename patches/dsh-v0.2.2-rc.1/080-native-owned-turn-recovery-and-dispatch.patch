@@ -0,0 +1,507 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId, SessionSeq, interruptedTurnClosers, parseExternalTurnOwnership } from '@deepseek-ai/dsh-session'
+import type { ExternalTurnOwnership, SessionEvent } from '@deepseek-ai/dsh-session'
+import type { Agent, TurnInput } from '@deepseek-ai/dsh-agent'
+import { createAssistantMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = [], directories: string[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+  for (const directory of directories.splice(0)) await rm(directory, { recursive: true, force: true })
+})
+
+const ownership = (turn: number): ExternalTurnOwnership => ({
+  contract: 'dsh.external-turn/v1', turn, engine: 'fixture-engine/v1', binding: '{"admission":"idle-start"}',
+})
+const send = (agent: Agent, text: string) => {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+}
+
+async function harness(root?: string) {
+  const ctx = new Context(); contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  if (root) await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const adapter = new MockAdapter([textResponse('default turn')])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  ctx.logger.error = vi.fn()
+  return { ctx, adapter }
+}
+
+async function restored(events: SessionEvent[]) {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-idle-start-')); directories.push(root)
+  const first = await harness(root), id = SessionId('idle-start-recovery')
+  const detached = first.ctx.sessions.prepare(id)
+  const writer = await first.ctx.sessionPersistence.create(detached.header)
+  await writer.append(events); await writer.close(); await first.ctx.fiber.dispose()
+  const second = await harness(root)
+  const handle = await second.ctx.agents.resume({ resumeSessionId: id, agentOptions: { provider: 'mock', model: 'mock' } })
+  return { ...second, agent: handle.agent, handle }
+}
+
+/** A trusted-Host prepare that returns the fixture ownership for the given turn. */
+const prepare = (expectedTurn: number) => async ({ turn, signal }: { turn: number; signal: AbortSignal }) => {
+  expect(turn).toBe(expectedTurn)
+  signal.throwIfAborted()
+  return ownership(turn)
+}
+
+/** Build an execute that admits one user message and one structured assistant message with pinned usage. */
+function runExecute(agent: Agent, text = 'idle engine completed') {
+  return async (payload: {
+    ownership: ExternalTurnOwnership
+    turn: number
+    signal: AbortSignal
+    prepareInput: (step: number) => Promise<TurnInput>
+  }) => {
+    payload.signal.throwIfAborted()
+    agent.session.append('step/start', { turn: payload.turn, step: 1 })
+    agent.session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: payload.ownership.binding }],
+      source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    agent.session.append('assistant/message', {
+      turn: payload.turn, step: 1, stream: [], message: createAssistantMessage({
+        content: [{ type: 'text', text }],
+        source: { provider: 'external-fixture', model: 'fixture/v1' },
+      }),
+      usage: { inputTokens: 3, outputTokens: 4 },
+    }, { surfaceOp: 'append' })
+    agent.session.append('step/end', { turn: payload.turn, step: 1 })
+    return { reason: { kind: 'completed' as const } }
+  }
+}
+
+it('advertises the idle admission contract and start method on the public host', async () => {
+  const { ctx } = await harness()
+  const { agent } = await ctx.agents.create({ sessionId: SessionId('idle-contract'), agentOptions: { provider: 'mock', model: 'mock' } })
+  expect(agent.externalTurns!.idleAdmissionContract).toBe('dsh.external-turn-start/v1')
+  expect(typeof agent.externalTurns!.start).toBe('function')
+})
+
+it('starts one whole turn from idle with no default request and a single durable boundary', async () => {
+  const { ctx } = await harness()
+  const { agent } = await ctx.agents.create({ sessionId: SessionId('idle-happy'), agentOptions: { provider: 'mock', model: 'mock' } })
+  const requests = vi.fn(); ctx.on('agent/request', async (_p, next) => { requests(); return next() })
+  const ending = await agent.externalTurns!.start!(prepare(1), runExecute(agent))
+  await agent.whenIdle()
+  expect(ending.reason).toEqual({ kind: 'completed' })
+  expect(requests).not.toHaveBeenCalled()
+  const events = agent.session.snapshotEvents()
+  expect(events.filter(e => e.type === 'turn/start')).toHaveLength(1)
+  expect(events.filter(e => e.type === 'turn/end')).toHaveLength(1)
+  expect(events.filter(e => e.type === 'step/start')).toHaveLength(1)
+  expect(events.filter(e => e.type === 'step/end')).toHaveLength(1)
+  expect(events.filter(e => e.type === 'user/message')).toHaveLength(1)
+  expect(events.filter(e => e.type === 'assistant/message')).toHaveLength(1)
+  expect(agent.externalTurns!.pending()).toBeNull()
+  expect(agent.status).toBe('idle')
+})
+
+it('refuses to start when an owner is already recorded and leaves the log unchanged', async () => {
+  // Seed a cold owned turn; the restored agent must refuse idle-start and keep
+  // the log and the pending owner unchanged.
+  const owned = await restored([
+    { type: 'turn/start', seq: SessionSeq(0), time: 1, data: { turn: 1 } },
+    { type: 'turn/owner', seq: SessionSeq(1), time: 2, data: ownership(1) },
+  ])
+  const before = owned.agent.session.snapshotEvents()
+  await expect(owned.agent.externalTurns!.start!(prepare(1), runExecute(owned.agent)))
+    .rejects.toMatchObject({ code: 'agent_busy' })
+  expect(owned.agent.session.snapshotEvents()).toEqual(before)
+  expect(owned.agent.externalTurns!.pending()).toEqual(ownership(1))
+})
+
+it('refuses to start when a turn is already open without an owner', async () => {
+  const ctx = new Context(); contexts.push(ctx)
