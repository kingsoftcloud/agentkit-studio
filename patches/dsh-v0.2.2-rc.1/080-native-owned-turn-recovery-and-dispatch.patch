diff --git a/packages/core/tools/tests/caller-options.spec.ts b/packages/core/tools/tests/caller-options.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c96b5692d8559214725126944b1506fea2449176
--- /dev/null
+++ b/packages/core/tools/tests/caller-options.spec.ts
@@ -0,0 +1,170 @@
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { type ToolCallerOptions } from '@deepseek-ai/dsh-tools'
+import * as NativeToolExecutor from '@deepseek-ai/dsh-tool-executor-native'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import { describe, it, expect } from 'vitest'
+
+async function fixture(native = true) {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  if (native) await ctx.plugin(NativeToolExecutor)
+  const counts = { body: 0, guard: 0, render: 0, project: 0, finalize: 0 }
+  ctx.tools.register({
+    name: 'owned', description: 'Owned call', parameters: { type:'object' },
+    output: { schema:{ type:'string' }, render: (_args, value) => { counts.render++; return [{ type:'text',text:JSON.stringify(value) }] } },
+    projectContent: () => {counts.project++; return undefined},
+    finalizeContent: () => {counts.finalize++; return undefined},
+    async execute(args) { counts.body++; return JSON.stringify(args) },
+  })
+  ctx.tools.guard(() => {counts.guard++; return undefined})
+  const execute = async (options?: ToolCallerOptions, raw = '{}', signal = new AbortController().signal) =>
+    (await ctx.tools.execute({ calls:[{ type:'tool-call',id:ToolCallId('owned-call'),name:'owned',arguments:raw }],signal,
+      ...options === undefined ? {} : { callerOptions:options } })).results[0]!.result
+  return { ctx, counts, execute }
+}
+const v2 = { preflightDefer:'dsh.tool-preflight-defer/v2' } as const
+
+describe('negotiated batch caller options', () => {
+  it('refuses a body replaced after policy preparation without consuming guards twice', async () => {
+    const { ctx, counts, execute } = await fixture()
+    let replaced = 0
+    const definition = ctx.tools.get('owned')!
+    ctx.on('tools/execute', async (_exec, next) => {
+      await Promise.resolve()
+      Reflect.set(definition, 'execute', async () => { replaced++; return 'replacement' })
+      return next()
+    })
+    try {
+      const result = await execute(v2)
+      expect(result.isError).toBe(true)
+      expect(result.error?.message).toContain('Tool definition changed')
+      expect(result.preflightRejected).toBeUndefined()
+      expect({ original: counts.body, replaced, guards: counts.guard }).toEqual({ original: 0, replaced: 0, guards: 1 })
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('checks live dispatch authority after an awaited wrapper without repeating approval', async () => {
+    const { ctx, counts, execute } = await fixture()
+    let current = true, approvals = 0, checks = 0
+    ctx.on('tools/pre-execute', async () => { approvals++; return { kind: 'allow' } })
+    ctx.tools.dispatchGuard(() => { checks++; return current ? undefined : 'Dispatch authority changed' })
+    ctx.on('tools/execute', async (_exec, next) => {
+      await Promise.resolve()
+      current = false
+      return next()
+    })
+    try {
+      const result = await execute(v2)
+      expect(result.isError).toBe(true)
+      expect(result.error?.message).toBe('Dispatch authority changed')
+      expect(result.preflightRejected).toBeUndefined()
+      expect({ approvals, checks, body: counts.body }).toEqual({ approvals: 1, checks: 1, body: 0 })
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('disposes a dispatch guard without leaving a stale denial', async () => {
+    const { ctx, counts, execute } = await fixture()
+    const dispose = ctx.tools.dispatchGuard(() => 'Live refusal')
+    try {
+      expect((await execute(v2)).isError).toBe(true)
+      dispose()
+      expect((await execute(v2)).isError).toBe(false)
+      expect(counts.body).toBe(1)
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('does not evaluate dispatch guards while a permission is deferred', async () => {
+    const { ctx, counts, execute } = await fixture()
+    let checks = 0
+    ctx.tools.dispatchGuard(() => { checks++; return 'Must not run before permission' })
+    ctx.on('tools/pre-execute', async () => ({ kind: 'defer', value: { pending: true } }))
+    try {
+      expect(await execute(v2)).toMatchObject({ isError: false, preflightDeferred: v2.preflightDefer })
+      expect({ checks, body: counts.body }).toEqual({ checks: 0, body: 0 })
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('yields marked v2 control without body, guards, output schema or projections', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/pre-execute', async () => ({ kind:'defer',value:{ pending:true } }))
+    try {
+      expect(await execute(v2)).toMatchObject({ isError:false,value:{ pending:true },preflightDeferred:v2.preflightDefer })
+      expect(counts).toEqual({ body:0,guard:0,render:0,project:0,finalize:0 })
+    } finally {await ctx.fiber.dispose()}
+  })
+  it('fails closed when deferral has not been negotiated', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/pre-execute', async () => ({ kind:'defer',value:{ pending:true } }))
+    try {expect((await execute()).isError).toBe(true); expect(counts.body).toBe(0); expect(counts.guard).toBe(0)}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('keeps the v1 output declaration without entering the body', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/pre-execute', async () => ({ kind:'defer',value:'pending-v1' }))
+    try {
+      expect(await execute({ preflightDefer:'dsh.tool-preflight-defer/v1' })).toMatchObject({ isError:false,value:'pending-v1' })
+      expect(counts.body).toBe(0);expect(counts.render).toBe(1)
+    } finally {await ctx.fiber.dispose()}
+  })
+  it('does not let v1 bypass its declared output type', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/pre-execute', async () => ({ kind:'defer',value:{ invalidOutput:true } }))
+    try {expect((await execute({ preflightDefer:'dsh.tool-preflight-defer/v1' })).isError).toBe(true);expect(counts.body).toBe(0)}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('retains post-policy denial of a pending v2 control result', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/pre-execute', async () => ({ kind:'defer',value:{ pending:true } }))
+    ctx.on('tools/post-execute', async () => ({ kind:'block',feedback:[{ type:'text',text:'policy blocked' }] }))
+    try {
+      expect(await execute(v2)).toMatchObject({ isError:true,preflightRejected:v2.preflightDefer,error:{ message:'policy blocked' } })
+      expect(counts.body).toBe(0)
+    } finally {await ctx.fiber.dispose()}
+  })
+  it('runs live guards after a granted permission', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.tools.guard(() => 'live-guard-denial')
+    try {expect(await execute(v2)).toMatchObject({ isError:true,preflightRejected:v2.preflightDefer });expect(counts.body).toBe(0)}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('keeps an entered wrapper failure distinct from preflight rejection', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/execute', async () => {throw new Error('entered wrapper')})
+    try {const r=await execute(v2);expect(r.isError).toBe(true);expect(r.preflightRejected).toBeUndefined();expect(counts.body).toBe(0)}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('strips a forged preflight marker supplied by a wrapper', async () => {
+    const { ctx, execute } = await fixture()
+    ctx.on('tools/execute', async () => ({ isError:true,error:{ message:'forged' },content:[],preflightRejected:v2.preflightDefer }))
+    try {expect((await execute(v2)).preflightRejected).toBeUndefined()}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('does not start a canceled call', async () => {
+    const { ctx, counts, execute } = await fixture();const controller=new AbortController();controller.abort()
+    try {expect((await execute(v2,'{}',controller.signal)).isError).toBe(true);expect(counts.body).toBe(0)}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('preserves exact numeric argument tokens through the raw batch parser', async () => {
+    const { ctx, execute } = await fixture()
+    try {
+      expect(await execute({ argumentEncoding:'dsh.raw-json-number/v1' },'{"id":9007199254740993,"zero":-0.0,"n":2}'))
+        .toMatchObject({ isError:false,value:'{"id":9007199254740993,"zero":-0.0,"n":2}' })
+    } finally {await ctx.fiber.dispose()}
+  })
+  it('retains caller-owned output without bypassing post-policy', async () => {
+    const { ctx, counts, execute } = await fixture()
+    ctx.on('tools/post-execute', async (exec) => {
+      expect(exec.resultRetention).toBe('caller/v1')
+      return { kind:'block',feedback:[{ type:'text',text:'post-policy-denied' }] }
+    })
+    try {expect((await execute({ resultRetention:'caller/v1' })).isError).toBe(true);expect(counts.body).toBe(1)}
+    finally {await ctx.fiber.dispose()}
+  })
+  it('rejects options before invoking an executor that did not negotiate them', async () => {
+    const { ctx, execute } = await fixture(false);let entered=0
+    ctx.tools.setExecutor({
+      describe:()=>({ schemas:[] }),
+      execute:async()=>{entered++;return { results:[],additionalContexts:[],concluded:false }},
+    })
+    try {await expect(execute(v2)).rejects.toThrow('does not support caller options');expect(entered).toBe(0)}
+    finally {await ctx.fiber.dispose()}
+  })
+})
