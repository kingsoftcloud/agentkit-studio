index 0000000000000000000000000000000000000000..9d350539590d58bea34e38d20feb2fc522f14817
--- /dev/null
+++ b/packages/core/agent-loop/tests/execute-turn.spec.ts
@@ -0,0 +1,132 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { createAssistantMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { Agent, TurnInput } from '@deepseek-ai/dsh-agent'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = []
+afterEach(async () => { for (const ctx of contexts.splice(0)) await ctx.fiber.dispose() })
+async function harness() {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const adapter = new MockAdapter([textResponse('default engine')])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const handle = await ctx.agents.create({ sessionId: SessionId('external-turn'), agentOptions: { provider: 'mock', model: 'mock' } })
+  return { ctx, agent: handle.agent, adapter }
+}
+function send(agent: Agent, text: string) {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+}
+
+describe('whole-turn execution', () => {
+  it('delegates unchanged to the default request and tool loop', async () => {
+    const { ctx, agent } = await harness()
+    const request = vi.fn()
+    ctx.on('agent/request', async (_payload, next) => { request(); return next() })
+    ctx.on('agent/execute-turn', async ({ input }, next) => {
+      expect(input.messages[0]?.content).toEqual([{ type: 'text', text: 'hello' }])
+      return next()
+    })
+    send(agent, 'hello')
+    await agent.whenIdle()
+    expect(request).toHaveBeenCalledOnce()
+    expect(agent.session.snapshotEvents().filter(e => e.type === 'assistant/message')).toHaveLength(1)
+  })
+
+  it('a scoped engine owns all steps without entering default requests or stop hooks', async () => {
+    const { ctx, agent } = await harness()
+    const request = vi.fn(), stopping = vi.fn()
+    ctx.on('agent/request', async (_payload, next) => { request(); return next() })
+    ctx.on('agent/turn-stopping', () => { stopping() })
+    const engine = agent.ctx.on('agent/execute-turn', async ({ input, turn }) => {
+      agent.session.append('step/start', { turn, step: 1 })
+      for (const message of input.messages) agent.session.append('user/message', message, { surfaceOp: 'append' })
+      agent.session.append('assistant/message', {
+        turn, step: 1, stream: [], message: createAssistantMessage({
+          content: [{ type: 'text', text: 'external engine' }], source: { provider: 'external-fixture', model: 'fixture/v1' },
+        }),
+      }, { surfaceOp: 'append' })
+      agent.session.append('step/end', { turn, step: 1 })
+      return { reason: { kind: 'completed' } }
+    })
+    send(agent, 'hello')
+    await agent.whenIdle()
+    expect(request).not.toHaveBeenCalled()
+    expect(stopping).not.toHaveBeenCalled()
+    expect(agent.status).toBe('idle')
+    const events = agent.session.snapshotEvents()
+    expect(events.filter(e => e.type === 'turn/start')).toHaveLength(1)
+    expect(events.filter(e => e.type === 'turn/end').map(e => e.data)).toEqual([{ turn: 1, reason: { kind: 'completed' } }])
+    engine()
+    send(agent, 'fallback after disposal')
+    await agent.whenIdle()
+    expect(request).toHaveBeenCalledOnce()
+  })
+
+  it('admits steering through pre-step and rejects retained input capability after settlement', async () => {
+    const { ctx, agent } = await harness()
+    let retained: ((step: number) => Promise<TurnInput>) | undefined
+    const coordinates: number[] = []
+    ctx.on('agent/pre-step', async ({ step }, next) => { coordinates.push(step); return next() })
+    ctx.on('agent/execute-turn', async ({ prepareInput }) => {
+      retained = prepareInput
+      agent.steer(createUserMessage({ content: [{ type: 'text', text: 'steering' }], source: { kind: 'user' } }))
+      const input = await prepareInput(2)
+      expect(input.kind).toBe('enter')
+      if (input.kind === 'enter') expect(input.messages[0]?.content).toEqual([{ type: 'text', text: 'steering' }])
+      return { reason: { kind: 'completed' } }
+    })
+    send(agent, 'hello')
+    await agent.whenIdle()
+    expect(coordinates).toEqual([1, 2])
+    expect(agent.inbox.nextStep).toHaveLength(0)
+    await expect(retained!(3)).rejects.toThrow('already settled')
+  })
+
+  it('cancel quiesces the external engine before the queued follow-up starts', async () => {
+    const { ctx, agent } = await harness()
+    const entered = Promise.withResolvers<undefined>()
+    const order: string[] = []
+    ctx.on('agent/execute-turn', async ({ signal, turn }) => {
+      order.push(`start:${turn}`)
+      if (turn === 1) {
+        entered.resolve(undefined)
+        await new Promise<undefined>((resolve) => {
+          signal.addEventListener('abort', () => { resolve(undefined) }, { once: true })
+        })
+        await Promise.resolve()
+        order.push('quiesced')
+      }
+      return { reason: { kind: 'completed' } }
+    })
+    send(agent, 'first')
+    await entered.promise
+    agent.cancel({ kind: 'user' })
+    send(agent, 'second')
+    await agent.whenIdle()
+    expect(order).toEqual(['start:1', 'quiesced', 'start:2'])
+    expect(agent.session.snapshotEvents().filter(e => e.type === 'turn/end').map(e => e.data)).toEqual([
+      { turn: 1, reason: { kind: 'aborted', reason: { kind: 'user' } } },
+      { turn: 2, reason: { kind: 'completed' } },
+    ])
+  })
+
+  it('a failed engine closes the turn and never falls back to a second executor', async () => {
+    const { ctx, agent } = await harness()
+    const request = vi.fn()
+    ctx.logger.error = vi.fn()
+    ctx.on('agent/request', async (_payload, next) => { request(); return next() })
+    ctx.on('agent/execute-turn', async () => { throw new Error('external engine failed') })
+    send(agent, 'hello')
+    await agent.whenIdle()
+    expect(request).not.toHaveBeenCalled()
+    const ending = agent.session.snapshotEvents().find(e => e.type === 'turn/end')
+    expect(ending?.data).toMatchObject({ turn: 1, reason: { kind: 'error', error: { code: 'UNKNOWN' } } })
+    expect(agent.status).toBe('idle')
+  })
+})
