+/** Test-only external engine composed through the public turn event. */
+import type { Context } from '@deepseek-ai/cordis'
+import { createAssistantMessage } from '@deepseek-ai/dsh-llm'
+import { MockAdapter } from '../../mock-adapter.ts'
+
+export const name = 'external-turn-fixture'
+export const inject = ['agents', 'systemPrompt', 'llm']
+
+class ExternalFixtureAdapter extends MockAdapter {
+  override prepareCall(): never {
+    throw new Error('Default model preparation must not run')
+  }
+}
+
+/** Install a deterministic engine; any default request is a composition failure. */
+export function apply(ctx: Context): void {
+  ctx.llm.registerAdapter(['external-fixture'], new ExternalFixtureAdapter([]))
+  ctx.systemPrompt.section({ name: 'external-fixture', order: 0, text: 'External engine instruction.' })
+  ctx.on('agent/request', async () => { throw new Error('Default engine must not execute a handled turn') })
+  ctx.on('agent/execute-turn', async ({ agent, input, turn, signal }) => {
+    signal.throwIfAborted()
+    agent.session.append('step/start', { turn, step: 1 })
+    for (const message of input.messages) agent.session.append('user/message', message, { surfaceOp: 'append' })
+    agent.session.append('assistant/message', {
+      turn, step: 1, stream: [], message: createAssistantMessage({
+        content: [{ type: 'text', text: 'External engine completed.' }], source: { provider: 'external-fixture', model: 'fixture/v1' },
+      }),
+      usage: { inputTokens: 3, outputTokens: 4 },
+    }, { surfaceOp: 'append' })
+    agent.session.append('step/end', { turn, step: 1 })
+    return { reason: { kind: 'completed' } }
+  })
+}
