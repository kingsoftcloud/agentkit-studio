@@ -0,0 +1,102 @@
+import { spawn } from 'node:child_process'
+import { mkdtemp, readdir, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { createInterface } from 'node:readline'
+import { expect, it } from 'vitest'
+import { resolveExampleLaunch } from '@deepseek-ai/dsh-loader-smoke'
+
+type Report = { ready?: string
+  events?: { type: string
+    data: Record<string, unknown> }[]
+  before?: { type: string
+    data: Record<string, unknown> }[]
+  after?: { type: string
+    data: Record<string, unknown> }[]
+  pending?: unknown
+  remaining?: unknown }
+const driver = fileURLToPath(new URL('./fixtures/external-turn/idle-driver.ts', import.meta.url))
+const config = fileURLToPath(new URL('./fixtures/external-turn/cordis.yml', import.meta.url))
+
+async function persisted(directory: string): Promise<string> {
+  let text = ''
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    const path = join(directory, entry.name)
+    if (entry.isDirectory()) text += await persisted(path)
+    else if (entry.name.endsWith('.jsonl')) text += await readFile(path, 'utf8')
+  }
+  return text
+}
+
+for (const boundary of ['prepare', 'owner']) it(`built Loader survives actual SIGKILL at the ${boundary} idle-start boundary`, async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-idle-loader-'))
+  const children: ReturnType<typeof launch>[] = []
+  function launch(mode: string) {
+    const spec = resolveExampleLaunch({ srcBin: driver, libBin: driver, mode: 'lib',
+      configArgs: [config, mode, boundary], env: { DSH_HOME: join(root, '.dsh'), DSH_AGENTS_HOME: join(root, '.agents') } })
+    const child = spawn(spec.command, spec.args, { cwd: root, env: { ...process.env, ...spec.env }, stdio: ['ignore', 'pipe', 'pipe'] })
+    let stderr = ''
+    child.stderr.on('data', (chunk) => { stderr += String(chunk) })
+    const report = Promise.withResolvers<Report>()
+    let reported = false
+    const lines = createInterface({ input: child.stdout })
+    lines.on('line', (line) => {
+      if (!line.startsWith('{')) return
+      try { report.resolve(JSON.parse(line) as Report); reported = true } catch (error) { report.reject(error) }
+    })
+    const timeout = setTimeout(() => {
+      report.reject(new Error(`Fixture did not settle: ${stderr}`))
+      child.kill('SIGKILL')
+    }, 12000)
+    const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve, reject) => {
+      child.once('error', (error) => { report.reject(error); reject(error) })
+      child.once('close', (code, signal) => {
+        clearTimeout(timeout)
+        lines.close()
+        if (!reported) report.reject(new Error(`Fixture exited ${String(code ?? signal)} before reporting: ${stderr}`))
+        resolve({ code, signal })
+      })
+    })
+    return { child, report: report.promise, exited }
+  }
+  try {
+    const killed = launch('kill'); children.push(killed)
+    const ready = await killed.report
+    expect(ready.ready).toBe(boundary)
+    expect(ready.events?.filter(e => e.type === 'turn/start')).toHaveLength(1)
+    expect(ready.events?.filter(e => e.type === 'turn/owner')).toHaveLength(boundary === 'owner' ? 1 : 0)
+    expect(ready.events?.some(e => e.type === 'turn/end')).toBe(false)
+    expect(killed.child.kill('SIGKILL')).toBe(true)
+    expect(await killed.exited).toEqual({ code: null, signal: 'SIGKILL' })
+    const onDisk = await persisted(join(root, '.sessions'))
+    expect(onDisk).toContain('"type":"turn/start"')
+    expect(onDisk.includes('"type":"turn/owner"')).toBe(boundary === 'owner')
+    expect(onDisk).not.toContain('"type":"turn/end"')
+    const resumed = launch('recover'); children.push(resumed)
+    const report = await resumed.report
+    expect(await resumed.exited).toEqual({ code: 0, signal: null })
+    expect(report.remaining).toBeNull()
+    expect(report.after?.filter(e => e.type === 'user/message')).toHaveLength(0)
+    expect(report.after?.filter(e => e.type === 'assistant/message')).toHaveLength(1)
+    if (boundary === 'owner') {
+      expect(report.pending).toEqual({ contract: 'dsh.external-turn/v1', turn: 1,
+        engine: 'idle-process-fixture/v1', binding: '{"source":"original-admission"}' })
+      expect(report.before?.filter(e => e.type === 'turn/end')).toHaveLength(0)
+      expect(report.after?.filter(e => e.type === 'turn/start')).toHaveLength(1)
+      expect(report.after?.filter(e => e.type === 'turn/end').map(e => e.data)).toEqual([{ turn: 1, reason: { kind: 'completed' } }])
+    } else {
+      expect(report.pending).toBeNull()
+      expect(report.before?.filter(e => e.type === 'turn/end').map(e => e.data)).toEqual([{ turn: 1, reason: { kind: 'interrupted' } }])
+      expect(report.after?.filter(e => e.type === 'turn/start')).toHaveLength(2)
+      expect(report.after?.filter(e => e.type === 'turn/end').map(e => e.data.turn)).toEqual([1, 2])
+    }
+    expect(await persisted(join(root, '.sessions'))).toContain('Original admission recovered.')
+  } finally {
+    for (const { child, exited } of children) {
+      if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL')
+      await exited
+    }
+    await rm(root, { recursive: true, force: true })
+  }
+}, 30000)
