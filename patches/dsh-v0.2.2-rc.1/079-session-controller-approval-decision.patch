index 0000000000000000000000000000000000000000..1fb29a3c18bde8831573e9daa4040e1dda7f02c9
--- /dev/null
+++ b/packages/api/session-controller/tests/approval-decision.host.spec.ts
@@ -0,0 +1,72 @@
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { ApprovalOutcome, ApprovalRequest } from '@deepseek-ai/dsh-user-approval'
+import ApprovalService from '@deepseek-ai/dsh-user-approval'
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import SessionController from '../src/index.ts'
+import { createSessionTestController } from './test-remote.ts'
+
+const defaults = {
+  defaultModelSelection: () => ({ provider: 'fixture', model: 'fixture-model' }),
+  cwd: '/tmp',
+}
+
+async function fixture(withApproval = true): Promise<{
+  ctx: Context
+  controller: SessionController
+  agent: Agent
+  sessionId: SessionId
+}> {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await mountAgentLoopTestDependencies(ctx)
+  await mountAgentLoopTestHarness(ctx)
+  if (withApproval) await ctx.plugin(ApprovalService)
+  const sessionId = SessionId(`approval-rpc-${Math.random().toString(16).slice(2)}`)
+  const session = ctx.sessions.create(sessionId, { meta: { cwd: '/tmp' } })
+  session.append('turn/start', { turn: 1 })
+  const agent = { id: sessionId, session, status: 'running', ctx } as Agent
+  await ctx.agents.register(agent)
+  const controller = await createSessionTestController(ctx, defaults)
+  return { ctx, controller, agent, sessionId }
+}
+
+describe('SessionController.approvalDecision', () => {
+  it('routes the public Session RPC to the live approval service and completes the request', async () => {
+    const { ctx, controller, agent, sessionId } = await fixture()
+    let received: ApprovalRequest | undefined
+    let answer!: (outcome: ApprovalOutcome) => void
+    ctx.on('approval/request', (request) => {
+      received = request
+      return new Promise<ApprovalOutcome>((resolve) => { answer = resolve })
+    })
+
+    const waiting = ctx.approval.request({ agent, toolName: 'write_workspace_file' })
+    await vi.waitFor(() => expect(received?.requestId).toBeDefined())
+    const requestId = received?.requestId
+    expect(requestId).toBeDefined()
+    if (requestId === undefined) throw new Error('approval request id was not published')
+    const result = await controller.approvalDecision({
+      sessionId,
+      requestId,
+      decision: 'allowed-once',
+    })
+
+    expect(result).toEqual({ accepted: true, outcome: 'allowed-once' })
+    await expect(waiting).resolves.toBe('allowed-once')
+    answer('rejected')
+  })
+
+  it('returns a typed unavailable error when the Host does not compose approval', async () => {
+    const { controller, sessionId } = await fixture(false)
+    await expect(controller.approvalDecision({
+      sessionId,
+      requestId: 'missing' as never,
+      decision: 'rejected',
+    })).rejects.toMatchObject({
+      code: 'session/approval-unavailable',
+    })
+  })
+})
