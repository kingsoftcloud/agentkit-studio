index 0000000000000000000000000000000000000000..c9895f7e7b6544a1d0968f0e34c206ea9b5c8524
--- /dev/null
+++ b/packages/client/ui-sidebar-right/src/client/panel-surfaces.ts
@@ -0,0 +1,59 @@
+/** Ephemeral dock surfaces owned by global panels, outside all Sessions. */
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { DockController, type LayoutState, type TabId } from '@deepseek-ai/dsh-client-ui-dockkit'
+import type { MainPanelId } from '@deepseek-ai/dsh-client-ui-layout/client'
+import { pageAddress } from './contract/seed.ts'
+
+class PanelDock extends DockController {
+  override closeTab(tabId: TabId): void {
+    super.closeTab(tabId)
+    if (Object.keys(this.getSnapshot().state.tabs).length === 0) this.setExpanded(false)
+  }
+}
+
+export class SidebarRightPanelSurfaces {
+  private readonly docks = new Map<MainPanelId, { dock: PanelDock; release: () => void }>()
+  readonly source = createSnapshotStore<ReadonlyMap<MainPanelId, LayoutState>>(new Map())
+
+  /** @param panelId - global panel key. @returns unregisters its dock. */
+  register(panelId: MainPanelId): () => void {
+    if (this.docks.has(panelId)) throw new Error(`sidebarRight: panel ${panelId} is already registered`)
+    const dock = new PanelDock()
+    const entry = { dock, release: dock.subscribe(() => this.publish(panelId, dock.getSnapshot().state)) }
+    this.docks.set(panelId, entry)
+    this.publish(panelId, dock.getSnapshot().state)
+    return () => {
+      if (this.docks.get(panelId) !== entry) return
+      entry.release()
+      this.docks.delete(panelId)
+      this.publish(panelId)
+    }
+  }
+
+  dock(panelId: MainPanelId): PanelDock {
+    const entry = this.docks.get(panelId)
+    if (entry === undefined) throw new Error(`sidebarRight: no registered dock for panel ${panelId}`)
+    return entry.dock
+  }
+
+  /** @param panelId - global panel key. @param kind - registered body key. @param title - localized tab title. */
+  open(panelId: MainPanelId, kind: string, title: string): void {
+    const dock = this.dock(panelId)
+    dock.openContent({ kind, title, contentId: pageAddress(kind) })
+    if (!dock.getSnapshot().state.expanded) dock.setMode('push')
+    dock.setExpanded(true)
+  }
+
+  dispose(): void {
+    for (const entry of this.docks.values()) entry.release()
+    this.docks.clear()
+    this.source.set(new Map())
+  }
+
+  private publish(panelId: MainPanelId, state?: LayoutState): void {
+    const next = new Map(this.source.getSnapshot())
+    if (state === undefined) next.delete(panelId)
+    else next.set(panelId, state)
+    this.source.set(next)
+  }
+}
