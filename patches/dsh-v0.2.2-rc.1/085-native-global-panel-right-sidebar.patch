@@ -0,0 +1,67 @@
+import { useEffect, useLayoutEffect } from 'react'
+import type { CSSProperties } from 'react'
+import type { HostObservable, InjectFace, PropsLocale, PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { MainPanelId } from '@deepseek-ai/dsh-client-ui-layout/client'
+import { DockLayout, type DockIntents, type LayoutState } from '@deepseek-ai/dsh-client-ui-dockkit'
+import { dockLabels } from '../labels.ts'
+import { PanelChrome, type SidebarRightPresentation } from './SidebarRight.tsx'
+import type {} from '../contract/slots.ts'
+import css from './SidebarRight.module.css'
+
+export interface PanelSeatInjected {
+  readonly hooks: { panels: HostObservable<ReadonlyMap<MainPanelId, LayoutState>> }
+  readonly intentsFor: (panelId: MainPanelId) => DockIntents
+  readonly close: (panelId: MainPanelId) => void
+  readonly setFullscreen: (panelId: MainPanelId, fullscreen: boolean) => void
+  readonly syncPresentation: (presentation: SidebarRightPresentation) => void
+}
+
+type PanelSeatProps = PropsRuntime<'rightbar.panel'>
+  & PropsRenderSlots<'sidebar.right.panel.tab'>
+  & PropsLocale<'sidebarRight'>
+  & InjectFace<PanelSeatInjected>
+
+/** Render the selected panel's tabs; the frame owns the column and its divider. */
+export function PanelSeat({ panelId, width, viewportWidth, canShow, usePanels, renderSlot, t,
+  intentsFor, close, setFullscreen, syncPresentation }: PanelSeatProps) {
+  const layout = usePanels(panels => panels.get(panelId))
+  const shown = layout?.expanded === true
+  const compact = viewportWidth < 768 || !canShow
+  const fullscreen = compact || layout?.mode === 'fullscreen'
+  const exitFullscreen = (): void => { if (compact) close(panelId); else setFullscreen(panelId, false) }
+
+  useLayoutEffect(() => {
+    syncPresentation({ shown, track: shown && !compact, fullscreen: shown && fullscreen })
+  }, [panelId, shown, compact, fullscreen, syncPresentation])
+  useLayoutEffect(() => () => { syncPresentation({ shown: false, track: false, fullscreen: false }) }, [panelId, syncPresentation])
+  useEffect(() => {
+    if (!shown || !fullscreen) return
+    const escape = (event: KeyboardEvent): void => {
+      if (event.key !== 'Escape' || event.repeat) return
+      event.preventDefault()
+      event.stopImmediatePropagation()
+      if (compact) close(panelId); else setFullscreen(panelId, false)
+    }
+    document.addEventListener('keydown', escape, true)
+    return () => { document.removeEventListener('keydown', escape, true) }
+  }, [panelId, shown, fullscreen, compact, close, setFullscreen])
+  if (layout === undefined || (!shown && layout.floats.length === 0)) return null
+  return (
+    <div className={css.panel}
+      data-sidebar-right-panel-owner={panelId}
+      data-sidebar-right-panel={fullscreen ? 'fullscreen' : 'push'}
+      data-sidebar-right-open={shown || undefined}
+      style={{ width: fullscreen ? '100vw' : width, '--dsh-sidebar-width': fullscreen ? '100vw' : `${width}px` } as CSSProperties}
+    >
+      <div className={css.panelBody}>
+        <DockLayout state={layout} active canSplit={false} hideSplitWhenBlocked canAddTab={() => false}
+          labels={dockLabels(t)} intents={intentsFor(panelId)}
+          renderTab={tab => renderSlot('sidebar.right.panel.tab', { panelId, active: true, fullscreen }, { entryKey: tab.kind })}
+          chrome={<PanelChrome t={t} fullscreen={fullscreen} shortcuts={[]}
+            collapse={() => { close(panelId) }}
+            toggleFullscreen={() => { if (fullscreen) exitFullscreen(); else setFullscreen(panelId, true) }} />}
+        />
+      </div>
+    </div>
+  )
+}
