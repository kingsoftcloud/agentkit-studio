diff --git a/apps/desktop-host/src/package-manager.ts b/apps/desktop-host/src/package-manager.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67def814399a4c27571f4da9db7e6cc8953dd08a
--- /dev/null
+++ b/apps/desktop-host/src/package-manager.ts
@@ -0,0 +1,22 @@
+/** Select the Desktop installation's own pnpm for all plugin operations. */
+import { delimiter } from 'node:path'
+import type { ProfilePnpmInvocation } from '@deepseek-ai/dsh-app-boot'
+
+/** Construct the invocation shared by the Desktop Host and its installed CLI.
+ * @param pnpm Entry of the bundled pnpm distribution.
+ * @param nodeBin Directory of Desktop's private Node launchers.
+ * @returns An invocation that cannot delegate to a profile-pinned pnpm.
+ */
+export function desktopPackageManager(pnpm: string, nodeBin: string): ProfilePnpmInvocation {
+  return {
+    command: process.execPath,
+    args: ['--expose-internals', pnpm],
+    env: {
+      ELECTRON_RUN_AS_NODE: '1',
+      DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+      PATH: `${nodeBin}${delimiter}${process.env.PATH ?? ''}`,
+      pnpm_config_pm_on_fail: 'ignore',
+    },
+    repairProfile: true,
+  }
+}
diff --git a/apps/desktop-host/tests/package-manager.spec.ts b/apps/desktop-host/tests/package-manager.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3b472b4624c0c09640b94e79dabeac36a21dde15
--- /dev/null
+++ b/apps/desktop-host/tests/package-manager.spec.ts
@@ -0,0 +1,24 @@
+/** The Desktop's pnpm must not delegate to a manager pinned in a plugin profile. */
+import { execFile } from 'node:child_process'
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { promisify } from 'node:util'
+import { expect, it, onTestFinished } from 'vitest'
+import { desktopPackageManager } from '../src/package-manager.ts'
+
+it('runs the bundled pnpm even when the profile pins a different major', async () => {
+  const profile = mkdtempSync(join(tmpdir(), 'desktop-bundled-pnpm-'))
+  onTestFinished(() => { rmSync(profile, { recursive: true, force: true }) })
+  const bundled = fileURLToPath(new URL('../../desktop/node_modules/pnpm/', import.meta.url))
+  const { version } = JSON.parse(readFileSync(join(bundled, 'package.json'), 'utf8')) as { version: string }
+  const manifest = '{"name":"test-profile","private":true,"packageManager":"pnpm@10.33.2"}'
+  writeFileSync(join(profile, 'package.json'), manifest)
+  const invocation = desktopPackageManager(join(bundled, 'bin', 'pnpm.mjs'), bundled)
+  const { stdout } = await promisify(execFile)(invocation.command, [...invocation.args, '--version'], {
+    cwd: profile, env: { ...process.env, pnpm_config_offline: 'true', ...invocation.env }, timeout: 10_000,
+  })
+  expect(stdout.trim()).toBe(version)
+  expect(readFileSync(join(profile, 'package.json'), 'utf8')).toBe(manifest)
+})
