@@ -0,0 +1,187 @@
+/** Validate Desktop's local package tree and retain the previous tree during a locked rebuild. */
+import { randomUUID } from 'node:crypto'
+import { lstatSync, readFileSync, readdirSync, statSync } from 'node:fs'
+import { mkdir, mkdtemp, rename } from 'node:fs/promises'
+import { isAbsolute, join, relative, resolve, sep } from 'node:path'
+import { readProfileManifest, type ProfileManifest } from '@deepseek-ai/dsh-app-boot'
+import semver from 'semver'
+import { parse } from 'yaml'
+
+/** Version and configured store reported by the bundled pnpm in this profile. */
+export interface ProfilePnpmIdentity {
+  readonly version: string
+  readonly storeDir: string
+}
+
+const PACKAGE_NAME = /^(?:@[\da-z][\w.-]*\/)?[\da-z][\w.-]*$/i
+const CORE_NAME = /^(?:dsh-|cordis(?:-|$))/
+const recoveryRoot = (dir: string) => join(dir, '.plugin-manager')
+const pendingPath = (dir: string) => join(recoveryRoot(dir), 'pnpm-recovery-pending')
+
+function missing(error: unknown): boolean {
+  return (error as NodeJS.ErrnoException | null)?.code === 'ENOENT'
+}
+
+function localDirectory(path: string): boolean {
+  let stat
+  try { stat = lstatSync(path) } catch (error) { if (missing(error)) return false; throw error }
+  if (!stat.isDirectory()) throw new Error('profile package path is not an ordinary directory')
+  return true
+}
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : undefined
+}
+
+function readRecord(file: string, decode: (text: string) => unknown): Record<string, unknown> | undefined {
+  try { return record(decode(readFileSync(file, 'utf8'))) } catch (error) {
+    if (missing(error) || error instanceof SyntaxError || (error instanceof Error && error.name === 'YAMLParseError')) return undefined
+    throw error
+  }
+}
+
+function packageNames(dir: string, includeOptional = false): string[] {
+  const manifest: ProfileManifest & { devDependencies?: object; optionalDependencies?: object } = readProfileManifest('dsh', dir)
+  return Object.keys({ ...manifest.dependencies, ...manifest.devDependencies, ...includeOptional ? manifest.optionalDependencies : {} })
+    .filter(name => PACKAGE_NAME.test(name) && (includeOptional || !Object.hasOwn(manifest.optionalDependencies ?? {}, name)))
+}
+
+function localCoreNames(scope: string): string[] {
+  try { return readdirSync(scope).filter(name => CORE_NAME.test(name) && PACKAGE_NAME.test(name)) }
+  catch (error) { if (missing(error)) return []; throw error }
+}
+
+/** Whether a repair still owns the live package directory.
+ * @param dir Initialized Desktop profile directory.
+ * @returns True until the old or new tree has been selected.
+ */
+export function profilePackageRepairPending(dir: string): boolean {
+  return localDirectory(pendingPath(dir))
+}
+
+/** Whether startup must inspect the package project. A fresh empty profile needs no pnpm process.
+ * @param dir Initialized Desktop profile directory.
+ * @returns True for an installed, declared, or interrupted package tree.
+ */
+export function hasProfilePackages(dir: string): boolean {
+  return profilePackageRepairPending(dir) || localDirectory(join(dir, 'node_modules')) || packageNames(dir).length > 0
+}
+
+/** Check the pnpm layout and the packages whose absence can break boot.
+ * @param dir Initialized Desktop profile directory.
+ * @param expected Identity of its bundled pnpm.
+ * @returns A safe diagnostic for a broken tree, or undefined when usable.
+ */
+export function profilePackageIssue(dir: string, expected: ProfilePnpmIdentity): string | undefined {
+  const modules = join(dir, 'node_modules')
+  const required = packageNames(dir)
+  if (!localDirectory(modules)) return required.length === 0 ? undefined : 'node_modules is missing'
+  const metadata = readRecord(join(modules, '.modules.yaml'), parse)
+  if (metadata === undefined && required.length === 0 && readdirSync(modules).length === 0) return undefined
+  const installed = typeof metadata?.packageManager === 'string' && metadata.packageManager.startsWith('pnpm@')
+    ? semver.valid(metadata.packageManager.slice('pnpm@'.length)) : null
+  if (installed === null) return 'the installed pnpm version is missing or invalid'
+  if (semver.major(installed) !== semver.major(expected.version)) return `pnpm ${installed} → ${expected.version}`
+  if (typeof metadata?.storeDir !== 'string' || !isAbsolute(metadata.storeDir)
+    || relative(expected.storeDir, metadata.storeDir) !== '') return 'the installed pnpm store differs from the configured store'
+
+  const scope = join(modules, '@deepseek-ai')
+  const coreNames = new Set(localCoreNames(scope).map(name => `@deepseek-ai/${name}`))
+  for (const name of new Set([...required, ...coreNames])) {
+    const packageDir = join(modules, name)
+    const manifest = readRecord(join(packageDir, 'package.json'), JSON.parse)
+    if (typeof manifest?.name !== 'string') return `${name} is missing its package manifest`
+    // Check existing core shadows as well as declared packages: Node can resolve an
+    // empty local core directory before the signed runtime copy.
+    if (coreNames.has(name) && typeof manifest.main === 'string' && /\.[cm]?js$/.test(manifest.main)) {
+      const entry = resolve(packageDir, manifest.main)
+      const withinPackage = relative(packageDir, entry)
+      if (isAbsolute(withinPackage) || withinPackage === '..' || withinPackage.startsWith(`..${sep}`)
+        || !statSync(entry, { throwIfNoEntry: false })?.isFile()) return `${name} is missing its runtime entry`
+    }
+  }
+  return undefined
+}
+
+/** Unblock resolution when a frozen reinstall is unavailable. Only empty directories without a
+ * declared dependency and with an installation-owned replacement are eligible.
+ * @param dir Initialized Desktop profile directory, held under its package writer lock.
+ * @param runtimeModules The installation's own node_modules directory.
+ * @returns The names moved out of Node's lookup path.
+ */
+export async function quarantineEmptyCoreShadows(dir: string, runtimeModules: string): Promise<string[]> {
+  const modules = join(dir, 'node_modules')
+  const scope = join(modules, '@deepseek-ai')
+  if (!lstatSync(modules, { throwIfNoEntry: false })?.isDirectory()
+    || !lstatSync(scope, { throwIfNoEntry: false })?.isDirectory()) return []
+  const declared = new Set(packageNames(dir, true))
+  const shadows = localCoreNames(scope).filter((name) => {
+    const fullName = `@deepseek-ai/${name}`
+    const local = join(scope, name)
+    if (declared.has(fullName) || !lstatSync(local, { throwIfNoEntry: false })?.isDirectory()
+      || readdirSync(local).length !== 0) return false
+    const manifest = readRecord(join(runtimeModules, fullName, 'package.json'), JSON.parse)
+    return manifest?.name === fullName
+  })
+  if (shadows.length === 0) return []
+  await mkdir(recoveryRoot(dir), { recursive: true, mode: 0o700 })
+  const backup = await mkdtemp(join(recoveryRoot(dir), 'pnpm-empty-shadows-'))
+  for (const name of shadows) await rename(join(scope, name), join(backup, name))
+  return shadows.map(name => `@deepseek-ai/${name}`)
+}
+
+async function archiveRepair(dir: string): Promise<void> {
+  await rename(pendingPath(dir), join(recoveryRoot(dir), `pnpm-recovery-${randomUUID()}`))
+}
+
+async function restoreTree(dir: string, hadModules: boolean): Promise<void> {
+  const pending = pendingPath(dir)
+  const original = join(pending, 'node_modules')
+  const live = join(dir, 'node_modules')
+  const backedUp = localDirectory(original)
+  if (backedUp || !hadModules) {
+    if (localDirectory(live)) await rename(live, join(pending, `rejected-${randomUUID()}`))
+    if (backedUp) await rename(original, live)
+  }
+  await archiveRepair(dir)
+}
+
+/** Recover a stopped repair before reading its live tree. The caller holds the profile lock
+ * and has checked that the previous package process is no longer writing.
+ * @param dir Initialized Desktop profile directory.
+ * @returns True if an interrupted repair was found.
+ */
+export async function restoreInterruptedProfileRepair(dir: string): Promise<boolean> {
+  if (!profilePackageRepairPending(dir)) return false
+  await restoreTree(dir, true)
+  return true
+}
+
+/** Rebuild at pnpm's canonical install path, since hoisted metadata embeds it.
+ * The caller holds the profile lock and guarantees the lockfile is used without changes.
+ * @param dir Initialized Desktop profile directory.
+ * @param install Executes and validates the locked reinstall.
+ * @param quiescent Whether it is safe to move files after failure.
+ * @returns Once the replacement is verified and the old tree has been archived.
+ */
+export async function replaceProfilePackages(
+  dir: string, install: () => Promise<void>, quiescent: () => Promise<boolean>,
+): Promise<void> {
+  const live = join(dir, 'node_modules')
+  const hadModules = localDirectory(live)
+  await mkdir(recoveryRoot(dir), { recursive: true, mode: 0o700 })
+  const pending = pendingPath(dir)
+  await mkdir(pending, { mode: 0o700 })
+  try {
+    if (hadModules) await rename(live, join(pending, 'node_modules'))
+    await install()
+    await archiveRepair(dir)
+  } catch (error) {
+    if (await quiescent()) {
+      try { await restoreTree(dir, hadModules) } catch (rollback) {
+        throw new AggregateError([error, rollback], 'profile dependency repair could not restore the previous tree; the backup is retained')
+      }
+    }
+    throw error
+  }
+}
