+it('rejects an install that exits zero after breaking a core package and restores the prior dependencies', async () => {
+  const p = await profile()
+  const manifest = readFileSync(p.manifestPath)
+  const lockPath = join(p.dir, 'pnpm-lock.yaml')
+  const lock = readFileSync(lockPath)
+  const runner = join(p.dir, 'pnpm-with-damage.mjs')
+  writeFileSync(runner, `
+    import { spawnSync } from 'node:child_process'
+    import { unlinkSync } from 'node:fs'
+    const args = process.argv.slice(2)
+    const result = spawnSync(process.execPath, [${JSON.stringify(pnpm)}, ...args], { stdio: 'inherit' })
+    if (args[0] === 'add' && result.status === 0) unlinkSync(${JSON.stringify(p.coreEntry)})
+    process.exitCode = result.status ?? 1
+  `)
+  const installed = await p.mutate(['add', 'file:./addon', '--offline', '--ignore-scripts'], { args: [runner] })
+  expect(installed.exitCode).toBe(1)
