+    cwd: dir, env: { ...env, CI: 'true' }, extendEnv: false, stdin: 'ignore', reject: false,
+    killDescendants: true, timeout: PNPM_REPAIR_TIMEOUT_MS,
+    ...options.signal === undefined ? {} : { cancelSignal: options.signal },
+  })
+  const tree = { pid: child.pid, grouped: leadsOwnGroup('service') }
+  let result
+  try {
+    await recordRun(dir, tree)
+    result = await child
+  } catch (error) {
+    if (treeAlive(tree)) {
+      child.kill()
+      await child.catch(() => { /* The package run's original failure is reported below. */ })
+    }
+    throw error
+  } finally {
+    await awaitTreeGone(tree)
+    if (!treeAlive(tree)) await rm(runRecordPath(dir), { force: true })
+  }
+  if (treeAlive(tree)) throw new Error('a repair process is still active; the previous tree is retained for recovery')
+  if (result.exitCode === 0 && !result.timedOut && !result.isCanceled) return
+  const code = /\bERR_PNPM_[A-Z0-9_]+\b/.exec(result.stderr + result.stdout)?.[0]
+  throw new Error(result.timedOut ? 'the locked reinstall timed out' : result.isCanceled ? 'the locked reinstall was cancelled'
+    : `the locked reinstall failed${code === undefined ? '' : ` (${code})`}`)
+}
+
+async function rebuildProfile(
+  dir: string, expected: ProfilePnpmIdentity, options: PnpmRunOptions, env: NodeJS.ProcessEnv, initiallyEmpty = false,
+): Promise<void> {
+  const files = ['pnpm-lock.yaml', 'package.json', 'pnpm-workspace.yaml'].map((name) => {
+    const path = join(dir, name)
+    return { path, text: optionalFile(path) }
+  })
+  if (!initiallyEmpty && files[0]?.text === undefined) throw new Error('a pnpm lockfile is required to restore the existing plugin versions')
+  const restoreInputs = async (): Promise<boolean> => {
+    let changed = false
+    for (const { path, text } of files) {
+      if (optionalFile(path) === text) continue
+      changed = true
+      if (text === undefined) await rm(path, { force: true })
+      else await writeFileAtomic(path, text, { mode: 0o600 })
+    }
+    return changed
+  }
+  await replaceProfilePackages(dir, async () => {
+    try {
+      options.signal?.throwIfAborted()
+      if (!initiallyEmpty) await reinstallLockedProfile(dir, options, env)
+    } catch (error) {
+      if (optionalFile(runRecordPath(dir)) === undefined) await restoreInputs()
+      throw error
+    }
+    if (await restoreInputs()) throw new Error('the locked reinstall attempted to change profile configuration')
+    const issue = profilePackageIssue(dir, expected)
+    if (issue !== undefined) throw new Error(issue)
+  }, async () => await activeRecordedRun(dir) === undefined)
+}
+
+async function checkAndRepairProfile(
+  dir: string, options: PnpmRunOptions, env: NodeJS.ProcessEnv, notice: (text: string) => void | Promise<void>,
+): Promise<ProfilePnpmIdentity> {
+  if (await restoreInterruptedProfileRepair(dir)) await notice('restored the tree retained by an interrupted repair')
+  const expected = await bundledPnpmIdentity(dir, options, env)
+  const issue = profilePackageIssue(dir, expected)
+  if (issue !== undefined) {
+    await notice(`rebuilding the profile package tree: ${issue}`)
+    await rebuildProfile(dir, expected, options, env)
+    await notice(`verified the rebuilt tree with pnpm ${expected.version}`)
+  }
+  return expected
+}
+
+/** Verify a managed Desktop profile before it is loaded, using the same write lock as plugin mutations.
+ * A fresh profile starts without invoking pnpm. If repair fails but the previous tree is retained, the
+ * Host can try that tree. A package writer or an unresolved swap prevents the Host from using the tree.
+ * @param dir Initialized Desktop profile directory.
+ * @param packageManager The bundled executable and its package-only environment.
+ * @param runtimeModules Installation's package directory; when omitted, empty shadows are left alone.
+ * @returns When the tree can be read; rejects when its package writer or interrupted swap has not settled.
+ */
+export async function prepareDesktopProfilePackages(
+  dir: string, packageManager: NonNullable<ProfileContext['packageManager']>, runtimeModules?: string,
+): Promise<void> {
+  const notes: string[] = []
+  try {
+    await withFileLock(join(dir, 'package.json'), async () => {
+      const active = await activeRecordedRun(dir)
+      if (active !== undefined) throw new Error('an earlier package operation is still active')
+      if (!hasProfilePackages(dir)) return
+      try {
+        await checkAndRepairProfile(dir, packageManager, { ...scrubbedParentEnv(), ...packageManager.env }, (text) => { notes.push(text) })
+      } catch (error) {
+        if (profilePackageRepairPending(dir)) throw error
+        if (runtimeModules !== undefined) {
+          const moved = await quarantineEmptyCoreShadows(dir, runtimeModules)
+          if (moved.length > 0) notes.push(`isolated empty core package directories: ${moved.join(', ')}`)
+        }
+        const note = `profile dependency repair: ${error instanceof Error ? error.message : String(error)}; starting with the previous tree`
+        notes.push(note)
+        console.warn(`dsh: ${note}`)
+      }
+    })
+  } catch (error) {
+    notes.push(`profile dependency repair: ${error instanceof Error ? error.message : String(error)}`)
+    throw error
+  } finally {
+    if (notes.length > 0) {
+      try {
+        await writeFileAtomic(join(dir, '.plugin-manager', 'profile-recovery.log'),
+          [new Date().toISOString(), ...notes, ''].join('\n'), { mode: 0o600, dirMode: 0o700 })
+      } catch (error) {
+        console.warn('dsh: could not write the profile dependency repair log', error)
+      }
+    }
+  }
+}
