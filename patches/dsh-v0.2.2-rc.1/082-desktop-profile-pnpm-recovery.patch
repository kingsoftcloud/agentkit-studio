+/** Exercise Desktop profile recovery and the next package mutation with real pnpm. */
+import { execFile } from 'node:child_process'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync, unlinkSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { promisify } from 'node:util'
+import { expect, it, onTestFinished } from 'vitest'
+import { initProfile, readProfileManifest } from '@deepseek-ai/dsh-app-boot'
+import { prepareDesktopProfilePackages, runPluginCommand, type PackageOperationOptions } from '../src/operations.ts'
+
+const execute = promisify(execFile)
+const pnpm = fileURLToPath(new URL('../../../../apps/desktop/node_modules/pnpm/bin/pnpm.mjs', import.meta.url))
+const core = '@deepseek-ai/dsh-llm'
+
+function readModules(path: string): { packageManager: string; storeDir: string } {
+  return JSON.parse(readFileSync(path, 'utf8')) as { packageManager: string; storeDir: string }
+}
+
+async function profile() {
+  const root = mkdtempSync(join(tmpdir(), 'desktop-pnpm-'))
+  onTestFinished(() => { rmSync(root, { recursive: true, force: true }) })
+  const dir = join(root, 'profile with spaces')
+  initProfile(dir, ['studio-bundle'])
+  const installAnchor = join(root, 'package.json')
+  writeFileSync(installAnchor, '{}\n')
+  const env = { pnpm_config_store_dir: join(root, 'store'), pnpm_config_pm_on_fail: 'ignore' }
+  for (const [folder, name] of [['core', core], ['addon', 'studio-test-addon']] as const) {
+    const path = join(dir, folder)
+    mkdirSync(join(path, 'lib'), { recursive: true })
+    writeFileSync(join(path, 'package.json'), JSON.stringify({ name, version: '1.0.0', main: 'lib/index.js' }))
+    writeFileSync(join(path, 'lib', 'index.js'), 'module.exports = {}\n')
+  }
+  const manifestPath = join(dir, 'package.json')
+  const manifest = readProfileManifest('test', dir)
+  writeFileSync(manifestPath, JSON.stringify({ ...manifest, dependencies: { [core]: 'file:./core' } }))
+  await execute(process.execPath, [pnpm, 'install', '--offline', '--ignore-scripts'], { cwd: dir, env: { ...process.env, ...env } })
+  const modules = join(dir, 'node_modules')
+  const metadataPath = join(modules, '.modules.yaml')
+  const metadata = readModules(metadataPath)
+  const coreEntry = join(modules, core, 'lib', 'index.js')
+  const packageManager = { command: process.execPath, args: [pnpm], env, repairProfile: true as const }
+  const mutate = (args: string[], overrides: Partial<PackageOperationOptions> = {}) =>
+    runPluginCommand({ dir, profile: 'desktop', cwd: dir, installAnchor }, args, {
+      ...packageManager, execution: 'service', activateNewBundles: false, outputBytes: 8192, idleTimeoutMs: 10_000, ...overrides,
+    })
+  const mismatch = (version = 'pnpm@10.33.2') => {
+    writeFileSync(metadataPath, JSON.stringify({ ...metadata, packageManager: version, storeDir: join(root, 'old-store') }))
+  }
+  return { dir, modules, manifestPath, metadata, metadataPath, coreEntry, packageManager, mutate, mismatch }
+}
+
+it('repairs a previous pnpm major before installing and removing a plugin', async () => {
+  const p = await profile()
+  const patch = join(p.dir, 'cordis.patch.yml')
+  writeFileSync(patch, '# preserve this setting\n[]\n')
+  p.mismatch()
+
+  const installed = await p.mutate(['add', 'file:./addon', '--offline', '--ignore-scripts'])
+  expect(installed.exitCode, installed.output).toBe(0)
+  expect(readModules(p.metadataPath)).toMatchObject({
+    packageManager: p.metadata.packageManager, storeDir: p.metadata.storeDir,
+  })
+  expect(existsSync(join(p.modules, 'studio-test-addon', 'package.json'))).toBe(true)
+  expect(existsSync(p.coreEntry)).toBe(true)
+  const removed = await p.mutate(['remove', 'studio-test-addon'])
+  expect(removed.exitCode, removed.output).toBe(0)
+  expect(existsSync(join(p.modules, 'studio-test-addon'))).toBe(false)
+  expect(readFileSync(patch, 'utf8')).toBe('# preserve this setting\n[]\n')
+  expect(readProfileManifest('test', p.dir).dsh?.profile?.bundles).toEqual(['studio-bundle'])
+}, 20_000)
+
+it('does not run the requested mutation or lose dependencies when the lockfile is stale', async () => {
+  const p = await profile()
+  p.mismatch()
+  const lockPath = join(p.dir, 'pnpm-lock.yaml')
