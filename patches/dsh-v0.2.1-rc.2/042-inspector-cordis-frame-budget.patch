diff --git a/packages/experimental/inspector/tests/cordis-frame-budget.host.spec.ts b/packages/experimental/inspector/tests/cordis-frame-budget.host.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..28caf8a0b8ce3bea7f3cd7cc0f4aeab2f7f46a8a
--- /dev/null
+++ b/packages/experimental/inspector/tests/cordis-frame-budget.host.spec.ts
@@ -0,0 +1,36 @@
+/** Cordis publication must include its retained-record envelope in the frame budget. */
+import { Context } from '@deepseek-ai/cordis'
+import { expect, it } from 'vitest'
+import { InspectorSourceBuffer } from '../src/shared/bridge/buffer.ts'
+import { inspectorId } from '../src/shared/bridge/ids.ts'
+import { CordisTreeCollector } from '../src/shared/cordis/collector.ts'
+import { publishCordisTree } from '../src/shared/cordis/publisher.ts'
+
+it('enabling plugins publishes a bounded tree through the real retained-state buffer', async () => {
+  const root = new Context()
+  const fibers = Array.from({ length: 30 }, (_, i) => root.plugin({ name: `plugin-${String(i)}`, apply() {} }))
+  await Promise.all(fibers.map(fiber => fiber.await()))
+  const collector = new CordisTreeCollector(root, { maxNodes: 1000, maxBytes: 1024 * 1024 })
+  const maxBytes = Buffer.byteLength(JSON.stringify(collector.snapshot()))
+  collector.close()
+  const records = new InspectorSourceBuffer({ topics: ['*'], maxQueuedRecords: 100,
+    maxQueuedBytes: 1024 * 1024, maxRecordsPerFrame: 128, maxFrameBytes: maxBytes + 4096 })
+  let stop: (() => void) | undefined
+  try {
+    expect(() => {
+      stop = publishCordisTree(root, {
+        publish: (topic, payload) => { records.publish(topic, payload, 1) },
+        setState: (topic, payload) => { records.setState(topic, payload, 1) },
+      }, { maxNodes: 1000, maxBytes })
+    }).not.toThrow()
+    const sourceId = inspectorId<'InspectorSourceId'>('test-host', 'sourceId')
+    const generation = inspectorId<'InspectorSourceGeneration'>('test-generation', 'generation')
+    const frame = records.replacement(sourceId, generation)
+    expect(frame.records).toHaveLength(1)
+    expect(Buffer.byteLength(JSON.stringify(frame))).toBeLessThanOrEqual(maxBytes + 4096)
+    expect(frame.records[0]?.payload).toMatchObject({ truncated: true })
+  } finally {
+    stop?.()
+    await Promise.all(fibers.map(fiber => fiber.dispose()))
+  }
+})
