+
+it('failed recovery remains open, competing recovery is rejected and cancellation waits for the original executor', async () => {
+  const { agent } = await restored()
+  await expect(agent.externalTurns!.resume(ownership.engine, async () => { throw Error('reconciliation unavailable') })).rejects.toThrow('reconciliation unavailable')
+  expect(agent.externalTurns!.pending()).toEqual(ownership)
