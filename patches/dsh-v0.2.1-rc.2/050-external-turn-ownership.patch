+  { type: 'turn/owner', seq: SessionSeq(1), time: 2, data: ownership },
+  { type: 'step/start', seq: SessionSeq(2), time: 3, data: { turn: 1, step: 1 } },
+]
+const send = (agent: Agent, text: string) => { agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } })) }
+async function harness(root?: string) {
+  const ctx = new Context(); contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  if (root) await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const adapter = new MockAdapter([textResponse('next default turn')])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  ctx.logger.error = vi.fn()
+  return { ctx, adapter }
+}
