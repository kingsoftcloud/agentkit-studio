+
+const contexts: Context[] = [], directories: string[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+  for (const directory of directories.splice(0)) await rm(directory, { recursive: true, force: true })
