+/** Required ownership records for recoverable externally executed turns. */
+import type { ExternalTurnOwnership, SessionEvent } from './types.ts'
+
+/** A rejected ownership transition leaves the original turn unchanged. */
+export class ExternalTurnOwnershipError extends Error {
+  /** @param code - stable reason callers use to select recovery or rejection. */
+  constructor(readonly code: 'invalid_ownership' | 'agent_busy' | 'owner_mismatch' | 'turn_not_open' | 'turn_already_started') {
+    super(`External turn ownership: ${code}`)
+    this.name = 'ExternalTurnOwnershipError'
+  }
+}
+
+/**
+ * Validate a durable ownership record against its enclosing open turn.
+ * @param value - stored event data.
+ * @param turn - enclosing open turn, or zero outside one.
+ * @returns a detached validated record.
+ */
+export function parseExternalTurnOwnership(value: unknown, turn: number): ExternalTurnOwnership {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new ExternalTurnOwnershipError('invalid_ownership')
+  const data = value as Record<string, unknown>
+  if (Object.keys(data).sort().join(',') !== 'binding,contract,engine,turn'
+    || data.contract !== 'dsh.external-turn/v1' || typeof data.turn !== 'number'
+    || !Number.isSafeInteger(data.turn) || data.turn <= 0 || data.turn !== turn
+    || typeof data.engine !== 'string' || !data.engine.trim()
+    || typeof data.binding !== 'string' || !data.binding.trim()) throw new ExternalTurnOwnershipError('invalid_ownership')
+  return { contract: 'dsh.external-turn/v1', turn: data.turn, engine: data.engine, binding: data.binding }
+}
+
+/**
+ * Locate the owner of an unclosed tail turn without repairing or driving it.
+ * @param events - durable Session prefix.
+ * @returns original ownership, or null for a closed or ordinary turn.
+ */
+export function openExternalTurn(events: readonly SessionEvent[]): ExternalTurnOwnership | null {
+  let turn = 0, owner: ExternalTurnOwnership | null = null
+  for (const event of events) {
+    if (event.type === 'turn/start') {
+      if (owner) throw new ExternalTurnOwnershipError('owner_mismatch')
+      turn = event.data.turn
+    }
+    else if (event.type === 'turn/end') { turn = 0; owner = null }
