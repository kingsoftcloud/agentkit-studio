diff --git a/apps/desktop/tests/bundled-plugin-alignment.spec.ts b/apps/desktop/tests/bundled-plugin-alignment.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c017fad7a60062526707bb00ca4113f4493c72a2
--- /dev/null
+++ b/apps/desktop/tests/bundled-plugin-alignment.spec.ts
@@ -0,0 +1,202 @@
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { createRequire } from 'node:module'
+import { afterEach, describe, expect, it } from 'vitest'
+import { alignBundledProductPlugins, verifyPluginCopy } from '../src/bundled-plugin-alignment.ts'
+
+const PRODUCT = '@kingsoftcloud/agentkit-studio'
+const DSH_BASE = '@deepseek-ai/dsh-base'
+const roots: string[] = []
+
+function temporaryRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-alignment-'))
+  roots.push(root)
+  return root
+}
+
+/** Write a minimal package with an explicit version and optional manifest fields. */
+function writePackage(directory: string, name: string, version: string, extra: Record<string, unknown> = {}): string {
+  mkdirSync(directory, { recursive: true })
+  writeFileSync(join(directory, 'package.json'), JSON.stringify({
+    name, version, type: 'module', main: './index.js', ...extra,
+  }, undefined, 2))
+  writeFileSync(join(directory, 'index.js'), `export const identity = ${JSON.stringify(name)}\n`)
+  return directory
+}
+
+interface Fixture {
+  readonly root: string
+  readonly home: string
+  readonly dsh: string
+  readonly profile: string
+}
+
+interface FixtureOptions {
+  readonly bundledVersion?: string
+  readonly profileVersion?: string | null | undefined
+  readonly profileDependency?: string | null | undefined
+  readonly bundleListed?: boolean
+  readonly activationHistory?: boolean
+  readonly bundledDependencies?: Record<string, string>
+  readonly keepDshBase?: boolean
+  readonly hoistDependency?: boolean
+}
+
+/** Runtime carrying the product plugin beside dsh, and a profile that may shadow it. */
+function fixture(options: FixtureOptions = {}): Fixture {
+  const root = temporaryRoot()
+  const home = join(root, '.dsh')
+  const dsh = join(root, 'resources', 'dsh')
+  writePackage(dsh, '@deepseek-ai/dsh-desktop-runtime', '0.2.1-rc.2', {
+    dsh: { profile: { bundles: [DSH_BASE, '@deepseek-ai/dsh-web-app', PRODUCT] } },
+  })
+  writePackage(join(dsh, 'node_modules', '@deepseek-ai', 'dsh-web-app'), '@deepseek-ai/dsh-web-app', '0.2.1-rc.2')
+  if (options.keepDshBase !== false) writePackage(join(dsh, 'node_modules', '@deepseek-ai', 'dsh-base'), DSH_BASE, '0.2.1-rc.2')
+  if (options.hoistDependency !== false) {
+    writePackage(join(dsh, 'node_modules', '@kingsoftcloud', 'agentkit-harness-core'), '@kingsoftcloud/agentkit-harness-core', '0.0.13')
+  }
+  writePackage(join(dsh, 'node_modules', PRODUCT), PRODUCT, options.bundledVersion ?? '0.0.12', {
+    dependencies: options.bundledDependencies ?? {
+      [DSH_BASE]: '0.2.1-rc.2', '@kingsoftcloud/agentkit-harness-core': '0.0.13',
+    },
+  })
+  const profile = join(home, 'profiles', 'desktop-agentkit-studio')
+  const bundles = [DSH_BASE, '@deepseek-ai/dsh-web-app']
+  if (options.bundleListed !== false) bundles.push(PRODUCT)
+  const dependencies: Record<string, string> = {}
+  if (options.profileDependency !== null) dependencies[PRODUCT] = options.profileDependency ?? '0.0.11'
+  writePackage(profile, 'dsh-profile-desktop-agentkit-studio', '0.0.0', {
+    private: true, dependencies, dsh: { profile: { bundles } },
+  })
+  if (options.activationHistory !== false) {
+    writeFileSync(join(profile, 'desktop-product-bundles.json'), `${JSON.stringify([PRODUCT], undefined, 2)}\n`)
+  }
+  if (options.profileVersion !== null) {
+    writePackage(join(profile, 'node_modules', PRODUCT), PRODUCT, options.profileVersion ?? '0.0.11', {
+      dependencies: { '@kingsoftcloud/agentkit-harness-core': '0.0.13' },
+    })
+  }
+  return { root, home, dsh, profile }
+}
+
+function outcomes(input: Fixture) {
+  return alignBundledProductPlugins({ profile: input.profile, runtimeDsh: input.dsh, home: input.home })
+}
+
+function profileManifest(profile: string) {
+  return JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+    dependencies?: Record<string, string>
+    dsh: { profile: { bundles: string[] } }
+  }
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+describe('bundled product plugin alignment', () => {
+  it('materializes the bundled copy and restores a bundle list that native recovery cleared', () => {
+    const input = fixture({ bundleListed: false, profileVersion: null, profileDependency: null })
+    expect(profileManifest(input.profile).dsh.profile.bundles).not.toContain(PRODUCT)
+
+    const result = outcomes(input)
+
+    expect(result).toHaveLength(1)
+    expect(result[0]).toMatchObject({ packageName: PRODUCT, action: 'materialized', bundledVersion: '0.0.12', installationBacked: true })
+    expect(profileManifest(input.profile).dependencies?.[PRODUCT]).toBe('0.0.12')
+    expect(profileManifest(input.profile).dsh.profile.bundles).toContain(PRODUCT)
+    expect(verifyPluginCopy(join(input.profile, 'node_modules', PRODUCT))).toBeUndefined()
+    // The hoisted dependency the profile did not carry is copied beside it.
+    expect(existsSync(join(input.profile, 'node_modules', '@kingsoftcloud', 'agentkit-harness-core', 'package.json'))).toBe(true)
+    // Nothing to do once the profile is healthy.
+    expect(outcomes(input)[0]).toMatchObject({ action: 'current', installationBacked: true })
+  })
+
+  it('replaces an older profile copy and keeps the superseded tree as a backup', () => {
+    const input = fixture({ profileVersion: '0.0.11' })
+    const result = outcomes(input)
+    expect(result[0]).toMatchObject({ action: 'materialized', previousVersion: '0.0.11', bundledVersion: '0.0.12', installationBacked: true })
+    expect(profileManifest(input.profile).dependencies?.[PRODUCT]).toBe('0.0.12')
+    expect(existsSync(result[0]!.backupPath!)).toBe(true)
+    expect(JSON.parse(readFileSync(join(result[0]!.backupPath!, 'package.json'), 'utf8')).version).toBe('0.0.11')
+    expect(verifyPluginCopy(join(input.profile, 'node_modules', PRODUCT))).toBeUndefined()
+  })
+
+  it('keeps a newer profile copy but still selects it again', () => {
+    const input = fixture({ bundledVersion: '0.0.11', profileVersion: '0.0.12', bundleListed: false })
+    expect(outcomes(input)[0]).toMatchObject({ action: 'kept-newer', previousVersion: '0.0.12', installationBacked: false })
+    expect(profileManifest(input.profile).dsh.profile.bundles).toContain(PRODUCT)
+    expect(profileManifest(input.profile).dependencies?.[PRODUCT]).toBe('0.0.12')
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+  })
+
+  it('does not treat a dependency the shipped tree cannot answer as a load requirement', () => {
+    const input = fixture({
+      profileVersion: null,
+      profileDependency: null,
+      bundledDependencies: { '@kingsoftcloud/agentkit-harness-core': '0.0.13', '@cfworker/json-schema': '3.2.1' },
+    })
+    const result = outcomes(input)
+    expect(result[0]).toMatchObject({ action: 'materialized', installationBacked: true })
+    expect(verifyPluginCopy(join(input.profile, 'node_modules', PRODUCT), join(input.dsh, 'node_modules', PRODUCT))).toBeUndefined()
+  })
+
+  it('keeps the working copy and stops after two failed materializations', () => {
+    const input = fixture({ profileVersion: '0.0.11' })
+    const modules = join(input.profile, 'node_modules')
+    expect(outcomes(input)[0]).toMatchObject({ action: 'materialized' })
+    // A read-only profile makes the next materialization fail before it swaps.
+    chmodSync(modules, 0o500)
+    try {
+      const first = outcomes(input)
+      expect(first[0]).toMatchObject({ action: 'restored', installationBacked: false })
+      expect(outcomes(input)[0]).toMatchObject({ action: 'restored' })
+      expect(outcomes(input)[0]).toMatchObject({ action: 'skipped-attempt-budget', installationBacked: false })
+    } finally {
+      chmodSync(modules, 0o700)
+    }
+    expect(profileManifest(input.profile).dependencies?.[PRODUCT]).toBe('0.0.12')
+    // The selection repair is never rolled back: a failed materialization must
+    // still leave a working copy selected for the next launch.
+    expect(profileManifest(input.profile).dsh.profile.bundles).toContain(PRODUCT)
+    expect(verifyPluginCopy(join(input.profile, 'node_modules', PRODUCT))).toBeUndefined()
+  })
+
+  it('rejects a copy whose exported entry is missing instead of pinning it', () => {
+    const input = fixture({ profileVersion: null, profileDependency: null })
+    // The bundled manifest exports a file the tree does not carry.
+    const manifestPath = join(input.dsh, 'node_modules', PRODUCT, 'package.json')
+    const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as Record<string, unknown>
+    manifest.exports = { '.': './src/index.mjs' }
+    writeFileSync(manifestPath, JSON.stringify(manifest, undefined, 2))
+
+    const result = outcomes(input)
+    expect(result[0]).toMatchObject({ action: 'restored', installationBacked: false })
+    expect(result[0]?.reason).toContain('./src/index.mjs')
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(false)
+    expect(profileManifest(input.profile).dsh.profile.bundles).not.toContain(PRODUCT)
+  })
+
+  it('leaves installation-owned bundles and untouched product copies alone', () => {
+    const input = fixture()
+    expect(outcomes(input).map(outcome => outcome.action)).toEqual(['materialized'])
+    rmSync(join(input.dsh, 'node_modules', PRODUCT), { recursive: true, force: true })
+    expect(outcomes(input)[0]).toMatchObject({ action: 'missing-runtime-copy' })
+    expect(existsSync(join(input.profile, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+  })
+
+  it('keeps working when the profile manifest cannot be parsed', () => {
+    const input = fixture()
+    writeFileSync(join(input.profile, 'package.json'), '{')
+    expect(outcomes(input)).toEqual([])
+    expect(existsSync(join(input.dsh, 'node_modules', PRODUCT, 'package.json'))).toBe(true)
+  })
+
+  it('resolves every declared dependency from the materialized profile anchor', () => {
+    const input = fixture({ profileVersion: null, profileDependency: null })
+    outcomes(input)
+    const require = createRequire(join(input.profile, 'node_modules', PRODUCT, 'package.json'))
+    expect(require.resolve('@kingsoftcloud/agentkit-harness-core')).toContain('agentkit-harness-core')
+  })
+})
