index 0000000000000000000000000000000000000000..d276426bea3daee7b9d5e458433478e4e76c602d
--- /dev/null
+++ b/apps/desktop/src/bundled-plugin-alignment.ts
@@ -0,0 +1,503 @@
+/** Install the product plugin the runtime bundles into the profile that loads it. */
+
+import { existsSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { homedir } from 'node:os'
+import { dirname, join, sep } from 'node:path'
+
+/** Scope of the in-box DSH packages, which always resolve from the sealed runtime installation. */
+const INSTALLATION_SCOPE = '@deepseek-ai/'
+/** Profile file recording consecutive failed alignment attempts for one bundled version. */
+const ATTEMPT_MARKER_PREFIX = '.alignment-attempt-'
+/** Profile file recording the product bundles this profile has already activated. */
+const ACTIVATION_HISTORY = 'desktop-product-bundles.json'
+/** Consecutive failures after which alignment stops trying and the profile keeps running as-is. */
+export const ALIGNMENT_ATTEMPT_LIMIT = 2
+/** Dependencies copied in one materialization; a product plugin closure stays far below this. */
+const MAX_CLOSURE_PACKAGES = 512
+
+/** Why one bundled product plugin was or was not installed into the profile. */
+export type PluginAlignmentAction =
+  | 'materialized'
+  | 'current'
+  | 'kept-newer'
+  | 'missing-runtime-copy'
+  | 'restored'
+  | 'skipped-attempt-budget'
+
+/** One product plugin inspected during profile preparation. */
+export interface PluginAlignmentOutcome {
+  readonly packageName: string
+  readonly action: PluginAlignmentAction
+  readonly previousVersion?: string | undefined
+  readonly bundledVersion?: string | undefined
+  /** Where the superseded profile copy was moved, when one existed. */
+  readonly backupPath?: string | undefined
+  /** Diagnostic for a degraded outcome; the profile and its copy are then untouched. */
+  readonly reason?: string | undefined
+  /** Whether the profile copy is verified loadable after this pass. */
+  readonly installationBacked: boolean
+}
+
+/** Inputs the Desktop shell owns while preparing the external plugin profile. */
+export interface PluginAlignmentOptions {
+  readonly profile: string
+  readonly runtimeDsh: string
+  readonly home?: string
+  readonly now?: () => number
+  readonly log?: (message: string, details: PluginAlignmentOutcome) => void
+}
+
+interface Manifest {
+  readonly name?: string
+  readonly version?: string
+  readonly main?: string
+  readonly exports?: string | Readonly<Record<string, unknown>>
+  readonly dependencies?: Readonly<Record<string, string>>
+  readonly peerDependencies?: Readonly<Record<string, string>>
+  readonly dsh?: { readonly profile?: { readonly bundles?: readonly string[] } }
+}
+
+interface AttemptMarker {
+  readonly version: string
+  readonly failures: number
+  readonly reason: string
+  readonly updatedAt: string
+}
+
+/** One candidate product bundle and the profile state that shadows it. */
+interface Candidate {
+  readonly packageName: string
+  readonly bundledDir: string
+  readonly bundledVersion: string
+  readonly installedDir: string
+  readonly installedVersion: string | undefined
+}
+
+/** Directory name safe for a scoped package and its version. */
+function artifactName(packageName: string, version: string): string {
+  return `${packageName.replace(/^@/, '').replace(/[/\\]/g, '-')}-${version}`
+}
+
+/** Read a package manifest without throwing: an unreadable copy is an absent copy. */
+function readManifest(directory: string): Manifest | undefined {
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(join(directory, 'package.json'), 'utf8'))
+    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) return undefined
+    return parsed as Manifest
+  } catch {
+    return undefined
+  }
+}
+
+/** Numeric dotted comparison with prerelease ordering; plugin versions are plain semver. */
+function compareVersions(left: string, right: string): number {
+  const [leftCore = '', leftPre = ''] = left.split('-', 2)
+  const [rightCore = '', rightPre = ''] = right.split('-', 2)
+  const leftParts = leftCore.split('.').map(part => Number.parseInt(part, 10) || 0)
+  const rightParts = rightCore.split('.').map(part => Number.parseInt(part, 10) || 0)
+  for (let index = 0; index < Math.max(leftParts.length, rightParts.length); index += 1) {
+    const leftValue = leftParts[index] ?? 0
+    const rightValue = rightParts[index] ?? 0
+    if (leftValue !== rightValue) return leftValue < rightValue ? -1 : 1
+  }
+  if (leftPre === rightPre) return 0
+  if (leftPre === '') return 1
+  if (rightPre === '') return -1
+  return leftPre < rightPre ? -1 : 1
+}
+
+/**
+ * Resolve one package directory from an anchor without depending on its `exports`.
+ *
+ * The probe walks the same node_modules lookup order Node uses. Electron's asar
+ * filesystem answers the probed directories, so a bundled copy inside `app.asar`
+ * is visible exactly where the Host will look for it. Only directories inside the
+ * sealed runtime are accepted.
+ */
+function resolveRuntimePackage(runtimeDsh: string, anchor: string, packageName: string): string | undefined {
+  const root = runtimeDsh.endsWith(sep) ? runtimeDsh : `${runtimeDsh}${sep}`
+  const require = createRequire(anchor)
+  for (const searchPath of require.resolve.paths(packageName) ?? []) {
+    if (!searchPath.startsWith(root)) continue
+    const candidate = join(searchPath, packageName)
+    if (existsSync(join(candidate, 'package.json'))) return candidate
+  }
+  return undefined
+}
+
+/** Dependency and peer names a resolvable package must supply. */
+function dependencyNames(manifest: Manifest): string[] {
+  return [...new Set([...Object.keys(manifest.dependencies ?? {}), ...Object.keys(manifest.peerDependencies ?? {})])]
+}
+
+/** Relative entry files the package declares through `exports` or `main`. */
+function entryFiles(manifest: Manifest): string[] {
+  const files: string[] = []
+  const collect = (value: unknown): void => {
+    if (typeof value === 'string') {
+      if (value.startsWith('./')) files.push(value)
+      return
+    }
+    if (value === null || typeof value !== 'object' || Array.isArray(value)) return
+    for (const nested of Object.values(value as Record<string, unknown>)) collect(nested)
+  }
+  collect(manifest.exports)
+  if (typeof manifest.main === 'string' && manifest.main.startsWith('./')) files.push(manifest.main)
+  return [...new Set(files)]
+}
+
+/**
+ * Verify a profile copy is loadable, not merely present.
+ *
+ * Every declared dependency and peer dependency must answer from the copy's own
+ * anchor, and every relative entry the manifest exports must exist. A copy that
+ * only looks materialized would fail inside the Host after the first launch.
+ * @param directory - the profile copy of a product plugin.
+ * @returns the first loadability failure, or undefined when the copy answers.
+ */
+export function verifyPluginCopy(directory: string): string | undefined {
+  const manifest = readManifest(directory)
+  if (manifest === undefined) return `unreadable package manifest in ${directory}`
+  const require = createRequire(join(directory, 'package.json'))
+  for (const name of dependencyNames(manifest)) {
+    // Installation-owned packages answer from the sealed runtime's own anchor,
+    // never from the profile; requiring them here would reject a healthy copy.
+    if (name.startsWith(INSTALLATION_SCOPE)) continue
+    try {
+      require.resolve(name)
+    } catch {
+      return `profile copy cannot resolve ${name}`
+    }
+  }
+  for (const entry of entryFiles(manifest)) {
+    if (!existsSync(join(directory, entry))) return `profile copy is missing ${entry}`
+  }
+  return undefined
+}
+
+/**
+ * Copy a package tree file by file.
+ *
+ * `cpSync` cannot copy a directory out of an asar archive: Electron's ASAR
+ * filesystem has no directory handles (`opendirSync` reports ENOTDIR), which is
+ * what made 0.2.1-rc.2.20261104.6 crash before the Host started. Reading and
+ * writing each file uses the asar-aware fs calls that do work.
+ */
+function copyPackageTree(source: string, target: string): void {
+  mkdirSync(target, { recursive: true, mode: 0o700 })
+  for (const entry of readdirSync(source, { withFileTypes: true })) {
+    const from = join(source, entry.name)
+    const to = join(target, entry.name)
+    if (entry.isDirectory()) {
+      copyPackageTree(from, to)
+      continue
+    }
+    if (!entry.isFile()) continue
+    writeFileSync(to, readFileSync(from), { mode: statSync(from).mode & 0o777 })
+  }
+}
+
+/** Marker path for one bundled version. */
+function attemptMarkerPath(profile: string, version: string): string {
+  return join(profile, `${ATTEMPT_MARKER_PREFIX}${version.replace(/[^0-9A-Za-z._-]/g, '-')}`)
+}
+
+/** Read the attempt marker; a malformed or foreign-version marker counts as absent. */
+function readAttemptMarker(path: string, version: string): AttemptMarker | undefined {
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(path, 'utf8'))
+    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) return undefined
+    const marker = parsed as Partial<AttemptMarker>
+    if (marker.version !== version || !Number.isSafeInteger(marker.failures)
+      || (marker.failures ?? 0) < 0 || typeof marker.reason !== 'string' || typeof marker.updatedAt !== 'string') {
+      return undefined
+    }
+    return marker as AttemptMarker
+  } catch {
+    return undefined
+  }
+}
+
+/** Persist one failed attempt without ever blocking startup. */
+function recordFailure(path: string, version: string, previous: AttemptMarker | undefined, reason: string): void {
+  const marker: AttemptMarker = {
+    version,
+    failures: Math.min((previous?.failures ?? 0) + 1, 255),
+    reason: reason.slice(0, 512),
+    updatedAt: new Date().toISOString(),
+  }
+  try {
+    writeFileSync(path, `${JSON.stringify(marker, undefined, 2)}\n`, { mode: 0o600 })
+  } catch {
+    // A profile that cannot record the attempt still must not fail the launch.
+  }
+}
+
+/** Clear the marker after a successful alignment. */
+function clearMarker(path: string): void {
+  try {
+    rmSync(path, { force: true })
+  } catch {
+    // A stale marker only costs one extra attempt on the next launch.
+  }
+}
+
+/** Product bundles this profile has already activated, as recorded by the shell. */
+function activationHistory(profile: string): readonly string[] {
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(join(profile, ACTIVATION_HISTORY), 'utf8'))
+    if (!Array.isArray(parsed)) return []
+    return parsed.filter((value): value is string => typeof value === 'string')
+  } catch {
+    return []
+  }
+}
+
+/** Move a real directory aside, falling back to a copy across filesystems. */
+function moveAside(source: string, target: string): void {
+  mkdirSync(dirname(target), { recursive: true, mode: 0o700 })
+  try {
+    renameSync(source, target)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EXDEV') throw error
+    copyPackageTree(source, target)
+    rmSync(source, { recursive: true, force: true })
+  }
+}
+
+/** The profile manifest with this product pinned and its bundle selected, plus the original. */
+function withProduct(
+  profile: string, packageName: string, version: string,
+): { original: string; next: string } | undefined {
+  const path = join(profile, 'package.json')
+  let original: string
+  try {
+    original = readFileSync(path, 'utf8')
+  } catch {
+    return undefined
+  }
+  let manifest: Record<string, unknown>
+  try {
+    const parsed: unknown = JSON.parse(original)
+    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) return undefined
+    manifest = parsed as Record<string, unknown>
+  } catch {
+    return undefined
+  }
+  const dependencies = { ...(typeof manifest.dependencies === 'object' && manifest.dependencies !== null && !Array.isArray(manifest.dependencies)
+    ? manifest.dependencies as Record<string, string>
+    : {}) }
+  dependencies[packageName] = version
+  const dsh = { ...(typeof manifest.dsh === 'object' && manifest.dsh !== null && !Array.isArray(manifest.dsh)
+    ? manifest.dsh as Record<string, unknown>
+    : {}) }
+  const profileSection = { ...(typeof dsh.profile === 'object' && dsh.profile !== null && !Array.isArray(dsh.profile)
+    ? dsh.profile as Record<string, unknown>
+    : {}) }
+  const current = Array.isArray(profileSection.bundles) ? profileSection.bundles as string[] : []
+  if (!current.includes(packageName)) {
+    const anchor = current.indexOf('@deepseek-ai/dsh-web-app')
+    current.splice(anchor < 0 ? current.length : anchor + 1, 0, packageName)
+  }
+  profileSection.bundles = current
+  dsh.profile = profileSection
+  manifest.dependencies = dependencies
+  manifest.dsh = dsh
+  return { original, next: `${JSON.stringify(manifest, undefined, 2)}\n` }
+}
+
+/** Restore the exact profile manifest text after a failed materialization. */
+function restoreManifest(profile: string, original: string): void {
+  writeFileSync(join(profile, 'package.json'), original, { mode: 0o600 })
+}
+
+/**
+ * Copy the bundled plugin and any dependency it cannot answer into the profile.
+ *
+ * The bundled tree already carries the packages the build hoisted beside it; a
+ * dependency that still answers only from the sealed runtime is copied to the
+ * profile's hoisted `node_modules` so the profile copy resolves it on its own.
+ * @returns the hoisted directories created, in copy order.
+ */
+function copyClosure(runtimeDsh: string, bundledDir: string, stage: string, profile: string): string[] {
+  const created: string[] = []
+  const queue = [stage]
+  let visited = 0
+  while (queue.length > 0) {
+    const directory = queue.shift() as string
+    const manifest = readManifest(directory)
+    if (manifest === undefined) throw new Error(`unreadable package manifest in ${directory}`)
+    const require = createRequire(join(directory, 'package.json'))
+    for (const name of dependencyNames(manifest)) {
+      if (name.startsWith(INSTALLATION_SCOPE)) continue
+      try {
+        require.resolve(name)
+        continue
+      } catch {
+        // The copy does not answer this dependency yet.
+      }
+      const source = resolveRuntimePackage(runtimeDsh, join(bundledDir, 'package.json'), name)
+      if (source === undefined) throw new Error(`bundled copy cannot resolve ${name}`)
+      const target = join(profile, 'node_modules', name)
+      if (!existsSync(join(target, 'package.json'))) {
+        if (created.length >= MAX_CLOSURE_PACKAGES) throw new Error(`dependency closure of ${name} is too large`)
+        copyPackageTree(source, target)
+        created.push(target)
+      }
+      queue.push(target)
+    }
+    visited += 1
+    if (visited > MAX_CLOSURE_PACKAGES) throw new Error('dependency closure is too large')
+  }
+  return created
+}
+
+/**
+ * Install one bundled product plugin into the profile so the Host can load it.
+ *
+ * The copy is staged beside its destination, the dependency closure is completed,
+ * and the staged tree must pass {@link verifyPluginCopy} before it replaces
+ * anything. A superseded copy is moved to `$DSH_HOME/backups/agentkit-studio`
+ * first and restored on any later failure, so a broken materialization can never
+ * remove a copy that used to load.
+ */
+function materializeCandidate(
+  candidate: Candidate, options: PluginAlignmentOptions, home: string, stamp: string,
+): PluginAlignmentOutcome {
+  const { packageName, bundledDir, bundledVersion, installedDir, installedVersion } = candidate
+  const stage = join(options.profile, 'node_modules', `.alignment-stage-${packageName.replace(/[/\\]/g, '-')}-${stamp}`)
+  const markerPath = attemptMarkerPath(options.profile, bundledVersion)
+  const marker = readAttemptMarker(markerPath, bundledVersion)
+  if ((marker?.failures ?? 0) >= ALIGNMENT_ATTEMPT_LIMIT) {
+    return {
+      packageName, action: 'skipped-attempt-budget', previousVersion: installedVersion, bundledVersion,
+      installationBacked: false,
+      reason: `alignment failed ${String(marker?.failures)} times for ${bundledVersion}; keeping the profile copy`,
+    }
+  }
+  const rewrite = withProduct(options.profile, packageName, bundledVersion)
+  if (rewrite === undefined) {
+    return { packageName, action: 'restored', previousVersion: installedVersion, bundledVersion, installationBacked: false, reason: 'profile manifest is not rewritable' }
+  }
+  const backupPath = join(home, 'backups', 'agentkit-studio', `${artifactName(packageName, installedVersion ?? bundledVersion)}-${stamp}`)
+  let created: string[] = []
+  let moved = false
+  let replaced = false
+  try {
+    copyPackageTree(bundledDir, stage)
+    created = copyClosure(options.runtimeDsh, bundledDir, stage, options.profile)
+    const staged = verifyPluginCopy(stage)
+    if (staged !== undefined) throw new Error(staged)
+    if (existsSync(join(installedDir, 'package.json'))) {
+      moveAside(installedDir, backupPath)
+      moved = true
+    }
+    renameSync(stage, installedDir)
+    replaced = true
+    writeFileSync(join(options.profile, 'package.json'), rewrite.next, { mode: 0o600 })
+    const installed = verifyPluginCopy(installedDir)
+    if (installed !== undefined) throw new Error(installed)
+    if (existsSync(stage)) throw new Error('staged copy still shadows the installed copy')
+  } catch (error) {
+    try {
+      restoreManifest(options.profile, rewrite.original)
+    } catch {
+      // The manifest is unchanged when the failed write never replaced it.
+    }
+    if (replaced) {
+      try {
+        rmSync(installedDir, { recursive: true, force: true })
+      } catch {
+        // The staged tree is discarded below; the next launch retries.
+      }
+    }
+    if (moved) {
+      try {
+        moveAside(backupPath, installedDir)
+      } catch {
+        // Keeping the backup is safer than deleting the only copy.
+      }
+    }
+    rmSync(stage, { recursive: true, force: true })
+    for (const directory of created) rmSync(directory, { recursive: true, force: true })
+    const reason = error instanceof Error ? error.message : String(error)
+    recordFailure(markerPath, bundledVersion, marker, reason)
+    return { packageName, action: 'restored', previousVersion: installedVersion, bundledVersion, installationBacked: false, reason }
+  }
+  clearMarker(markerPath)
+  return {
+    packageName, action: 'materialized', previousVersion: installedVersion, bundledVersion,
+    ...moved ? { backupPath } : {}, installationBacked: true,
+  }
+}
+
+/**
+ * Align every product plugin the runtime carries with the profile that loads it.
+ *
+ * The Host selects a plugin only when `dsh.profile.bundles` lists it, and a
+ * profile that lost that entry (native recovery rewrites the list and the
+ * activation history then suppresses the shell's re-add) starts without the
+ * product plugin. Alignment therefore materializes the bundled copy into the
+ * profile, pins its version, and re-adds the bundle entry, verifying loadability
+ * before and after the swap. Failures roll back to the profile exactly as it was;
+ * a copy that used to load is never deleted.
+ *
+ * @param options - profile and sealed runtime locations owned by the shell.
+ * @returns one outcome per product bundle the runtime carries and the profile owns.
+ */
+export function alignBundledProductPlugins(options: PluginAlignmentOptions): readonly PluginAlignmentOutcome[] {
+  const outcomes: PluginAlignmentOutcome[] = []
+  try {
+    const home = options.home ?? String(process.env.DSH_HOME || join(homedir(), '.dsh')).replace(/^~(?=\/|$)/, homedir())
+    const profileManifest = readManifest(options.profile)
+    if (profileManifest === undefined) return outcomes
+    const bundles = readManifest(options.runtimeDsh)?.dsh?.profile?.bundles ?? []
+    const dependencies = profileManifest.dependencies ?? {}
+    const activated = activationHistory(options.profile)
+    const list = profileManifest.dsh?.profile?.bundles ?? []
+    const stamp = new Date(options.now?.() ?? Date.now()).toISOString().replace(/[:.]/g, '-')
+
+    for (const packageName of bundles) {
+      // Installation-owned bundles (`@deepseek-ai/*`) resolve from the sealed
+      // runtime by contract and are never managed as profile product plugins.
+      if (packageName.startsWith(INSTALLATION_SCOPE)) continue
+      const bundledDir = join(options.runtimeDsh, 'node_modules', packageName)
+      const bundledVersion = readManifest(bundledDir)?.version
+      if (bundledVersion === undefined) {
+        outcomes.push({ packageName, action: 'missing-runtime-copy', installationBacked: false })
+        continue
+      }
+      const installedDir = join(options.profile, 'node_modules', packageName)
+      const installedVersion = readManifest(installedDir)?.version
+      const spec = dependencies[packageName]
+      const owned = spec !== undefined || list.includes(packageName) || activated.includes(packageName)
+      // A bundle this profile never had is a deliberate removal: touching it would
+      // resurrect a plugin the person turned off.
+      if (!owned) continue
+      // A profile copy newer than the runtime keeps running: an application upgrade
+      // must never downgrade a plugin the person installed on purpose.
+      if (spec !== undefined && !spec.startsWith('file:') && installedVersion !== undefined
+        && compareVersions(installedVersion, bundledVersion) > 0) {
+        outcomes.push({ packageName, action: 'kept-newer', previousVersion: installedVersion, bundledVersion, installationBacked: false })
+        continue
+      }
+      if (installedVersion === bundledVersion) {
+        const healthy = verifyPluginCopy(installedDir)
+        if (healthy === undefined && list.includes(packageName) && spec === bundledVersion) {
+          outcomes.push({ packageName, action: 'current', previousVersion: installedVersion, bundledVersion, installationBacked: true })
+          continue
+        }
+      }
+      outcomes.push(materializeCandidate({ packageName, bundledDir, bundledVersion, installedDir, installedVersion }, options, home, stamp))
+    }
+  } catch (error) {
+    // Alignment is best-effort preparation: an unexpected filesystem failure must
+    // never stop the Host from starting with the profile that already exists.
+    options.log?.('desktop profile plugin alignment skipped', {
+      packageName: '*', action: 'restored', installationBacked: false,
+      reason: error instanceof Error ? error.message : String(error),
+    })
+  }
+  return outcomes
+}
