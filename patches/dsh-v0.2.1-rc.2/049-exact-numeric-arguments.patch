diff --git a/packages/util/values/tests/raw-number.spec.ts b/packages/util/values/tests/raw-number.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3239ba0423e6fd5ba4f210a972c1632ed4e7b389
--- /dev/null
+++ b/packages/util/values/tests/raw-number.spec.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest'
+import { isJsonValue, snapshotJsonValue, snapshotRawNumberJsonValue } from '../src/index.ts'
+
+const numericJson = JSON as typeof JSON & {
+  rawJSON: (token: string) => { readonly rawJSON: string }
+  isRawJSON: (value: unknown) => boolean
+}
+
+describe('execution-local raw JSON numbers', () => {
+  it('preserves intrinsic numbers while detaching records and refusing ordinary persistence', () => {
+    const input = { id: numericJson.rawJSON('9007199254740993'), values: [numericJson.rawJSON('-0.0'), numericJson.rawJSON('1.0000000000000001e+18')] }
+    const result = snapshotRawNumberJsonValue(input)
+    expect(result).not.toBe(input)
+    expect(result?.values).not.toBe(input.values)
+    expect(numericJson.isRawJSON(result?.id)).toBe(true)
+    expect(JSON.stringify(result)).toBe('{"id":9007199254740993,"values":[-0.0,1.0000000000000001e+18]}')
+    expect(snapshotJsonValue(input)).toBeUndefined()
+    expect(isJsonValue(input)).toBe(false)
+  })
+
+  it('never interprets a record field as intrinsic numeric authority', () => {
+    const input = { id: { rawJSON: '9007199254740993' } }
+    expect(JSON.stringify(snapshotRawNumberJsonValue(input))).toBe('{"id":{"rawJSON":"9007199254740993"}}')
+    expect(numericJson.isRawJSON(snapshotRawNumberJsonValue(input)?.id)).toBe(false)
+    expect(snapshotJsonValue(input)).toEqual(input)
+  })
+
+  it('rejects nonnumeric raw tokens, nonfinite floats, bigint and cycles', () => {
+    for (const token of ['"text"', 'null', 'true', '1e999']) {
+      expect(snapshotRawNumberJsonValue({ value: numericJson.rawJSON(token) })).toBeUndefined()
+    }
+    for (const value of [1n, -0, NaN, Infinity, undefined, () => 1]) {
+      expect(snapshotRawNumberJsonValue({ value })).toBeUndefined()
+    }
+    const cycle: { self?: object } = {}
+    cycle.self = cycle
+    expect(snapshotRawNumberJsonValue(cycle)).toBeUndefined()
+  })
+
+  it('reads getters once and keeps very large integer tokens exact', () => {
+    let reads = 0
+    const token = '9'.repeat(4300)
+    const result = snapshotRawNumberJsonValue({ get n() { reads++; return numericJson.rawJSON(token) } })
+    expect(reads).toBe(1)
+    expect(JSON.stringify(result)).toBe(`{"n":${token}}`)
+  })
+})
