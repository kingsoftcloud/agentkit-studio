diff --git a/packages/core/tools/tests/raw-number.spec.ts b/packages/core/tools/tests/raw-number.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9b0663543799925053650be85013a50f5b832c5c
--- /dev/null
+++ b/packages/core/tools/tests/raw-number.spec.ts
@@ -0,0 +1,68 @@
+import { expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+
+const numericJson = JSON as typeof JSON & {
+  rawJSON: (token: string) => { readonly rawJSON: string }
+  isRawJSON: (value: unknown) => boolean
+}
+
+it('carries exact numeric tokens through real tool policy, body, and final rendering', async () => {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  const seen: string[] = []
+  const expected = '{"id":9007199254740993,"zero":-0.0,"float":1.0000000000000001e+18}'
+  try {
+    ctx.tools.register({ name: 'exact', description: 'Echo exact numeric arguments.',
+      parameters: { type: 'object' },
+      output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: String(value) }] },
+      async execute(args) { seen.push('body'); expect(JSON.stringify(args)).toBe(expected); return JSON.stringify(args) },
+    })
+    ctx.on('tools/pre-execute', async (exec, next) => {
+      seen.push('pre'); expect(JSON.stringify(exec.arguments)).toBe(expected)
+      expect(exec.argumentEncoding).toBe('dsh.raw-json-number/v1')
+      expect(Object.isFrozen(exec.arguments)).toBe(true)
+      return next()
+    })
+    ctx.tools.guard((exec) => {
+      seen.push('guard'); expect(JSON.stringify(exec.arguments)).toBe(expected)
+      return undefined
+    })
+    ctx.on('tools/execute', async (exec, next) => { seen.push('around'); expect(JSON.stringify(exec.arguments)).toBe(expected); return next() })
+    ctx.on('tools/post-execute', async (exec, _result, next) => { seen.push('post'); expect(JSON.stringify(exec.arguments)).toBe(expected); return next() })
+    const result = await ctx.tools.execute({ callId: ToolCallId('raw-number'), name: 'exact', argumentEncoding: 'dsh.raw-json-number/v1',
+      arguments: { id: numericJson.rawJSON('9007199254740993'), zero: numericJson.rawJSON('-0.0'), float: numericJson.rawJSON('1.0000000000000001e+18') },
+      signal: new AbortController().signal })
+    expect(ctx.tools.argumentEncodings).toContain('dsh.raw-json-number/v1')
+    expect(result.isError, JSON.stringify(result)).toBe(false)
+    expect(result.content).toEqual([{ type: 'text', text: expected }])
+    expect(seen).toEqual(['pre', 'guard', 'around', 'body', 'post'])
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('rejects unnegotiated or invalid encodings before policy and preserves a denial', async () => {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  let effects = 0, policies = 0
+  try {
+    ctx.tools.register({ name: 'effect', description: '', parameters: { type: 'object' },
+      output: { schema: { type: 'null' }, render: () => [] }, async execute() { effects++; return null },
+    })
+    ctx.tools.guard(() => { policies++; return 'Denied by policy' })
+    const base = { callId: ToolCallId('denied'), name: 'effect', arguments: { n: numericJson.rawJSON('9007199254740993') }, signal: new AbortController().signal }
+    expect((await ctx.tools.execute(base)).isError).toBe(true)
+    expect(policies).toBe(0)
+    const invalid = { ...base, argumentEncoding: 'dsh.raw-json-number/v1' as const }
+    Reflect.set(invalid, 'argumentEncoding', 'unrecognized')
+    expect((await ctx.tools.execute(invalid)).isError).toBe(true)
+    expect(policies).toBe(0)
+    const denied = await ctx.tools.execute({ ...base, argumentEncoding: 'dsh.raw-json-number/v1' })
+    expect(denied.isError).toBe(true)
+    expect(policies).toBe(1)
+    expect(effects).toBe(0)
+  } finally { await ctx.fiber.dispose() }
+})
