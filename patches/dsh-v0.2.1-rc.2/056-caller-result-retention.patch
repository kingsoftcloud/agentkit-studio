   })
 })
+
+
+describe('caller-owned retention', () => {
+  it('returns the complete authorized observation without creating host spill locators', async () => {
+    const { ctx, spill } = await setup({ maxInlineTokens: 64 }, true, (context) => {
+      context.on('tools/post-execute', async (_exec, _result, next) => {
+        await next()
+        return { kind: 'accept', content: [{ type: 'text', text: 'authorized '.repeat(1000) }] }
+      })
+    })
+    ctx.tools.register(textTool('big', 'private raw payload'))
+    expect(ctx.tools.resultRetentions).toContain('caller/v1')
+    const result = await ctx.tools.execute({ ...exec('big'), resultRetention: 'caller/v1' })
+    expect(textOf(result.content)).toBe('authorized '.repeat(1000))
+    expect(textOf(result.content)).not.toContain('private raw payload')
+    expect(spill?.saves).toHaveLength(0)
+  })
+
+  it('preserves post-policy denial and does not turn retention ownership into authorization', async () => {
+    const { ctx, spill } = await setup({ maxInlineTokens: 64 }, true, (context) => {
+      context.on('tools/post-execute', async (_exec, _result, next) => {
+        await next()
+        return { kind: 'block', feedback: [{ type: 'text', text: 'policy denied' }] }
+      })
+    })
+    ctx.tools.register(textTool('big', 'private '.repeat(1000)))
+    const result = await ctx.tools.execute({ ...exec('big'), resultRetention: 'caller/v1' })
+    expect(result.isError).toBe(true)
+    expect(textOf(result.content)).toContain('policy denied')
+    expect(textOf(result.content)).not.toContain('private')
+    expect(spill?.saves).toHaveLength(0)
+  })
+
+  it('rejects unsupported ownership contracts before dispatch', async () => {
+    const { ctx } = await setup({ maxInlineTokens: 64 })
+    const body = vi.fn(async () => [{ type: 'text' as const, text: 'ran' }])
+    ctx.tools.register(defineContentToolFixture({ name: 'big', description: 'big', parameters: {}, execute: body }))
+    const result = await ctx.tools.execute({ ...exec('big'), resultRetention: 'unknown' as 'caller/v1' })
+    expect(result.isError).toBe(true)
+    expect(body).not.toHaveBeenCalled()
+  })
+})
