new file mode 100644
index 0000000000000000000000000000000000000000..3a60318fe7ce760d4b95f1073e03e07f8c4eb056
--- /dev/null
+++ b/packages/client/ui-schedule/tests/embedded-manager.client.spec.tsx
@@ -0,0 +1,59 @@
+// @vitest-environment jsdom
+import { Context, Service } from '@deepseek-ai/cordis'
+import { act, fireEvent, screen, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import * as renderer from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { ScheduleCatalogEntry, ScheduleId } from '@deepseek-ai/dsh-schedule/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import * as schedule from '../src/client/index.ts'
+
+const cleanups: Array<() => Promise<void>> = []
+afterEach(async () => { for (const cleanup of cleanups.splice(0).reverse()) await cleanup() })
+
+it('renders the native manager factory without workspace navigation or conversation services', async () => {
+  const ctx = new Context()
+  const container = document.createElement('div')
+  document.body.append(container)
+  let unmount: (() => void) | undefined
+  cleanups.push(async () => { await act(async () => { unmount?.(); await ctx.fiber.dispose() }); container.remove() })
+  const sessionId = 'cloud-only' as SessionId
+  const record: ScheduleCatalogEntry = { id: 'task' as ScheduleId, sessionId, kind: 'weekly', title: 'Weekly review', prompt: 'Check report', scheduledAt: '2030-01-01T09:00:00.000Z', time: '09:00:00.000', timeZone: 'UTC', weekdays: [1], status: 'active' }
+  const changed = new Set<() => void>()
+  const catalog = vi.fn(async () => ({ ok: true as const, value: [record] }))
+  class Remote extends Service {
+    constructor(scope: Context) { super(scope, 'remote') }
+    $on(_event: string, listener: () => void) { changed.add(listener); return () => { changed.delete(listener) } }
+  }
+  const navigate = vi.fn()
+  await ctx.plugin(renderer).await()
+  await ctx.plugin({ inject: ['slots'], apply(scope: Context) {
+    new Remote(scope)
+    scope.provide('remote.schedule', { catalog } as never)
+    const locale = new LocaleRuntime(scope, undefined, { languages: ['en'], preference: null })
+    scope.provide('locale', locale)
+    scope.slots.installLocale(locale)
+    const absentSession = createSnapshotStore({ key: undefined, hooks: {}, keyedHooks: {}, props: { sessionId: undefined } })
+    scope.slots.installScope('session', { current: absentSession, bindingSource: () => absentSession })
+    scope.slots.provideRoot({ hooks: {
+      sessions: createSnapshotStore({ phase: 'ready', ids: [sessionId], byId: { [sessionId]: { id: sessionId, title: 'Assistant', displayTitle: 'Assistant', running: false, blank: false, updatedAt: 0, retainedBy: {} } }, projectionsBySession: {} } as const),
+      workspaces: createSnapshotStore({ items: [], archivedSessionIds: [], pinnedSessionIds: [], state: 'idle', phase: 'ready', error: null } as const),
+    } })
+    scope.slots.register({ name: 'root', children: { 'shell.overlay': { kind: 'list', scope: 'root' } } }, ({ renderFactorySlot, renderSlot }) => <>
+      {renderFactorySlot('schedule.manager', { onNewTask: navigate, onOpenSession: navigate })}
+      {renderSlot('shell.overlay', {})}
+    </>)
+  } }).await()
+  const plugin = ctx.plugin(schedule)
+  await plugin.await()
+  await act(async () => { unmount = ctx.get('uiRenderer')!.mount(container) })
+  await waitFor(() => expect(screen.getByText('Weekly review')).toBeTruthy())
+  fireEvent.click(screen.getByRole('button', { name: 'New' }))
+  expect(navigate).toHaveBeenCalledOnce()
+  expect(ctx.get('sessions')).toBeUndefined()
+  expect(ctx.get('uiWorkspace')).toBeUndefined()
+  expect(catalog).toHaveBeenCalledOnce()
+  await act(async () => { await plugin.dispose() })
+  expect(changed.size).toBe(0)
+})
