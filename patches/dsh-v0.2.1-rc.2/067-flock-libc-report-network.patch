diff --git a/native/system/test/fixtures/flock-libc-report.js b/native/system/test/fixtures/flock-libc-report.js
new file mode 100644
index 0000000000000000000000000000000000000000..569b9f029e5135c6720ea9ecb1ee9f3e384169d1
--- /dev/null
+++ b/native/system/test/fixtures/flock-libc-report.js
@@ -0,0 +1,32 @@
+/** A fresh loader owns report interception and restores the caller's report settings. */
+import assert from 'node:assert/strict';
+import { tryLockExclusive } from '../../packages/entry/lib/flock.js';
+
+const report = process.report;
+const initial = process.argv[2] === 'enabled';
+const fail = process.argv[3] === 'failure';
+const originalExcludeNetwork = report.excludeNetwork;
+const originalGetReport = report.getReport;
+const failure = new Error('libc report unavailable');
+let calls = 0;
+try {
+  report.excludeNetwork = initial;
+  report.getReport = function (...args) {
+    calls++;
+    assert.equal(this.excludeNetwork, true, 'libc detection must exclude network inspection');
+    if (fail) throw failure;
+    return originalGetReport.apply(this, args);
+  };
+  await assert.rejects(tryLockExclusive(-1), fail
+    ? (error) => error === failure
+    : { code: 'EBADF', syscall: 'flock' });
+  assert.equal(calls, 1);
+  assert.equal(report.excludeNetwork, initial, 'libc detection must restore the caller setting');
+} finally {
+  report.getReport = originalGetReport;
+  report.excludeNetwork = originalExcludeNetwork;
+}
+await new Promise((resolve, reject) => {
+  process.send({ type: 'ready' }, (error) => error ? reject(error) : resolve());
+});
+process.disconnect();
