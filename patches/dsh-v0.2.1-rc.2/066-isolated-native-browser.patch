diff --git a/packages/client/ui-sidebar-browser/tests/embedded-browser.client.spec.tsx b/packages/client/ui-sidebar-browser/tests/embedded-browser.client.spec.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..06326b31b04bbb92b8ee3ba8c7f4415d44fe58cd
--- /dev/null
+++ b/packages/client/ui-sidebar-browser/tests/embedded-browser.client.spec.tsx
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+/** Real root renderer composition for disposable, isolated Browser content. */
+import { Context } from '@deepseek-ai/cordis'
+import { createElement } from 'react'
+import { act, fireEvent, waitFor, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import * as renderer from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import * as browser from '@deepseek-ai/dsh-client-ui-sidebar-browser/client'
+import { createIsolatedIframePage } from '../src/client/pages.ts'
+import { ISOLATED_BROWSER_SANDBOX } from '../src/client/view/IframePresentation.ts'
+import type { DesktopBrowserLeaseId, DesktopBrowserBridge } from '../src/types.ts'
+
+const credentials = new URL('https://example.test/'); credentials.username = 'synthetic-user'; credentials.password = 'synthetic-password'
+const cleanup: Array<() => Promise<void>> = []
+afterEach(async () => {
+  for (const dispose of cleanup.splice(0)) await dispose()
+  vi.unstubAllGlobals(); vi.restoreAllMocks(); localStorage.clear()
+})
+
+async function mountBrowser(url = 'https://docs.example/one') {
+  const ctx = new Context()
+  await ctx.plugin(renderer).await()
+  const absent = createSnapshotStore({ key: undefined, hooks: {}, keyedHooks: {}, props: {} })
+  ctx.slots.installScope('session', { current: absent, bindingSource: () => absent })
+  const locale = new LocaleRuntime(ctx)
+  ctx.provide('locale', locale)
+  ctx.slots.installLocale(locale)
+  await ctx.plugin(browser).await()
+  ctx.slots.register({ name: 'root' }, ({ renderFactorySlot }) => createElement('div', null, renderFactorySlot('browser.content', { url })))
+  const host = document.createElement('div'); document.body.append(host)
+  const uiRenderer = ctx.get('uiRenderer')
+  if (uiRenderer === undefined) throw new Error('Browser fixture renderer was not installed')
+  let unmount: () => void
+  await act(async () => { unmount = uiRenderer.mount(host) })
+  let disposed = false
+  const dispose = async () => {
+    if (disposed) return
+    disposed = true
+    await act(async () => { unmount(); await ctx.fiber.dispose() })
+    host.remove()
+  }
+  cleanup.push(dispose)
+  return { ctx, host, dispose, ui: within(host) }
+}
+
+describe('isolated Browser content', () => {
+  it('uses the native chrome without Session, Workspace or Sidebar services and never restores saved browsing', async () => {
+    localStorage.setItem('dsh.sidebar-browser.v1', '{"url":"https://private.example"}')
+    const external = vi.spyOn(window, 'open').mockReturnValue(null)
+    const mounted = await mountBrowser()
+    const frame = mounted.host.querySelector('iframe')!
+    expect(frame.src).toBe('https://docs.example/one')
+    expect(frame.getAttribute('sandbox')).toBe(ISOLATED_BROWSER_SANDBOX)
+    expect(frame.getAttribute('sandbox')?.split(' ')).toEqual(['allow-scripts', 'allow-forms'])
+    expect(frame.hasAttribute('credentialless')).toBe(true)
+    expect(mounted.host.textContent).not.toContain('private.example')
+    expect(mounted.host.querySelector('[aria-pressed]')).toBeNull()
+    expect(mounted.ctx.get('sessions')).toBeUndefined()
+    expect(mounted.ctx.get('workspaces')).toBeUndefined()
+    expect(mounted.ctx.get('remote')).toBeUndefined()
+    expect(external).not.toHaveBeenCalled()
+    const input = mounted.ui.getByRole('textbox')
+    fireEvent.change(input, { target: { value: 'https://docs.example/two' } }); fireEvent.submit(input.closest('form')!)
+    await waitFor(() => { expect(mounted.host.querySelector('iframe')?.src).toBe('https://docs.example/two') })
+    expect(localStorage.getItem('dsh.sidebar-browser.v1')).toBe('{"url":"https://private.example"}')
+    await mounted.dispose()
+    expect(frame.isConnected).toBe(false)
+  })
+
+  it('cannot relax the opaque-origin sandbox through a direct provider command', async () => {
+    const host = document.createElement('div'); host.id = 'isolated-provider'; document.body.append(host)
+    const page = createIsolatedIframePage({ initial: undefined, persist() {}, openRequested() {} })
+    try {
+      page.presentation.mount(host.id)
+      page.frame.loadUrl({ kind: 'https', url: 'https://example.test/', title: 'test' })
+      page.frame.sandbox?.setEnabled(false)
+      page.frame.reload()
+      expect(page.frame.getSnapshot().sandboxEnabled).toBeUndefined()
+      expect(host.querySelector('iframe')?.getAttribute('sandbox')).toBe(ISOLATED_BROWSER_SANDBOX)
+    } finally { await page.frame.dispose(); host.remove() }
+  })
+
+  it.each(['javascript:alert(1)', 'file:///private/report', credentials.href, window.location.origin + '/api'])('refuses privileged initial URL %s', async (url) => {
+    const mounted = await mountBrowser(url)
+    expect(mounted.host.querySelector('iframe')).toBeNull()
+    expect(mounted.ui.getByRole('alert')).toBeDefined()
+  })
+
+  it('uses a fresh opaque desktop identity and releases guests on occurrence close', async () => {
+    let sequence = 0
+    const bridge = {
+      acquire: vi.fn(async (_identity: string) => ({ lease: `lease-${++sequence}` as DesktopBrowserLeaseId, partition: `guest-${sequence}` })),
+      release: vi.fn(async (_lease: DesktopBrowserLeaseId) => {}), onOpenRequested: vi.fn(() => () => {}),
+    } satisfies DesktopBrowserBridge
+    vi.stubGlobal('dshDesktop', { protocolVersion: 1, browser: bridge })
+    const first = await mountBrowser()
+    await waitFor(() => { expect(first.host.querySelector('webview')).not.toBeNull() })
+    const firstIdentity = bridge.acquire.mock.calls[0]![0]
+    expect(firstIdentity).toMatch(/^embedded-browser:[0-9a-f-]+$/u)
+    expect(first.host.querySelector('webview')?.getAttribute('partition')).toBe('guest-1')
+    await first.dispose()
+    expect(bridge.release).toHaveBeenCalledWith('lease-1')
+    const second = await mountBrowser()
+    await waitFor(() => { expect(second.host.querySelector('webview')).not.toBeNull() })
+    expect(bridge.acquire.mock.calls[1]![0]).not.toBe(firstIdentity)
+    await second.dispose()
+    expect(bridge.release).toHaveBeenCalledTimes(2)
+  })
+})
