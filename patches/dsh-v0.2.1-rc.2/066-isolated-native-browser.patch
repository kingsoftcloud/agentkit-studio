+/** Root-scoped, disposable occurrence of the native Browser chrome. */
+import { useId, useLayoutEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import type { FactoryComponentPropsOf } from '@deepseek-ai/dsh-client-ui-slots'
+import type { TabId } from '@deepseek-ai/dsh-client-ui-dockkit'
+import { emptyBrowserFrame } from '../browser/BrowserFrame.ts'
+import { BrowserChrome } from './BrowserChrome.tsx'
+
+const EMPTY_FRAME = emptyBrowserFrame()
+
+
+/** Mount one page; closing or replacing the occurrence aborts its controller.
+ * @param props - initial URL and framework-bound controller state and commands.
+ * @returns the native Browser chrome with fixed isolated embedding policy.
+ */
+export function EmbeddedBrowserBody({ url, mount, loadUrl, restore, goBack, goForward, reload,
+  setSandbox, useBrowserState, t }: FactoryComponentPropsOf<'browser.content'>): ReactNode {
+  const tabId = useId() as TabId
+  const viewportId = useId()
+  const [mountEpoch, setMountEpoch] = useState(0)
+  const state = useBrowserState(tabId)
+  useLayoutEffect(() => {
+    const lifetime = new AbortController()
+    const hide = mount({ tabId, signal: lifetime.signal, viewportId, applicationOrigin: window.location.origin,
+      initial: undefined, initialUrl: url, openTab: (value) => { loadUrl(tabId, value) } })
+    setMountEpoch(value => value + 1)
+    return () => { lifetime.abort(); hide() }
+  }, [mount, tabId, viewportId, url, loadUrl])
+  return <BrowserChrome frame={state?.frame ?? EMPTY_FRAME} state={state} restoreTarget={undefined}
+    initialUrl={url} viewportId={viewportId} mountEpoch={mountEpoch} t={t}
+    loadUrl={(value) => { loadUrl(tabId, value) }} restore={() => { restore(tabId) }}
+    goBack={() => { goBack(tabId) }} goForward={() => { goForward(tabId) }} reload={() => { reload(tabId) }}
+    setSandbox={(enabled) => { setSandbox(tabId, enabled) }} />
+}
