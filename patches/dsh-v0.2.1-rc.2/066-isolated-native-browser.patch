+
+/** Assemble an iframe whose fixed sandbox cannot be relaxed by controller commands.
+ * @param options - in-memory navigation callbacks.
+ * @returns the isolated iframe provider and its presentation.
+ */
+export function createIsolatedIframePage(options: BrowserPageOptions): BrowserPage {
+  const presentation = new IframePresentation({
+    loaded: (revision) => { frame.handleLoaded(revision) },
+    failed: (revision) => { frame.handleLoadFailed(revision) },
+    remounted: () => { frame.reload() },
+  }, true)
+  const frame = new IframeImpl(options, presentation, true)
+  return { frame, presentation }
+}
