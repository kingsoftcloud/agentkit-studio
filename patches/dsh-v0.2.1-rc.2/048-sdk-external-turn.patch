@@ -0,0 +1,22 @@
+# TypeScript SDK snapshot-record patch over `dsh --profile sdk` for the
+# generic agent/execute-turn whole-turn seam. The FIRST admitted turn of a
+# fresh session is owned by a deterministic external engine (no model call); a
+# later turn delegates to the standard model/tool loop, served by a keyless
+# mock model so no provider key is required. The engine admits the system-prompt
+# head itself so the delegated turn reuses it without a v4 surface append.
+
+- id: llm-deepseek
+  name: '@deepseek-ai/dsh-llm-deepseek-api-key'
+  disabled: true
+
+- id: session-persistence-jsonl
+  name: '@deepseek-ai/dsh-session-persistence-jsonl'
+  config:
+    root: !!js dshHomePath('sessions')
+    compression: !!js "process.env.DSH_SNAPSHOT === undefined ? 'zstd' : 'none'"
+
+- insert:
+    - id: external-turn-mock-model
+      name: './mock-model.mjs'
+    - id: external-turn-engine
+      name: './engine.mjs'
