@@ -0,0 +1,98 @@
+/** Deterministic external engine for the Python SDK external-turn smoke.
+
+  Composed through the public agent/execute-turn seam: own the FIRST admitted
+  turn of a fresh session without entering the standard model/tool loop — admit
+  the system-prompt head, user input, and a structured assistant message with
+  pinned usage, then return the turn-ending reason. A later turn delegates to
+  the default engine (served by the smoke's mock model) to demonstrate
+  coexistence. The host still owns turn boundaries, cancellation, status, and
+  teardown.
+
+  This fixture lives under scripts/fixtures, which has no `node_modules` of its
+  own, so it cannot import @deepseek-ai/dsh-llm or -system-prompt. It constructs
+  the assistant and system message values directly with the same shape
+  createAssistantMessage/createSystemMessage produce, and renders the system
+  prompt from input.assembly with a faithful local copy of renderPrompt so the
+  delegated turn reuses this head instead of appending a new one.
+*/
+import { randomUUID } from 'node:crypto'
+
+export const name = 'python-sdk-external-turn'
+
+const VARIABLE_NAME = /^[a-z][a-z0-9_]*$/
+const GROUP_AT = /^\{\{([^{}]*)\}\}/
+
+/** Render one assembly's sections, interpolating {{variable}} references. */
+function renderPrompt(assembly) {
+  return assembly.sections
+    .map(section => (section.interpolate === false ? section.text : interpolate(section, assembly.variables, 'section')))
+    .filter(text => text.length > 0)
+    .join('\n\n')
+}
+
+/** Interpolate strict {{name}} references; matches dsh-system-prompt.interpolate. */
+function interpolate(input, variables, kind) {
+  const text = input.text
+  let result = ''
+  let last = 0
+  for (let open = text.indexOf('{{'); open >= 0; open = text.indexOf('{{', last)) {
+    const group = GROUP_AT.exec(text.slice(open))
+    if (group === null) {
+      if (text.indexOf('}}', open + 2) >= 0) {
+        throw new Error(`malformed prompt variable reference at "${text.slice(open, open + 16)}…" in ${kind} "${input.name}"`)
+      }
+      result += text.slice(last, open + 2)
+      last = open + 2
+      continue
+    }
+    const name = group[0].slice(2, -2)
+    if (!VARIABLE_NAME.test(name)) {
+      throw new Error(`malformed prompt variable reference "{{${name}}}" in ${kind} "${input.name}"`)
+    }
+    if (!Object.hasOwn(variables, name)) {
+      throw new Error(`unknown prompt variable "{{${name}}}" in ${kind} "${input.name}"`)
+    }
+    const value = variables[name]
+    if (value === undefined) {
+      throw new Error(`prompt variable "{{${name}}}" has no value for this assembly (${kind} "${input.name}")`)
+    }
+    result += text.slice(last, open) + value
+    last = open + group[0].length
+  }
+  return result + text.slice(last)
+}
+
+/**
+ * @param {import('@deepseek-ai/cordis').Context} ctx - Composed runtime services.
+ */
+export function apply(ctx) {
+  let owned = false
+  ctx.on('agent/execute-turn', async ({ agent, input, turn, signal }, next) => {
+    // Own only the first turn of a fresh session; delegate later turns unchanged.
+    if (owned) return next()
+    owned = true
+    signal.throwIfAborted()
+    const systemText = renderPrompt(input.assembly)
+    agent.session.append('step/start', { turn, step: 1 })
+    agent.session.append('system/message', {
+      turn, step: 1, message: {
+        id: randomUUID(),
+        role: 'system',
+        content: systemText.length === 0 ? [] : [{ type: 'text', text: systemText }],
+        source: { kind: 'system-prompt' },
+      },
+    }, { surfaceOp: 'append' })
+    for (const message of input.messages) agent.session.append('user/message', message, { surfaceOp: 'append' })
+    agent.session.append('assistant/message', {
+      turn, step: 1, stream: [], message: {
+        id: randomUUID(),
+        role: 'assistant',
+        content: [{ type: 'text', text: 'External engine completed.' }],
+        source: { kind: 'model', provider: 'external-fixture', model: 'fixture/v1' },
+      },
+      usage: { inputTokens: 3, outputTokens: 4 },
+    }, { surfaceOp: 'append' })
+    agent.session.append('step/end', { turn, step: 1 })
+    return { reason: { kind: 'completed' } }
+  })
+}
