+def smoke_sdk_external_turn(base_url: str, executable: Path, update_snapshots: bool) -> None:
+    """Exercise the generic agent/execute-turn whole-turn seam through the packaged runtime.
+
+    The FIRST turn of a fresh session is owned by a deterministic external
+    engine that admits its own transcript (system head, user input, structured
+    assistant message) without a model request; a later turn delegates to the
+    standard model/tool loop (served by the smoke mock model) to demonstrate
+    coexistence. The snapshot pins the delegated turn's model-visible request
+    and asserts the handled turn reached no provider.
+    """
+    from deepseek_harness import DeepSeekHarness
+
+    first_request = len(MockModelHandler.requests)
+    with tempfile.TemporaryDirectory(prefix="dsh-sdk-external-turn-") as temporary:
+        root = Path(temporary).resolve()
+        dsh_home = root / "home"
+        sessions = dsh_home / "sessions"
+        patch = write_profile_patch(root, "external-turn.patch.yml", sessions, [
+            {"insert": [{
+                "id": "external-turn-engine",
+                "name": (Path(__file__).resolve().parent / "fixtures/python-sdk-external-turn.mjs").as_uri(),
+            }]},
+        ])
+        with DeepSeekHarness(
+            provider="deepseek-official",
+            model="smoke-model",
+            cwd=str(root),
+            dsh_bin=str(executable),
+            dsh_home=str(dsh_home),
+            profile="sdk",
+            patches=(str(patch),),
+            api_key="sk-keyless-smoke",
+            base_url=base_url,
+            request_timeout_seconds=60,
+        ) as harness:
+            session = harness.start_session(EXTERNAL_TURN_SESSION_ID)
+            handled = session.run(EXTERNAL_TURN_HANDLED_PROMPT)
+            delegated = session.run(EXTERNAL_TURN_DELEGATED_PROMPT)
+
+        assert handled.final_response == EXTERNAL_TURN_HANDLED_TEXT, (
+            handled.final_response, handled.events,
+        )
+        assert delegated.final_response == EXTERNAL_TURN_DELEGATED_TEXT, (
+            delegated.final_response, delegated.events,
+        )
+        assert_session_log(sessions, root, EXTERNAL_TURN_HANDLED_TEXT, EXTERNAL_TURN_DELEGATED_TEXT)
+        requests = MockModelHandler.requests[first_request:]
+        # The handled first turn owns the whole turn; only the delegated later
+        # turn reaches the model, so exactly one model request is recorded.
+        assert len(requests) == 1, [
+            message_text(message.get("content"))
+            for request in requests
+            for message in request.get("messages", [])
+            if isinstance(message, dict) and message.get("role") == "user"
+        ]
+        files = build_minimal_snapshot_files(requests, root)
+        compare_snapshot_files(
+            files, update_snapshots, EXTERNAL_TURN_SNAPSHOT_DIRECTORY, EXTERNAL_TURN_SNAPSHOT_FILENAMES,
+        )
+
+
