--- /dev/null
+++ b/snapshots/sdk/external-turn/mock-model.mjs
@@ -0,0 +1,37 @@
+/** Keyless deterministic model adapter for the delegated turn's default loop.
+
+  This plugin lives under the snapshot directory, which has no `node_modules` of
+  its own, so it cannot import `@deepseek-ai/dsh-llm`. `registerAdapter` is
+  duck-typed: a plain object with the adapter methods satisfies the contract
+  without the class import.
+*/
+export const name = 'external-turn-mock-model'
+export const inject = ['llm']
+
+const RESPONSE_TEXT = 'Default engine completed.'
+
+/** Stream one fixed text response so the delegated turn is fully deterministic. */
+async function* stream() {
+  yield { type: 'block-start', index: 0, blockType: 'text' }
+  yield { type: 'text-delta', index: 0, text: RESPONSE_TEXT }
+  yield { type: 'block-end', index: 0, block: { type: 'text', text: RESPONSE_TEXT } }
+  yield { type: 'usage', usage: { inputTokens: 7, outputTokens: RESPONSE_TEXT.length } }
+  yield { type: 'finish', reason: { kind: 'stop' } }
+}
+
+/**
+ * Register the mock route the recorded fixture selects, so the delegated turn
+ * runs the standard request/tool loop without a provider key.
+ * @param {import('@deepseek-ai/cordis').Context} ctx - Composed runtime services.
+ */
+export function apply(ctx) {
+  ctx.llm.registerAdapter(['mock'], {
+    providerInfo: provider => ({ id: provider, name: 'Mock' }),
+    providerRetryPolicy: () => undefined,
+    resolveModel: (provider, model) => ({ provider, id: model, name: model }),
+    prepareCall: (provider, model) => ({
+      model: { provider, id: model, name: model },
+      stream: () => stream(),
+    }),
+  })
+}
