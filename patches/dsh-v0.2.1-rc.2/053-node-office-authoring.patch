+import { Buffer } from 'node:buffer'
+import { zipSync, strToU8 } from 'fflate'
+import { DOMParser } from '@xmldom/xmldom'
+import { describe, expect, it } from 'vitest'
+import { OfficePackageError, readOfficePackage } from '../src/office-package.ts'
+
+const text = '<root><item style="bold">Original 中文</item><item>Keep</item></root>'
+const binary = new Uint8Array([0, 255, 1, 7, 0, 128])
+const archive = () => zipSync({ 'document.xml': strToU8(text), 'extras/unsupported.bin': binary })
+const parse = (xml: string) => new DOMParser().parseFromString(xml, 'application/xml')
+
+function replaceZipNames(bytes: Uint8Array, before: string, after: string): Uint8Array {
+  const result = Buffer.from(bytes)
+  expect(before.length).toBe(after.length)
+  let offset = 0
+  while ((offset = result.indexOf(before, offset)) >= 0) {
+    result.write(after, offset)
+    offset += after.length
+  }
+  return result
+}
+
+describe('Office ZIP part editing', () => {
+  it('changes text and retains run attributes, other nodes and unsupported binary bytes', async () => {
+    const pkg = await readOfficePackage(archive())
+    const originalBinary = pkg.part('extras/unsupported.bin')
+    const doc = pkg.xml('document.xml')
+    doc.getElementsByTagName('item')[0]!.textContent = 'Modified 中文'
+    expect(pkg.xml('document.xml').getElementsByTagName('item')[0]!.textContent).toBe('Original 中文')
+    pkg.replaceXml('document.xml', doc)
+    const reopened = await readOfficePackage(await pkg.save())
+    expect(reopened.xml('document.xml').getElementsByTagName('item')[0]!.getAttribute('style')).toBe('bold')
+    expect(reopened.xml('document.xml').getElementsByTagName('item')[0]!.textContent).toBe('Modified 中文')
+    expect(reopened.xml('document.xml').getElementsByTagName('item')[1]!.textContent).toBe('Keep')
+    expect(reopened.part('extras/unsupported.bin')).toEqual(originalBinary)
+  })
+
+  it('retains all untouched file bytes while omitting optional directory records', async () => {
+    const pkg = await readOfficePackage(zipSync({ 'extras/': new Uint8Array(), 'document.xml': strToU8(text), 'extras/data': binary }))
+    const reopened = await readOfficePackage(await pkg.save())
+    expect(reopened.names()).toEqual(pkg.names())
+    for (const name of pkg.names()) expect(reopened.part(name)).toEqual(pkg.part(name))
+  })
+
+  it('copies input before async work and isolates returned names, bytes and DOMs', async () => {
+    const input = archive()
+    const pending = readOfficePackage(input)
+    input.fill(0)
+    const pkg = await pending
+    expect(Object.isFrozen(pkg.names())).toBe(true)
+    expect(() => (pkg.names() as string[]).push('injected.xml')).toThrow()
+    const part = pkg.part('extras/unsupported.bin')!
+    part.fill(10)
+    expect(pkg.part('extras/unsupported.bin')).toEqual(binary)
+    pkg.xml('document.xml').documentElement!.textContent = 'Uncommitted'
+    expect(pkg.xml('document.xml').documentElement!.textContent).toBe('Original 中文Keep')
+  })
+
+  it('adds and deletes parts for new images, relationships and embedded content with caller-owned schema updates', async () => {
+    const pkg = await readOfficePackage(archive())
+    const input = new Uint8Array([4, 5, 6])
+    pkg.setPart('media/new.png', input)
+    input.fill(0)
