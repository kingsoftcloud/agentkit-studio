diff --git a/apps/desktop/tests/fixtures/office-conversion-inputs.mjs b/apps/desktop/tests/fixtures/office-conversion-inputs.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..01a3c50185eae0e573a7e39e646ebe80494d3308
--- /dev/null
+++ b/apps/desktop/tests/fixtures/office-conversion-inputs.mjs
@@ -0,0 +1,84 @@
+/** Create, edit and reopen real Office inputs using only the packaged Node module. */
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+const [root, library] = process.argv.slice(2)
+const { docx, ExcelJS, PptxGenJS, readOfficePackage } = await import(pathToFileURL(library).href)
+const wordNS = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'
+const sheetNS = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'
+const drawingNS = 'http://schemas.openxmlformats.org/drawingml/2006/main'
+const hash = bytes => createHash('sha256').update(bytes).digest('hex')
+const document = new docx.Document({
+  comments: { children: [{ id: 0, author: 'Office QA', children: [new docx.Paragraph('Keep this comment')] }] },
+  sections: [{ children: [new docx.Paragraph({ children: [
+    new docx.CommentRangeStart(0), new docx.TextRun({ text: 'Desktop Office conversion 42', bold: true }),
+    new docx.CommentRangeEnd(0), new docx.CommentReference(0), new docx.TextRun({ text: ' Keep italic', italics: true }),
+  ] })] }],
+})
+const wordBytes = await docx.Packer.toBuffer(document)
+const workbook = new ExcelJS.Workbook()
+const sheet = workbook.addWorksheet('Sheet1')
+sheet.addRow(['Desktop Office conversion 42', 42])
+sheet.getCell('A1').font = { bold: true, color: { argb: 'FF003366' } }
+sheet.getCell('B2').value = { formula: 'B1*2', result: 84 }
+sheet.getCell('B2').numFmt = '0.00'
+const sheetBytes = new Uint8Array(await workbook.xlsx.writeBuffer({ useSharedStrings: true }))
+const presentation = new PptxGenJS()
+const slide = presentation.addSlide()
+slide.addText('Desktop Office conversion 42', { x: 0.5, y: 0.25, w: 8, h: 0.5, bold: true })
+slide.addChart(presentation.ChartType.bar, [{ name: 'Revenue', labels: ['Q1', 'Q2'], values: [21, 42] }],
+  { x: 0.5, y: 1, w: 8, h: 3 })
+slide.addNotes('Keep these speaker notes')
+const slideBytes = new Uint8Array(await presentation.write({ outputType: 'arraybuffer' }))
+
+const results = []
+for (const [extension, bytes, target, namespace] of [
+  ['docx', wordBytes, 'word/document.xml', wordNS],
+  ['xlsx', sheetBytes, 'xl/sharedStrings.xml', sheetNS],
+  ['pptx', slideBytes, 'ppt/slides/slide1.xml', drawingNS],
+]) {
+  const pkg = await readOfficePackage(bytes)
+  const before = new Map(pkg.names().map(name => [name, pkg.part(name)]))
+  const xml = pkg.xml(target)
+  const texts = Array.from(xml.getElementsByTagNameNS(namespace, 't'))
+  const matches = texts.filter(node => node.textContent === 'Desktop Office conversion 42')
+  assert.equal(matches.length, 1, `${extension}: unique target`)
+  matches[0].textContent = 'Desktop Office conversion 43'
+  pkg.replaceXml(target, xml)
+  const output = await pkg.save()
+  const reopened = await readOfficePackage(output)
+  assert.deepEqual(reopened.names(), pkg.names())
+  assert.equal(Array.from(reopened.xml(target).getElementsByTagNameNS(namespace, 't'))
+    .filter(node => node.textContent === 'Desktop Office conversion 43').length, 1)
+  for (const [name, content] of before) if (name !== target) assert.deepEqual(reopened.part(name), content, name)
+  if (extension === 'docx') {
+    const doc = reopened.xml(target)
+    assert.equal(doc.getElementsByTagNameNS(wordNS, 'b').length, 1)
+    assert.equal(doc.getElementsByTagNameNS(wordNS, 'i').length, 1)
+    assert.match(new TextDecoder().decode(reopened.part('word/comments.xml')), /Keep this comment/)
+  } else if (extension === 'xlsx') {
+    const check = new ExcelJS.Workbook()
+    await check.xlsx.load(output)
+    assert.equal(check.getWorksheet('Sheet1').getCell('A1').value, 'Desktop Office conversion 43')
+    assert.equal(check.getWorksheet('Sheet1').getCell('A1').font.bold, true)
+    assert.deepEqual(check.getWorksheet('Sheet1').getCell('B2').value, { formula: 'B1*2', result: 84 })
+    assert.equal(check.getWorksheet('Sheet1').getCell('B2').numFmt, '0.00')
+  } else {
+    assert.ok(reopened.names().some(name => /^ppt\/charts\/chart\d+\.xml$/.test(name)))
+    const embedded = reopened.names().find(name => /^ppt\/embeddings\/.+\.xlsx$/.test(name))
+    assert.ok(embedded, 'chart has a real embedded workbook')
+    const data = new ExcelJS.Workbook()
+    await data.xlsx.load(reopened.part(embedded))
+    assert.equal(data.worksheets[0].getCell('B3').value, 42)
+    assert.match(new TextDecoder().decode(reopened.part('ppt/notesSlides/notesSlide1.xml')), /Keep these speaker notes/)
+    assert.match(new TextDecoder().decode(reopened.part(target)), /b="1"/)
+  }
+  await writeFile(join(root, `input.${extension}`), output)
+  results.push({ extension, bytes: output.byteLength, sha256: hash(output), preservedParts: before.size - 1, modifiedPart: target })
+}
+await writeFile(join(root, 'office-authoring-proof.json'), JSON.stringify({ node: process.version, librarySha256: hash(
+  await (await import('node:fs/promises')).readFile(library)), results }, null, 2) + '\n')
+console.log(JSON.stringify({ node: process.version, results }))
