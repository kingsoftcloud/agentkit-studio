diff --git a/packages/skill/skill-office/tsdown.config.ts b/packages/skill/skill-office/tsdown.config.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f47904809f84cb5365e812f2e0608399484bec2a
--- /dev/null
+++ b/packages/skill/skill-office/tsdown.config.ts
@@ -0,0 +1,42 @@
+import { defineConfig } from 'tsdown'
+import { existsSync, readFileSync, readdirSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+
+/** The ordinary plugin and a relocatable library bundle used by task scripts. */
+export default defineConfig([
+  {
+    entry: ['lib/types/index.js'], outDir: 'lib', format: ['esm'], platform: 'node',
+    target: 'es2024', fixedExtension: false, dts: false, clean: false,
+  },
+  {
+    entry: { authoring: 'lib/types/authoring.js' }, outDir: 'lib', format: ['esm'], platform: 'node',
+    target: 'es2024', fixedExtension: false, dts: false, clean: false,
+    deps: { alwaysBundle: [/./] }, shims: true,
+    plugins: [{
+      name: 'office-library-notices',
+      generateBundle(_options, bundle) {
+        const roots = new Set<string>()
+        for (const entry of Object.values(bundle)) {
+          if (entry.type !== 'chunk') continue
+          for (const id of Object.keys(entry.modules)) {
+            if (!id.includes('/node_modules/')) continue
+            let path = dirname(id)
+            while (path !== dirname(path) && !existsSync(join(path, 'package.json'))) path = dirname(path)
+            if (existsSync(join(path, 'package.json'))) roots.add(path)
+          }
+          const notices = [...roots].sort().map(root => {
+            const manifest = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'))
+            const files = readdirSync(root).filter(file => /^(?:licen[sc]e|copying|notice)(?:[.\-_]|$)/iu.test(file))
+            const texts = files.map(file => `${file}\n${readFileSync(join(root, file), 'utf8')}`)
+            if (texts.length === 0) {
+              const readme = readdirSync(root).find(file => /^readme(?:\.|$)/iu.test(file))
+              if (readme !== undefined) texts.push(readFileSync(join(root, readme), 'utf8'))
+            }
+            return `${manifest.name}@${manifest.version} (${manifest.license ?? 'See accompanying text'})\n${texts.join('\n\n')}`
+          })
+          entry.code += '\n/*! Third-party notices\n' + notices.join('\n\n---\n\n').replaceAll('*/', '* /') + '\n*/\n'
+        }
+      },
+    }],
+  },
+])
