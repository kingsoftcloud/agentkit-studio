index 0000000000000000000000000000000000000000..f3246268bd85e8688ca857b34a72fc2d43e8f556
--- /dev/null
+++ b/packages/skill/skill-office/src/office-package.ts
@@ -0,0 +1,251 @@
+/** In-memory OOXML part editing; untouched part bytes survive saves, including unsupported Office extensions. */
+
+import JSZip from 'jszip'
+import { unzipSync } from 'fflate'
+import { DOMParser, XMLSerializer, type Document } from '@xmldom/xmldom'
+
+/** Failures leave the input and the last accepted in-memory parts unchanged. */
+export type OfficePackageErrorCode =
+  | 'invalid-archive' | 'invalid-xml' | 'limit' | 'missing-part' | 'invalid-part-name' | 'duplicate-part'
+
+/** Stable failure identity for callers; no filesystem, network or subprocess effects occur. */
+export class OfficePackageError extends Error {
+  constructor(readonly code: OfficePackageErrorCode, message: string, options?: ErrorOptions) {
+    super(message, options)
+    this.name = 'OfficePackageError'
+  }
+}
+
+/** Positive safe-integer bounds on compressed input/output and decompressed contents. */
+export interface OfficePackageLimits {
+  /** Maximum compressed archive size; defaults to 128 MiB. */
+  maxArchiveBytes?: number
+  /** Maximum ZIP entries including directories; defaults to 10,000. */
+  maxEntries?: number
+  /** Maximum decompressed part size; defaults to 64 MiB. */
+  maxPartBytes?: number
+  /** Maximum sum of decompressed part sizes; defaults to 256 MiB. */
+  maxTotalBytes?: number
+}
+
+/** Edits ZIP parts, not Office schemas; callers own relationships, content types, signatures and formula caches. */
+export interface OfficePackage {
+  /** @returns A frozen snapshot of current file names, without directory entries. */
+  names(): readonly string[]
+  /** @param name - Relative ZIP file name. @returns Copied current bytes, or undefined for an absent part. */
+  part(name: string): Uint8Array | undefined
+  /** @param name - Existing XML part. @returns A detached document; invalid XML rejects with invalid-xml. */
+  xml(name: string): Document
+  /** Replaces an existing part with validated UTF-8 XML; failure retains the previous part.
+   * @param name - Existing XML part. @param document - Edited DOM document.
+   */
+  replaceXml(name: string, document: Document): void
+  /** Adds or replaces binary/XML bytes; caller updates related OOXML parts before saving.
+   * @param name - Relative ZIP file name. @param bytes - Bytes copied before publication.
+   */
+  setPart(name: string, bytes: Uint8Array): void
+  /** @param name - Relative ZIP file name. @returns Whether a part was removed; caller updates related OOXML parts. */
+  deletePart(name: string): boolean
+  /** @returns A compressed snapshot of current parts; rejects on size limits, without modifying accepted parts. */
+  save(): Promise<Uint8Array>
+}
+
+function resolveLimits(options: OfficePackageLimits): Required<OfficePackageLimits> {
+  const limits = {
+    maxArchiveBytes: options.maxArchiveBytes ?? 128 * 1024 * 1024,
+    maxEntries: options.maxEntries ?? 10_000,
+    maxPartBytes: options.maxPartBytes ?? 64 * 1024 * 1024,
+    maxTotalBytes: options.maxTotalBytes ?? 256 * 1024 * 1024,
+  }
+  for (const [name, value] of Object.entries(limits)) {
+    if (!Number.isSafeInteger(value) || value <= 0) throw new OfficePackageError('limit', `${name} must be a positive safe integer`)
+  }
+  return limits
+}
+
+function validateName(name: string, directory = false): string {
+  const key = directory ? name.slice(0, -1) : name
+  if (!key || /[\\\x00-\x1f\x7f]/u.test(key) || /^[a-z]:/iu.test(key)
+    || key.split('/').some(segment => !segment || segment === '.' || segment === '..')) {
+    throw new OfficePackageError('invalid-part-name', `Invalid ZIP part name: ${name}`)
+  }
+  return key
+}
+
+function validateHierarchy(entries: Map<string, boolean>): void {
+  for (const key of entries.keys()) {
+    const segments = key.split('/')
+    for (let count = 1; count < segments.length; count++) {
+      if (entries.get(segments.slice(0, count).join('/')) === false) {
+        throw new OfficePackageError('invalid-part-name', 'A ZIP file cannot contain child entries')
+      }
+    }
+  }
+}
+
+function scanArchive(bytes: Uint8Array, limits: Required<OfficePackageLimits>): Map<string, boolean> {
+  const entries = new Map<string, boolean>()
+  let total = 0
+  try {
+    unzipSync(bytes, { filter(file) {
+      const directory = file.name.endsWith('/')
+      const key = validateName(file.name, directory)
+      if (entries.has(key)) throw new OfficePackageError('duplicate-part', `Duplicate ZIP part: ${key}`)
+      entries.set(key, directory)
+      total += file.originalSize
+      if (entries.size > limits.maxEntries || file.originalSize > limits.maxPartBytes || total > limits.maxTotalBytes) {
+        throw new OfficePackageError('limit', 'Declared ZIP contents exceed configured limits')
+      }
+      return false
+    } })
+    validateHierarchy(entries)
+  } catch (cause) {
+    if (cause instanceof OfficePackageError) throw cause
+    throw new OfficePackageError('invalid-archive', 'Cannot read ZIP directory', { cause })
+  }
+  return entries
+}
+
+function decodeXml(bytes: Uint8Array): Document {
+  try {
+    let encoding = 'utf-8'
+    let start = 0
+    if (bytes[0] === 0xff && bytes[1] === 0xfe) { encoding = 'utf-16le'; start = 2 }
+    else if (bytes[0] === 0xfe && bytes[1] === 0xff) { encoding = 'utf-16be'; start = 2 }
+    else if (bytes[0] === 0xef && bytes[1] === 0xbb && bytes[2] === 0xbf) start = 3
+    else if (bytes[0] === 0 && bytes[1] === 0x3c) encoding = 'utf-16be'
+    else if (bytes[0] === 0x3c && bytes[1] === 0) encoding = 'utf-16le'
+    const text = new TextDecoder(encoding, { fatal: true }).decode(bytes.subarray(start))
+    const declared = /^<\?xml\s[^?]*\bencoding\s*=\s*["']([^"']+)["']/iu.exec(text)?.[1]?.toLowerCase()
+    const compatible = declared === undefined || declared === encoding || (declared === 'utf8' && encoding === 'utf-8')
+      || (declared === 'utf-16' && encoding.startsWith('utf-16'))
+    if (!compatible || /<!DOCTYPE\s|<!ENTITY\s/iu.test(text)) throw new Error('Unsupported XML encoding or declaration')
+    return new DOMParser({ onError(_level, message) {
+      throw new Error(message)
+    } }).parseFromString(text, 'application/xml')
+  } catch (cause) {
+    throw new OfficePackageError('invalid-xml', 'Cannot parse XML part', { cause })
+  }
+}
+
+function encodeXml(document: Document): Uint8Array {
+  try {
+    let text = new XMLSerializer().serializeToString(document)
+    text = text.replace(/^<\?xml\s[^?]*\?>\s*/u, '')
+    const bytes = new TextEncoder().encode('<?xml version="1.0" encoding="UTF-8"?>\n' + text)
+    decodeXml(bytes)
+    return bytes
+  } catch (cause) {
+    if (cause instanceof OfficePackageError) throw cause
+    throw new OfficePackageError('invalid-xml', 'Cannot serialize XML part', { cause })
+  }
+}
+
+function readBounded(entry: JSZip.JSZipObject, maxBytes: number): Promise<Uint8Array> {
+  return new Promise((resolve, reject) => {
+    const stream = entry.nodeStream('nodebuffer')
+    const chunks: Buffer[] = []
+    let size = 0
+    let stopped = false
+    stream.on('data', (chunk: Buffer) => {
+      if (stopped) return
+      size += chunk.byteLength
+      if (size > maxBytes) {
+        stopped = true
+        stream.pause()
+        chunks.length = 0
+        reject(new OfficePackageError('limit', `Decompressed ZIP part exceeds configured limit: ${entry.name}`))
+      } else chunks.push(chunk)
+    })
+    stream.on('error', (cause) => {
+      stopped = true
+      chunks.length = 0
+      reject(new OfficePackageError('invalid-archive', `Cannot decompress ZIP part: ${entry.name}`, { cause }))
+    })
+    stream.on('end', () => { if (!stopped) resolve(Buffer.concat(chunks, size)) })
+  })
+}
+
+class OfficePackageImpl implements OfficePackage {
+  constructor(private readonly parts: Map<string, Uint8Array>, private readonly limits: Required<OfficePackageLimits>) {}
+
+  names(): readonly string[] { return Object.freeze([...this.parts.keys()].sort()) }
+  part(name: string): Uint8Array | undefined {
+    const bytes = this.parts.get(validateName(name))
+    return bytes === undefined ? undefined : Uint8Array.from(bytes)
+  }
+  xml(name: string): Document {
+    const bytes = this.part(name)
+    if (bytes === undefined) throw new OfficePackageError('missing-part', `Missing ZIP part: ${name}`)
+    return decodeXml(bytes)
+  }
+  replaceXml(name: string, document: Document): void {
+    validateName(name)
+    if (!this.parts.has(name)) throw new OfficePackageError('missing-part', `Missing ZIP part: ${name}`)
+    this.setPart(name, encodeXml(document))
+  }
+  setPart(name: string, bytes: Uint8Array): void {
+    validateName(name)
+    const next = new Map(this.parts)
+    next.set(name, bytes)
+    this.checkContents(next)
+    validateHierarchy(new Map([...next.keys()].map(key => [key, false])))
+    this.parts.set(name, Uint8Array.from(bytes))
+  }
+  deletePart(name: string): boolean { return this.parts.delete(validateName(name)) }
+  async save(): Promise<Uint8Array> {
+    const snapshot = new Map(this.parts)
+    this.checkContents(snapshot)
+    const zip = new JSZip()
+    for (const [name, bytes] of snapshot) zip.file(name, bytes, { createFolders: false })
+    try {
+      const result = await zip.generateAsync({ type: 'uint8array', compression: 'DEFLATE', compressionOptions: { level: 6 } })
+      if (result.byteLength > this.limits.maxArchiveBytes) throw new OfficePackageError('limit', 'Output ZIP exceeds configured limit')
+      return result
+    } catch (cause) {
+      if (cause instanceof OfficePackageError) throw cause
+      throw new OfficePackageError('invalid-archive', 'Cannot save ZIP parts', { cause })
+    }
+  }
+  private checkContents(parts: Map<string, Uint8Array>): void {
+    let total = 0
+    for (const bytes of parts.values()) {
+      total += bytes.byteLength
+      if (bytes.byteLength > this.limits.maxPartBytes) throw new OfficePackageError('limit', 'ZIP part exceeds configured limit')
+    }
+    if (parts.size > this.limits.maxEntries || total > this.limits.maxTotalBytes) {
+      throw new OfficePackageError('limit', 'ZIP contents exceed configured limits')
+    }
+  }
+}
+
+/** Reads a copied ZIP with bounded decompression and CRC checks. Rejects malformed/ambiguous names and unsupported XML on access.
+ * Empty directory entries are omitted on save; compression, ZIP metadata and digital signatures are not preserved.
+ * @param input - OOXML ZIP bytes; copied before the first asynchronous operation.
+ * @param options - Memory and entry limits. Oversized inputs reject before copying.
+ * @returns Editable parts; untouched file bytes survive saving. OOXML schema consistency remains caller-owned.
+ */
+export async function readOfficePackage(input: Uint8Array, options: OfficePackageLimits = {}): Promise<OfficePackage> {
+  const limits = resolveLimits(options)
+  if (input.byteLength > limits.maxArchiveBytes) throw new OfficePackageError('limit', 'ZIP input exceeds configured limit')
+  const bytes = Uint8Array.from(input)
+  const scanned = scanArchive(bytes, limits)
+  let archive: JSZip
+  try { archive = await JSZip.loadAsync(bytes, { checkCRC32: false, createFolders: false }) }
+  catch (cause) { throw new OfficePackageError('invalid-archive', 'Cannot load ZIP parts', { cause }) }
+  const actual = Object.values(archive.files)
+  if (actual.length !== scanned.size || actual.some(entry => scanned.get(validateName(entry.name, entry.dir)) !== entry.dir)) {
+    throw new OfficePackageError('invalid-archive', 'ZIP readers disagree on part names')
+  }
+  const parts = new Map<string, Uint8Array>()
+  let total = 0
+  for (const entry of actual) {
+    const part = await readBounded(entry, Math.min(limits.maxPartBytes, limits.maxTotalBytes - total))
+    total += part.byteLength
+    if (!entry.dir) parts.set(entry.name, part)
+  }
+  // CRC validation uses the same private input after actual decompressed sizes have been bounded.
+  try { await JSZip.loadAsync(bytes, { checkCRC32: true, createFolders: false }) }
+  catch (cause) { throw new OfficePackageError('invalid-archive', 'ZIP CRC validation failed', { cause }) }
+  return new OfficePackageImpl(parts, limits)
+}
