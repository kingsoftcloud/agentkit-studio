+/** External filesystem owner with Agent-scoped instruction observation. */
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import { agentEvents } from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-agent-instructions'
+import type {} from '@deepseek-ai/dsh-working-directory'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+
+export const name = 'external-instruction-observer'
+export const inject = ['tools', 'workingDirectory']
+
+/**
+ * Read through an external tool and check guidance on the following request.
+ * @param ctx - assembled headless runtime and workspace instruction loader.
+ */
+export function apply(ctx: Context): void {
+  let requests = 0
+  ctx.tools.register(defineContentToolFixture({
+    name: 'external_read',
+    description: 'Read a workspace file through an external execution owner.',
+    parameters: { file_path: { type: 'string', description: 'Workspace-relative path.' } },
+    async execute(args, exec) {
+      if (exec.agent === undefined) throw new Error('external read requires an Agent')
+      const cwd = await ctx.workingDirectory.ensure(exec.agent, exec.signal)
+      const path = resolve(cwd, args.file_path)
+      const text = await readFile(path, { encoding: 'utf8', signal: exec.signal })
+      exec.signal.throwIfAborted()
+      agentEvents(ctx, exec.agent).emit('agent-instructions/touch', { paths: [path] })
+      return [{ type: 'text', text }]
+    },
+  }))
+  ctx.on('llm/stream', (options, next) => {
+    const visible = JSON.stringify(options.messages)
+    if (++requests === 1) assert.equal(visible.includes('Nested snapshot instruction.'), false)
+    else assert.ok(visible.includes('Nested snapshot instruction.'), 'external observation must enter the next model request')
+    return next()
+  })
+}
