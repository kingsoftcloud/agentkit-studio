+/** Parse the optional public build input before it reaches typed registry calls. */
+function parseBuildCopy(source: string): Record<string, Record<string, LocaleDict>> {
+  const record = (value: unknown): value is Record<string, unknown> =>
+    value !== null && typeof value === 'object' && !Array.isArray(value)
+  const value: unknown = JSON.parse(source)
+  if (!record(value)) throw new Error('Invalid product copy')
+  return Object.fromEntries(Object.entries(value).map(([namespace, dictionaries]) => {
+    if (!namespace || !record(dictionaries)) throw new Error('Invalid product copy')
+    return [namespace, Object.fromEntries(Object.entries(dictionaries).map(([locale, entries]) => {
+      if (!record(entries)) throw new Error('Invalid product copy')
+      return [locale, Object.fromEntries(Object.entries(entries).map(([key, template]) => {
+        if (typeof template !== 'string') throw new Error('Invalid product copy')
+        return [key, template]
+      }))]
+    }))]
