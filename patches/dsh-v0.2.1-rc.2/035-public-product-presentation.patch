+import { expect, it } from 'vitest'
+import { fileURLToPath } from 'node:url'
+import {
+  officialClientBuildEnvironment,
+  repositoryClientBuildEnvironment,
+  resolveClientBuildEnvironment,
+} from '../../../scripts/client-build-environment.ts'
+
+const root = fileURLToPath(new URL('../../../', import.meta.url))
+it('keeps the official build defaults without optional product inputs', () => {
+  const environment = officialClientBuildEnvironment(root, { DSH_CLIENT_UNRELATED: 'not part of the official contract' })
+  expect(environment.DSH_CLIENT_TITLE).toBe('DeepSeek Harness')
+  expect(environment.DSH_CLIENT_UNRELATED).toBeUndefined()
+  expect(environment.DSH_CLIENT_LOCALE_OVERRIDES).toBeUndefined()
+  expect(environment.DSH_CLIENT_BRAND_MARK_URL).toBeUndefined()
+})
+
+it('records only the explicit public product copy and mark extensions', () => {
+  const environment = officialClientBuildEnvironment(root, {
+    DSH_CLIENT_LOCALE_OVERRIDES: '{"conversation":{"en":{"hero.headline":"Product"}}}',
+    DSH_CLIENT_BRAND_MARK_URL: 'data:image/svg+xml,fixture',
+    DSH_CLIENT_TITLE: 'Ignored inherited title',
+    PRIVATE_SIGNING_INPUT: 'not public',
+  })
+  expect(environment.DSH_CLIENT_TITLE).toBe('DeepSeek Harness')
+  expect(environment.DSH_CLIENT_LOCALE_OVERRIDES).toContain('"hero.headline":"Product"')
+  expect(environment.DSH_CLIENT_BRAND_MARK_URL).toBe('data:image/svg+xml,fixture')
+  expect(Object.hasOwn(environment, 'PRIVATE_SIGNING_INPUT')).toBe(false)
+})
+
+it('preserves the product inputs through the complete official build entry path', () => {
+  const input = {
+    DSH_CLIENT_LOCALE_OVERRIDES: '{"conversation":{"en":{"hero.headline":"Product"}}}',
+    DSH_CLIENT_BRAND_MARK_URL: 'data:image/svg+xml,fixture',
+    DSH_CLIENT_UNRELATED: 'not public in official builds',
+  }
+  const repository = repositoryClientBuildEnvironment(root, input)
+  const environment = resolveClientBuildEnvironment(repository, 'official')
+  expect(environment.DSH_CLIENT_LOCALE_OVERRIDES).toBe(input.DSH_CLIENT_LOCALE_OVERRIDES)
+  expect(environment.DSH_CLIENT_BRAND_MARK_URL).toBe(input.DSH_CLIENT_BRAND_MARK_URL)
+  expect(environment.DSH_CLIENT_UNRELATED).toBeUndefined()
+  expect(environment.DSH_CLIENT_TITLE).toBe('DeepSeek Harness')
+})
