+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+
+const contexts: Context[] = []
+afterEach(async () => {
+  vi.unstubAllEnvs()
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+})
+
+function registry() {
+  const ctx = new Context()
+  contexts.push(ctx)
+  const locale = new LocaleRuntime(ctx)
+  locale.register('product', 'en', { title: 'Native', other: 'Original', duration: 'Native {duration}' })
+  locale.setLocale('en')
+  return { ctx, locale, t: locale.bind('product') }
+}
+
+describe('scoped product copy', () => {
+  it('keeps native dictionaries and supports partial layered owners and empty strings', () => {
+    const { locale, t } = registry()
+    const first = locale.override('product', { en: { title: 'First', duration: 'Thinking {duration}' } })
+    const second = locale.override('product', { en: { title: '' } })
+    expect(t('title')).toBe('')
+    expect(t('duration', { duration: '3s' })).toBe('Thinking 3s')
+    expect(t('other')).toBe('Original')
+    first()
+    expect(t('title')).toBe('')
+    expect(t('duration', { duration: '3s' })).toBe('Native 3s')
+    second()
+    expect(t('title')).toBe('Native')
+    locale.override('product', { en: { title: 'Third' } })
+    first(); second()
+    expect(t('title')).toBe('Third')
+    expect(() => locale.register('product', 'en', {})).toThrow('already has locale')
+  })
+
+  it('publishes late contributions and removal without changing locale preference', () => {
+    const { locale, t } = registry()
+    const seen: string[] = []
+    const off = locale.subscribe(() => { seen.push(t('title')) })
+    for (let index = 0; index < 20; index++) {
+      const dispose = locale.override('product', { en: { title: 'Product' } })
+      expect(t('title')).toBe('Product')
+      dispose(); dispose()
+      expect(t('title')).toBe('Native')
+    }
+    expect(seen).toHaveLength(40)
+    expect(locale.getLocale().active).toBe('en')
+    off()
+  })
+
+  it('copies caller dictionaries and respects locale fallback order', () => {
+    const { locale, t } = registry()
+    const copy = { en: { title: 'English product' } }
+    locale.override('product', copy)
+    copy.en.title = 'Caller mutation'
+    locale.register('product', 'zh', { title: '原生中文' })
+    locale.setLocale('zh')
+    expect(t('title')).toBe('原生中文')
+    locale.setLocale('en')
+    expect(t('title')).toBe('English product')
+    expect(t('title')).toBe('English product')
+  })
+
+  it('removes copy when its contributing plugin fiber is disposed', async () => {
+    const { ctx, locale, t } = registry()
+    const owner = ctx.plugin({ name: 'product-copy-owner', apply(child) {
+      child.effect(() => locale.override('product', { en: { title: 'Scoped product' } }))
+    } })
+    await vi.waitFor(() => { expect(t('title')).toBe('Scoped product') })
+    await owner.dispose()
+    expect(t('title')).toBe('Native')
+  })
+
+  it('loads only explicit build copy and restores it after a runtime owner unloads', () => {
+    vi.stubEnv('DSH_CLIENT_LOCALE_OVERRIDES', JSON.stringify({ product: { en: { title: 'Build product' } } }))
+    const { locale, t } = registry()
+    expect(t('title')).toBe('Build product')
+    const dispose = locale.override('product', { en: { title: 'Runtime product' } })
+    dispose()
+    expect(t('title')).toBe('Build product')
+  })
+
+  it.each(['{', 'null', '[]', '{"":{}}', '{"product":42}', '{"product":{"en":[]}}', '{"product":{"en":{"invalid":42}}}',
+    '{"first":{"en":{"title":"First"}},"second":{"bad tag":{"title":"Second"}}}'])('rejects invalid public build input %s', (input) => {
+    vi.stubEnv('DSH_CLIENT_LOCALE_OVERRIDES', input)
+    const ctx = new Context(); contexts.push(ctx)
+    expect(() => new LocaleRuntime(ctx)).toThrow('invalid public build copy')
+  })
+
