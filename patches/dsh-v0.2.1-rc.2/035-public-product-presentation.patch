diff --git a/packages/client/ui-conversation/tests/product-brand.client.spec.tsx b/packages/client/ui-conversation/tests/product-brand.client.spec.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b1195886898987b5dcfafe5f73b96b0ec36610e1
--- /dev/null
+++ b/packages/client/ui-conversation/tests/product-brand.client.spec.tsx
@@ -0,0 +1,57 @@
+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import { Context } from '@deepseek-ai/cordis'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { en } from '../src/client/locales.ts'
+import { HeroShell, type HeroShellProps } from '../src/client/skeleton/EmptyHero.tsx'
+
+const contexts: Context[] = []
+afterEach(async () => {
+  cleanup(); vi.unstubAllEnvs(); vi.unstubAllGlobals()
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+})
+
+function mount() {
+  const ctx = new Context(); contexts.push(ctx)
+  const locale = new LocaleRuntime(ctx)
+  locale.register('conversation', 'en', en)
+  locale.setLocale('en')
+  const renderSlot = vi.fn<HeroShellProps['renderSlot']>((_key, _owner, options) => options?.fallback ?? null)
+  return render(<HeroShell t={locale.bind('conversation')} renderSlot={renderSlot} />)
+}
+
+it('keeps the native hero mark and copy without product configuration', () => {
+  const view = mount()
+  expect(view.getByText('Into the Unknown')).toBeTruthy()
+  expect(view.getByText('Preview')).toBeTruthy()
+  expect(view.container.querySelector('[class*="previewBadge"]')).not.toBeNull()
+  expect(view.container.querySelector('svg path')).not.toBeNull()
+  expect(view.container.querySelector('img')).toBeNull()
+})
+
+it('uses an explicit product mark and locale copy before a slot contributor arrives', () => {
+  const mark = 'data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%2F%3E'
+  vi.stubEnv('DSH_CLIENT_BRAND_MARK_URL', mark)
+  vi.stubEnv('DSH_CLIENT_LOCALE_OVERRIDES', JSON.stringify({ conversation: { en: { 'hero.headline': 'Configured product', 'hero.preview': '' } } }))
+  const view = mount()
+  expect(view.getByText('Configured product')).toBeTruthy()
+  expect(view.queryByText('Preview')).toBeNull()
+  expect(view.container.querySelector('[class*="previewBadge"]')).toBeNull()
+  expect(view.container.querySelector('img')?.getAttribute('src')).toBe(mark)
+  expect(view.container.querySelector('svg')).toBeNull()
+})
+
+it('retains the native hover animation and reduced-motion preference', () => {
+  let motion = true
+  vi.stubGlobal('matchMedia', () => ({ matches: motion }))
+  const view = mount()
+  const hitbox = view.container.querySelector('svg')!.parentElement!
+  fireEvent.mouseEnter(hitbox)
+  expect(view.container.querySelector('animate')).not.toBeNull()
+  fireEvent.mouseLeave(hitbox)
+  expect(view.container.querySelector('animate')).toBeNull()
+  motion = false
+  fireEvent.mouseEnter(hitbox)
+  expect(view.container.querySelector('animate')).toBeNull()
+})
