diff --git a/packages/core/tools/tests/preflight-defer.spec.ts b/packages/core/tools/tests/preflight-defer.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a887bcfd7cf08627a74175353e8edfe8e052ebd2
--- /dev/null
+++ b/packages/core/tools/tests/preflight-defer.spec.ts
@@ -0,0 +1,163 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, {
+  defineTool,
+  TOOL_ABORTED_BEFORE_DISPATCH,
+  type PreToolDecision,
+} from '@deepseek-ai/dsh-tools'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+
+const ownedSignal = new AbortController().signal
+
+async function setup(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  return ctx
+}
+
+const probeTool = defineTool({
+  name: 'probe',
+  description: 'A tool that may defer before dispatch.',
+  parameters: {},
+  output: {
+    schema: { type: 'string' },
+    render: (_args, value) => [{ type: 'text', text: value }],
+  },
+  async execute() {
+    return 'ran'
+  },
+})
+
+describe('preflight defer', () => {
+  it('resolves a defer value without invoking guards, around-dispatch, or the body', async () => {
+    const ctx = await setup()
+    const seen: string[] = []
+    ctx.tools.register({ ...probeTool, async execute() { seen.push('body'); return 'ran' } })
+    ctx.tools.guard(() => { seen.push('guard'); return undefined })
+    ctx.on('tools/execute', async (_exec, next) => { seen.push('around'); return next() })
+    ctx.on('tools/pre-execute', async (): Promise<PreToolDecision> => ({ kind: 'defer', value: 'pending' }))
+    try {
+      const result = await ctx.tools.execute({
+        signal: ownedSignal, callId: ToolCallId('defer'), name: 'probe', arguments: {},
+        preflightDefer: 'dsh.tool-preflight-defer/v1',
+      })
+      expect(ctx.tools.preflightDeferContract).toBe('dsh.tool-preflight-defer/v1')
+      expect(result.isError).toBe(false)
+      if (!result.isError) {
+        expect(result.value).toBe('pending')
+        expect(result.content).toEqual([{ type: 'text', text: 'pending' }])
+      }
+      // Guards gate actual dispatch; a defer never reaches dispatch.
+      expect(seen).toEqual([])
+    } finally { await ctx.fiber.dispose() }
+  })
+
+  it('runs post-execute and tools/result on a deferred value and lets post block it', async () => {
+    const ctx = await setup()
+    let resultObserved = false
+    ctx.tools.register(probeTool)
+    ctx.on('tools/pre-execute', async (): Promise<PreToolDecision> => ({ kind: 'defer', value: 'pending' }))
+    ctx.on('tools/post-execute', async () => ({
+      kind: 'block',
+      feedback: [{ type: 'text', text: 'deferred value blocked by post policy' }],
+    }))
+    ctx.on('tools/result', () => { resultObserved = true })
+    try {
+      const result = await ctx.tools.execute({
+        signal: ownedSignal, callId: ToolCallId('defer-block'), name: 'probe', arguments: {},
+        preflightDefer: 'dsh.tool-preflight-defer/v1',
+      })
+      expect(result.isError).toBe(true)
+      expect(result.content).toEqual([{ type: 'text', text: 'deferred value blocked by post policy' }])
+      expect(resultObserved).toBe(true)
+    } finally { await ctx.fiber.dispose() }
+  })
+
+  it('rejects a defer decision when the caller did not negotiate the contract', async () => {
+    const ctx = await setup()
+    let bodyRan = false
+    ctx.tools.register({ ...probeTool, async execute() { bodyRan = true; return 'ran' } })
+    ctx.on('tools/pre-execute', async (): Promise<PreToolDecision> => ({ kind: 'defer', value: 'pending' }))
+    try {
+      const result = await ctx.tools.execute({
+        signal: ownedSignal, callId: ToolCallId('defer-opted-out'), name: 'probe', arguments: {},
+      })
+      expect(result.isError).toBe(true)
+      expect(result.content[0]).toMatchObject({ text: expect.stringContaining('deferred without negotiating') })
+      expect(bodyRan).toBe(false)
+    } finally { await ctx.fiber.dispose() }
+  })
+
+  it('applies guards, around-dispatch, and the body on a normal resubmission after a defer', async () => {
+    const ctx = await setup()
+    const seen: string[] = []
+    ctx.tools.register({ ...probeTool, async execute() { seen.push('body'); return 'ran' } })
+    let deferOnce = true
+    ctx.tools.guard(() => { seen.push('guard'); return undefined })
+    ctx.on('tools/execute', async (_exec, next) => { seen.push('around'); return next() })
+    ctx.on('tools/pre-execute', async (): Promise<PreToolDecision> => {
+      if (deferOnce) { deferOnce = false; return { kind: 'defer', value: 'pending' } }
+      return { kind: 'allow' }
+    })
+    try {
+      const deferred = await ctx.tools.execute({
+        signal: ownedSignal, callId: ToolCallId('resubmit-1'), name: 'probe', arguments: {},
+        preflightDefer: 'dsh.tool-preflight-defer/v1',
+      })
+      expect(deferred.isError).toBe(false)
+      if (!deferred.isError) expect(deferred.value).toBe('pending')
+      expect(seen).toEqual([])
+
+      const resubmitted = await ctx.tools.execute({
+        signal: ownedSignal, callId: ToolCallId('resubmit-2'), name: 'probe', arguments: {},
+        preflightDefer: 'dsh.tool-preflight-defer/v1',
+      })
+      expect(resubmitted.isError).toBe(false)
+      if (!resubmitted.isError) expect(resubmitted.value).toBe('ran')
+      // A resubmission re-enters the entire pipeline: guards, around, then body.
+      expect(seen).toEqual(['guard', 'around', 'body'])
+    } finally { await ctx.fiber.dispose() }
+  })
+
+  it('never invokes the body when caller cancellation overtakes a defer', async () => {
+    const ctx = await setup()
+    let bodyRan = false
+    ctx.tools.register({ ...probeTool, async execute() { bodyRan = true; return 'ran' } })
+    const controller = new AbortController()
+    ctx.on('tools/pre-execute', async (): Promise<PreToolDecision> => {
+      controller.abort('cancelled before defer resolves')
+      return { kind: 'defer', value: 'pending' }
+    })
+    try {
+      const result = await ctx.tools.execute({
+        callId: ToolCallId('defer-cancel'), name: 'probe', arguments: {}, signal: controller.signal,
+        preflightDefer: 'dsh.tool-preflight-defer/v1',
+      })
+      expect(result.isError).toBe(true)
+      expect(result.error).toMatchObject({ info: { code: TOOL_ABORTED_BEFORE_DISPATCH } })
+      expect(bodyRan).toBe(false)
+    } finally { await ctx.fiber.dispose() }
+  })
+
+  it('rejects a defer value that violates the definition output schema', async () => {
+    const ctx = await setup()
+    let bodyRan = false
+    let postRan = false
+    ctx.tools.register({ ...probeTool, async execute() { bodyRan = true; return 'ran' } })
+    ctx.on('tools/pre-execute', async (): Promise<PreToolDecision> => ({ kind: 'defer', value: 42 }))
+    ctx.on('tools/post-execute', async (_exec, _result, next) => { postRan = true; return next() })
+    try {
+      const result = await ctx.tools.execute({
+        signal: ownedSignal, callId: ToolCallId('defer-wrong-value'), name: 'probe', arguments: {},
+        preflightDefer: 'dsh.tool-preflight-defer/v1',
+      })
+      expect(result.isError).toBe(true)
+      expect(result.error).toMatchObject({ info: { code: 'INVALID_TOOL_OUTPUT' } })
+      expect(bodyRan).toBe(false)
+      // The invalid-output failure still reaches post-execute, like a body's own.
+      expect(postRan).toBe(true)
+    } finally { await ctx.fiber.dispose() }
+  })
+})
