+++ b/packages/core/agent-loop/tests/fixtures/external-turn/idle-driver.ts
@@ -0,0 +1,58 @@
+/** Built Loader fixture: flush an actual idle-start boundary before a parent SIGKILL. */
+import { boot } from '@deepseek-ai/dsh-app-boot'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { createAssistantMessage } from '@deepseek-ai/dsh-llm'
+
+const [configPath, mode, boundary] = process.argv.slice(2)
+if (!configPath || !['kill', 'recover'].includes(mode ?? '') || !['prepare', 'owner'].includes(boundary ?? '')) {
+  throw new Error('Expected config, kill|recover and prepare|owner')
+}
+const ctx = await boot('external-idle-fixture', configPath)
+const id = SessionId('external-idle-kill')
+const { agent } = mode === 'kill'
+  ? await ctx.agents.create({ sessionId: id })
+  : await ctx.agents.resume({ resumeSessionId: id })
+const external = agent.externalTurns
+if (external?.idleAdmissionContract !== 'dsh.external-turn-start/v1' || !external.start) throw new Error('Idle admission unavailable')
+const ownership = (turn: number) => ({
+  contract: 'dsh.external-turn/v1' as const, turn, engine: 'idle-process-fixture/v1', binding: '{"source":"original-admission"}',
+})
+const events = () => agent.session.snapshotEvents().map(({ type, data }) => ({ type, data }))
+const block = async () => {
+  await ctx.sessions.flush(agent.session)
+  await new Promise<void>((resolve, reject) => {
+    process.stdout.write(`${JSON.stringify({ ready: boundary, events: events() })}\n`, (error) => {
+      if (error) reject(error)
+      else resolve()
+    })
+  })
+  // The parent must kill this process; no cancellation, exception or dispose can repair its tail.
+  await new Promise<void>(() => { setInterval(() => {}, 1000) })
+  throw new Error('Kill gate unexpectedly returned')
+}
+if (mode === 'kill') {
+  await external.start(async ({ turn }) => {
+    if (boundary === 'prepare') await block()
+    return ownership(turn)
+  }, async () => { await block(); return { reason: { kind: 'completed' } } })
+} else {
+  try {
+    const before = events(), pending = external.pending()
+    const execute = async ({ turn }: { turn: number }) => {
+      await ctx.sessions.flush(agent.session)
+      agent.session.append('step/start', { turn, step: 1 })
+      agent.session.append('assistant/message', { turn, step: 1, stream: [],
+        message: createAssistantMessage({ content: [{ type: 'text', text: 'Original admission recovered.' }],
+          source: { provider: 'external-fixture', model: 'fixture/v1' } }),
+        usage: { inputTokens: 3, outputTokens: 4 },
+      }, { surfaceOp: 'append' })
+      agent.session.append('step/end', { turn, step: 1 })
+      return { reason: { kind: 'completed' as const } }
+    }
+    if (boundary === 'owner') await external.resume('idle-process-fixture/v1', execute)
+    else await external.start(async ({ turn }) => ownership(turn), execute)
+    await agent.whenIdle()
+    await ctx.sessions.flush(agent.session)
+    process.stdout.write(`${JSON.stringify({ before, pending, after: events(), remaining: external.pending() })}\n`)
+  } finally { await ctx.fiber.dispose() }
+}
