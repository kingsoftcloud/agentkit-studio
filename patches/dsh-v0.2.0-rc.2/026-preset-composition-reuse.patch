+  /** Snapshot a usable preset's declared rows for a derived local composition.
+   * The registry owns validation and preserves Loader expressions and group isolation.
+   * @param id Existing base preset identity.
+   * @returns Independent rows; editing them cannot change the registered base.
+   */
+  async pluginsFor(id: string): Promise<PresetDefinition['plugins']> {
+    const record = this.definitions.get(id)
+    if (record === undefined) throw new RemoteError('agent-preset/not-found', `Unknown agent preset: ${id}`,
+      { agentPreset: id, available: [...this.definitions.keys()] })
+    const broken = await this.diagnostic(record)
+    if (broken !== undefined) throw new RemoteError('agent-preset/invalid', broken, { agentPreset: id, reason: broken })
+    return clone(record.config.plugins) as PresetDefinition['plugins']
+  }
