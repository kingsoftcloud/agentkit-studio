+// @vitest-environment jsdom
+import { cleanup, render } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+import { MarkdownText } from './markdown-test-components.tsx'
+
+afterEach(cleanup)
+
+describe('CJK prose around bare URLs', () => {
+  it('repairs the growing link when commentary arrives and keeps it stable on settlement', () => {
+    const text = '**https://docs.ksyun.com/documents/45345**（标题「产品介绍」）\n\n完成。'
+    const view = render(<MarkdownText text="" streaming />)
+    for (let offset = 1; offset <= text.length; offset++) {
+      view.rerender(<MarkdownText text={text.slice(0, offset)} streaming />)
+    }
+    expect(view.container.querySelector('a')?.getAttribute('href')).toBe('https://docs.ksyun.com/documents/45345')
+    expect(view.container.querySelector('strong')?.textContent).toBe('https://docs.ksyun.com/documents/45345')
+    view.rerender(<MarkdownText text={text} />)
+    expect(view.container.querySelector('a')?.getAttribute('href')).toBe('https://docs.ksyun.com/documents/45345')
+    expect(view.container.textContent).toContain('（标题「产品介绍」）')
+  })
+  for (const streaming of [false, true]) {
