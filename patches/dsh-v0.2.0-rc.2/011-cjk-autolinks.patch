new file mode 100644
index 0000000000000000000000000000000000000000..9287e7319ec2e1dec7fa7d17a9e7afedfc0064c0
--- /dev/null
+++ b/packages/client/ui-primitives/src/markdown/cjkAutolinks.ts
@@ -0,0 +1,79 @@
+/** Keep CJK prose delimiters outside implicit URLs; explicit Markdown destinations stay literal. */
+import type { Root, RootContent } from 'mdast'
+import type { Construct, Extension, State } from 'micromark-util-types'
+import { markdownLineEndingOrSpace } from 'micromark-util-character'
+import { gfm } from 'micromark-extension-gfm'
+
+const proseDelimiter = /[，。；：！？（）【】《》「」『』、]/u
+
+const hasProseDelimiter: Construct = {
+  partial: true,
+  tokenize(effects, ok, nok) {
+    return start
+    function start(code: number | null): State | undefined {
+      effects.enter('data')
+      return scan(code)
+    }
+    function scan(code: number | null): State | undefined {
+      if (code === null || markdownLineEndingOrSpace(code) || code === 60 || code === 62) {
+        effects.exit('data')
+        return nok(code)
+      }
+      if (code >= 0 && proseDelimiter.test(String.fromCodePoint(code))) {
+        effects.exit('data')
+        return ok(code)
+      }
+      effects.consume(code)
+      return scan
+    }
+  },
+}
+
+/**
+ * Delegate CJK-adjacent URL literals to GFM's mdast transform so emphasis can close first.
+ * @returns GFM syntax with CJK prose lookahead on URL literals only.
+ */
+export function cjkAutolinkGfm(): Extension {
+  const syntax = gfm()
+  for (const [code, entry] of Object.entries(syntax.text ?? {})) {
+    const adapt = (construct: Construct): Construct => {
+      if (construct.name !== 'protocolAutolink' && construct.name !== 'wwwAutolink') return construct
+      return {
+        ...construct,
+        tokenize(effects, ok, nok) {
+          return effects.check(construct,
+            effects.check(hasProseDelimiter, nok, construct.tokenize.call(this, effects, ok, nok)), nok)
+        },
+      }
+    }
+    if (syntax.text && entry) syntax.text[code] = Array.isArray(entry) ? entry.map(adapt) : adapt(entry)
+  }
+  return syntax
+}
+
+/**
+ * Split only GFM-generated, positionless URL links at CJK punctuation. Authored links keep positions.
+ * @param root - GFM tree, modified in place after its autolink transform.
+ * @returns The same root with prose retained as ordinary text.
+ */
+export function separateCjkLinkProse(root: Root): Root {
+  const visit = (node: Root | RootContent): void => {
+    if (!('children' in node)) return
+    for (const [index, child] of node.children.entries()) {
+      if (child.type === 'link' && child.position === undefined && /^(?:https?:\/\/)/i.test(child.url)
+        && child.children.length === 1 && child.children[0]?.type === 'text') {
+        const label = child.children[0]
+        const offset = label.value.search(proseDelimiter)
+        if (offset > 0) {
+          const tail = label.value.slice(offset)
+          child.url = child.url.slice(0, child.url.length - tail.length)
+          label.value = label.value.slice(0, offset)
+          node.children.splice(index + 1, 0, { type: 'text', value: tail })
+        }
+      }
+      visit(child)
+    }
+  }
+  visit(root)
+  return root
+}
