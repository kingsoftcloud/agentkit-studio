+}
+
+/** Product defaults travel with the sealed runtime, never with launch-time environment. */
+export function readRuntimeProfileBundles(runtimeDir: string): string[] {
+  const manifestPath = join(runtimeDir, 'package.json')
+  // Preserve the older runtime's default profile; byte qualification remains
+  // the runtime verifier's job rather than every profile metadata operation.
+  if (!existsSync(manifestPath)) return [...WEB_PROFILE.bundles]
+  const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as { dsh?: { profile?: { bundles?: unknown } } }
+  const bundles = manifest.dsh?.profile?.bundles
+  if (bundles === undefined) return [...WEB_PROFILE.bundles]
+  if (!Array.isArray(bundles) || bundles.some(value => typeof value !== 'string' || value.trim() === '')) {
+    throw new Error('desktop runtime: invalid bundled product profile')
+  }
+  return [...new Set([...WEB_PROFILE.bundles, ...bundles])]
 }
