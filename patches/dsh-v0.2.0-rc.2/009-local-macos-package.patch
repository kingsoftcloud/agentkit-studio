new file mode 100644
index 0000000000000000000000000000000000000000..6b2c2c9e91cc64895da58370752eb05f63e02a1d
--- /dev/null
+++ b/apps/desktop/tests/product-branding.spec.ts
@@ -0,0 +1,18 @@
+import { expect, it } from 'vitest'
+import { fileURLToPath } from 'node:url'
+import { createElectronBuilderConfig } from '../scripts/electron-builder-config.mjs'
+
+const env = { DSH_DESKTOP_APP_ID: 'com.example.studio.local', DSH_DESKTOP_TARGET_PLATFORM: 'darwin', DSH_DESKTOP_TARGET_ARCH: 'arm64', DSH_DESKTOP_UNSIGNED: '1' }
+it('product builds use the supplied icon in the macOS bundle and bundled resources', () => {
+  const config = createElectronBuilderConfig({ ...env, DSH_CLIENT_TITLE: 'AgentKit Studio', DSH_DESKTOP_PRODUCT_ICON: '/tmp/studio-icon.png' }, 'darwin', 'arm64')
+  expect(config.productName).toBe('AgentKit Studio')
+  expect(config.mac.icon).toBe('/tmp/studio-icon.png')
+  expect(config.asarUnpack).toContain('**/@openai/codex*/**/*')
+  expect(config.extraResources).toContainEqual({ from: '/tmp/studio-icon.png', to: 'icon.png' })
+  expect(config.mac.extendInfo).toMatchObject({ CFBundleLocalizations: ['en', 'zh_CN'], NSMicrophoneUsageDescription: 'AgentKit Studio uses your microphone to transcribe speech into message drafts.' })
+})
+it('ordinary DSH builds keep the official icon and name', () => {
+  const config = createElectronBuilderConfig(env, 'darwin', 'arm64')
+  expect(config.productName).toBe('DeepSeek Harness')
+  expect(config.mac.icon).toBe(fileURLToPath(new URL('../resources/icon-macos.png', import.meta.url)))
+})
