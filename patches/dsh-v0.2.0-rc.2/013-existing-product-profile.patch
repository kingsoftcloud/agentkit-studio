+/**
+ * Initialize profile files and add newly shipped product bundles once, without installing packages.
+ * Later deactivation, including native recovery, survives subsequent launches.
+ * @param projectDir - Desktop-owned external plugin profile directory.
+ * @param bundles - Default bundle list from the packaged runtime.
+ */
 export function createPluginProfile(projectDir: string, bundles: readonly string[] = WEB_PROFILE.bundles): void {
   initProfile(projectDir, [...bundles])
+  const products = bundles.filter(name => !WEB_PROFILE.bundles.includes(name))
+  if (products.length === 0) return
+  const historyPath = join(projectDir, 'desktop-product-bundles.json')
+  const history: unknown = existsSync(historyPath) ? JSON.parse(readFileSync(historyPath, 'utf8')) : []
+  if (!Array.isArray(history) || history.some(name => typeof name !== 'string' || name.trim() === '')) {
+    throw new Error('desktop project: invalid product bundle activation history')
+  }
+  const added = products.filter(name => !history.includes(name))
+  if (added.length === 0) return
+  const manifest = readProfileManifest('dsh', projectDir)
+  const current = manifest.dsh?.profile?.bundles ?? []
+  if (!Array.isArray(current) || current.some(name => typeof name !== 'string' || name.trim() === '')) {
+    throw new Error('desktop project: invalid profile bundle list')
+  }
+  const missing = added.filter(name => !current.includes(name))
+  if (missing.length > 0) writeProfileManifest(projectDir, {
+    ...manifest,
+    dsh: { ...manifest.dsh, profile: { ...manifest.dsh?.profile, bundles: [...current, ...missing] } },
+  })
+  // Persist after the manifest so an interrupted launch can retry the addition.
+  // Remember observed defaults even when recovery later disables the bundle.
+  writeJson(historyPath, [...new Set([...(history as string[]), ...products])])
 }
 
 /** Product defaults travel with the sealed runtime, never with launch-time environment. */
