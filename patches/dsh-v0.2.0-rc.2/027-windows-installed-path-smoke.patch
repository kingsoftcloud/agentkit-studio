@@ -0,0 +1,18 @@
+/** Exercise the signed Windows app at an install-sized path, away from deep build directories. */
+import { cp, mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+/** Preserve the complete assembled app; archive integrity and signatures are checked by the caller. */
+export async function withWindowsSmokeApplication(application, action) {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-app-'))
+  try {
+    const installed = join(root, 'app')
+    // LibreOffice's native directory enumeration still observes MAX_PATH.
+    // The isolated source/build path can exceed that limit even though a normal install does not.
+    await cp(application, installed, { recursive: true, force: false, errorOnExist: true })
+    return await action(installed)
+  } finally {
+    await rm(root, { recursive: true, force: true })
+  }
+}
