@@ -0,0 +1,30 @@
+/** Keep the official updater cache consistent after an explicitly full Studio release. */
+import { rmSync } from 'node:fs';
+import { basename, dirname, isAbsolute, join } from 'node:path';
+
+/**
+ * A full feed intentionally has no blockmap at its ZIP URL. The native updater
+ * still replaces update.zip, while its old cached current.blockmap survives.
+ * Remove only those two stale index files after the real download event so the
+ * next native differential download fetches the versioned published blockmap.
+ * ZIPs, signatures, download validation and installation remain native-owned.
+ * @param {unknown} event Native update-downloaded event, including feed metadata.
+ * @param {{platform?: string}} options Platform override for filesystem tests.
+ * @returns {boolean} Whether the full-release cache cleanup was requested.
+ */
+export function discardFullUpdateBlockmaps(event, { platform = process.platform } = {}) {
+  if (platform !== 'darwin' || !event || typeof event !== 'object'
+    || event.agentkitUpdateMode !== 'full') return false;
+  const file = event.downloadedFile;
+  if (typeof file !== 'string' || !isAbsolute(file) || !file.endsWith('.zip')
+    || basename(dirname(file)) !== 'pending'
+    || !basename(dirname(dirname(file))).endsWith('-updater')) {
+    throw new Error('Full-update cache cleanup requires a native updater download path');
+  }
+  const pending = dirname(file), cache = dirname(pending);
+  // AppUpdater copies pending/current.blockmap after dispatching this event.
+  // Clear both indexes synchronously before its copy check; keep the ZIP intact.
+  rmSync(join(cache, 'current.blockmap'), { force: true });
+  rmSync(join(pending, 'current.blockmap'), { force: true });
+  return true;
+}
