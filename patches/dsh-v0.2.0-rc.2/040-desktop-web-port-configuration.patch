diff --git a/apps/desktop-host/src/listen-port.ts b/apps/desktop-host/src/listen-port.ts
new file mode 100644
index 0000000000000000000000000000000000000000..083163ec03efd94914d92fe8cce4446476e13896
--- /dev/null
+++ b/apps/desktop-host/src/listen-port.ts
@@ -0,0 +1,21 @@
+/** Resolve the Desktop web server port before profile startup. */
+
+import { basename } from 'node:path'
+
+/**
+ * Select the configured port or preserve the profile's existing default.
+ * @param projectDir - Managed Desktop profile directory.
+ * @param env - Process environment containing an optional DSH_DESKTOP_WEB_PORT.
+ * @returns An integer TCP port; zero requests an available port from the OS.
+ * @throws When the configured value is not a decimal integer from 0 through 65535.
+ */
+export function resolveDesktopWebPort(projectDir: string, env: NodeJS.ProcessEnv = process.env): number {
+  const configured = env.DSH_DESKTOP_WEB_PORT
+  if (configured === undefined) return basename(projectDir) === 'desktop-agentkit-studio' ? 0 : 19387
+  const value = configured.trim()
+  const port = Number(value)
+  if (!/^[0-9]+$/.test(value) || !Number.isInteger(port) || port > 65535) {
+    throw new Error('DSH_DESKTOP_WEB_PORT must be a decimal integer from 0 through 65535')
+  }
+  return port
+}
diff --git a/apps/desktop-host/tests/listen-port.spec.ts b/apps/desktop-host/tests/listen-port.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..acf840e0246ce1b451e168f6d31a97ee6b4ab727
--- /dev/null
+++ b/apps/desktop-host/tests/listen-port.spec.ts
@@ -0,0 +1,16 @@
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { resolveDesktopWebPort } from '../src/listen-port.ts'
+
+it('preserves the existing profile defaults when no explicit port is configured', () => {
+  expect(resolveDesktopWebPort(join('profiles', 'desktop'), {})).toBe(19387)
+  expect(resolveDesktopWebPort(join('profiles', 'desktop-agentkit-studio'), {})).toBe(0)
+})
+
+it.each(['0', '1', '19387', '65535', ' 3210 '])('uses the explicitly configured listen port %s', (value) => {
+  expect(resolveDesktopWebPort(join('profiles', 'desktop'), { DSH_DESKTOP_WEB_PORT: value })).toBe(Number(value))
+})
+
+it.each(['', ' ', '-1', '65536', '1.5', 'NaN', '0x50', '1e3'])('rejects an invalid listen port before starting the profile: %j', (value) => {
+  expect(() => resolveDesktopWebPort(join('profiles', 'desktop'), { DSH_DESKTOP_WEB_PORT: value })).toThrow('DSH_DESKTOP_WEB_PORT')
+})
