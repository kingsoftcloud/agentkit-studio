{
  "defaultTools": [
    "workspace_status",
    "list_workspace_files",
    "read_workspace_file",
    "search_workspace_files",
    "write_workspace_file",
    "write_workspace_files",
    "edit_workspace_file",
    "multi_edit_workspace_file",
    "apply_workspace_patch",
    "lint_workspace_file",
    "web_fetch",
    "web_search",
    "sandbox_status",
    "run_command",
    "read_command_output",
    "stop_command",
    "browser_inspect_workspace"
  ],
  "supportedCommandPlatforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64"
  ],
  "tools": [
    {
      "name": "apply_workspace_patch",
      "description": "Apply a structured patch to workspace files. Use *** Begin Patch / *** End Patch, Add File, Delete File, Update File and optional Move to headers. Hunks use @@ with space/context, -/removed and +/added lines. All hunks are verified before writing. Existing move destinations and overlapping paths are refused. A multi-file publication is not atomic; an uncertain result requires reconciliation, never blind replay.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patch_text"
        ],
        "properties": {
          "patch_text": {
            "type": "string",
            "maxLength": 262144
          }
        }
      },
      "readOnly": false,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:write",
        "workspace:delete"
      ],
      "availability": "always"
    },
    {
      "name": "list_workspace_checkpoints",
      "description": "List this Native Session's durable file checkpoints. Prepared/unknown or already rewound records are not permission to replay effects. Checkpoint contents are private and are not returned.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "readOnly": true,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:read"
      ],
      "availability": "always"
    },
    {
      "name": "preview_workspace_rewind",
      "description": "Preview file-only rewind from a checkpoint, including later committed changes in this Session. Refuses external modifications and uncommitted effects. Does not rewind conversation or execute files. Use the returned preview_token for an approved rewind.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkpoint_id"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          }
        }
      },
      "readOnly": true,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:read"
      ],
      "availability": "always"
    },
    {
      "name": "rewind_workspace_files",
      "description": "Restore files from an exact successful preview. This changes workspace files, requires normal write/delete permission and is forbidden in Plan mode. It never reruns the original tools. A changed preview or unknown effect blocks the whole rewind; partial publication is uncertain and must be reconciled.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkpoint_id",
          "preview_token"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "preview_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "readOnly": false,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:write",
        "workspace:delete"
      ],
      "availability": "always"
    },
    {
      "name": "workspace_status",
      "description": "Return the current AgentEngine workspace status.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 30000,
      "permissions": [],
      "availability": "always"
    },
    {
      "name": "list_workspace_files",
      "description": "List files under the AgentEngine workspace.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "default": "."
          },
          "glob": {
            "type": [
              "string",
              "null"
            ]
          },
          "recursive": {
            "type": "boolean",
            "default": false
          },
          "include_dirs": {
            "type": "boolean",
            "default": true
          },
          "max_results": {
            "type": "integer",
            "default": 500,
            "minimum": 1,
            "maximum": 5000
          },
          "sort_by": {
            "type": "string",
            "default": "name",
            "enum": [
              "name",
              "mtime",
              "size"
            ]
          }
        },
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 30000,
      "permissions": [],
      "availability": "always"
    },
    {
      "name": "read_workspace_file",
      "description": "Read a UTF-8 workspace file. Inspect the result before editing it. Do not issue a dependent read and edit in the same parallel tool-call batch.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "max_chars": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1000,
            "maximum": 100000
          },
          "include_line_numbers": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 30000,
      "permissions": [],
      "availability": "always"
    },
    {
      "name": "write_workspace_file",
      "description": "Write a UTF-8 text file inside the AgentEngine workspace. Creating a new file needs no prior read; replacing an existing file requires a complete current read or a successful write in this session.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:write"
      ],
      "availability": "always"
    },
    {
      "name": "write_workspace_files",
      "description": "Write multiple UTF-8 text files inside the AgentEngine workspace. Preconditions for the batch are checked before the first file is changed.",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "content"
              ]
            }
          },
          "overwrite": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 60000,
      "permissions": [
        "workspace:write"
      ],
      "availability": "always"
    },
    {
      "name": "edit_workspace_file",
      "description": "Replace exact text after reading or successfully writing the file. The prior operation must complete; do not batch dependent reads/writes and edits.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "old_text": {
            "type": "string"
          },
          "new_text": {
            "type": "string"
          },
          "expected_replacements": {
            "type": "integer",
            "default": 1,
            "minimum": 1
          },
          "replace_all": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path",
          "old_text",
          "new_text"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:write"
      ],
      "availability": "always"
    },
    {
      "name": "multi_edit_workspace_file",
      "description": "Apply atomic exact edits after reading or successfully writing the file. The prior operation must complete; do not batch dependent reads/writes and edits.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "old_text": {
                  "type": "string"
                },
                "new_text": {
                  "type": "string"
                },
                "expected_replacements": {
                  "type": "integer",
                  "default": 1,
                  "minimum": 1
                },
                "replace_all": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "old_text",
                "new_text"
              ]
            }
          },
          "replace_all": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path",
          "edits"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:write"
      ],
      "availability": "always"
    },
    {
      "name": "lint_workspace_file",
      "description": "Run lightweight built-in lint checks for a UTF-8 workspace text file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "default": "auto"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 30000,
      "permissions": [],
      "availability": "always"
    },
    {
      "name": "search_workspace_files",
      "description": "Search UTF-8 text files in the AgentEngine workspace.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "default": "."
          },
          "is_regex": {
            "type": "boolean",
            "default": false
          },
          "glob": {
            "type": [
              "string",
              "null"
            ]
          },
          "case_sensitive": {
            "type": "boolean",
            "default": false
          },
          "context_lines": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 20
          },
          "max_results": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 5000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 60000,
      "permissions": [],
      "availability": "always"
    },
    {
      "name": "delete_workspace_file",
      "description": "Delete a file or empty directory inside the AgentEngine workspace.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 30000,
      "permissions": [
        "workspace:delete"
      ],
      "availability": "always"
    },
    {
      "name": "web_fetch",
      "description": "Read a public HTTP(S) page. Long pages are paginated: use next_offset_chars to continue, or find to locate a literal section after offset_chars. URL fragments do not select sections. Returned paths/URIs are not workspace read grants.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "find": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "max_chars": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "offset_chars": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "timeout": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "readOnly": true,
      "timeoutMs": 60000,
      "permissions": [],
      "availability": "always"
    },
    {
      "name": "web_search",
      "description": "Search the web and return title/url/snippet results without fetching full pages.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "max_results": {
            "default": 5,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "type": "string"
          },
          "recency_days": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "readOnly": true,
      "timeoutMs": 60000,
      "permissions": [],
      "availability": "search"
    },
    {
      "name": "browser_inspect_workspace",
      "description": "Inspect and interact with a local HTML workspace page in a run-owned browser.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "screenshot_path": {
            "type": "string",
            "minLength": 1
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "actions": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "click"
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "element_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "button": {
                      "enum": [
                        "left",
                        "right",
                        "middle"
                      ]
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "required": [
                        "selector"
                      ]
                    },
                    {
                      "required": [
                        "element_ref"
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "fill"
                    },
                    "value": {
                      "type": "string"
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "element_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "type",
                    "value"
                  ],
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "required": [
                        "selector"
                      ]
                    },
                    {
                      "required": [
                        "element_ref"
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "press"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "element_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000
                    }
                  },
                  "required": [
                    "type",
                    "key"
                  ],
                  "additionalProperties": false,
                  "not": {
                    "required": [
                      "selector",
                      "element_ref"
                    ]
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "move"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1279
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 719
                    },
                    "steps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "scroll"
                    },
                    "delta_x": {
                      "type": "integer",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    "delta_y": {
                      "type": "integer",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1279
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 719
                    }
                  },
                  "required": [
                    "type",
                    "delta_x",
                    "delta_y"
                  ],
                  "additionalProperties": false,
                  "dependentRequired": {
                    "x": [
                      "y"
                    ],
                    "y": [
                      "x"
                    ]
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "reload"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "wait"
                    },
                    "ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 110000,
      "permissions": [],
      "availability": "browser"
    },
    {
      "name": "sandbox_status",
      "description": "Report the bound command backend and its execution boundary.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 10000,
      "permissions": [],
      "availability": "local-command"
    },
    {
      "name": "run_command",
      "description": "Run a governed Bash command inside the bound local workspace. background=true returns an owned task_id; read_command_output observes it and stop_command requests cancellation. This shares the Host filesystem and network; it is not an isolated OS sandbox.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeout": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "env": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "background": {
            "type": "boolean"
          },
          "background_timeout": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 915000,
      "permissions": [
        "sandbox:execute"
      ],
      "availability": "local-command"
    },
    {
      "name": "read_command_output",
      "description": "Read an owned command status and UTF-8 byte cursors. Reusing a cursor is read-only. Waiting never changes the command deadline.",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stdout_cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stderr_cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 4,
            "maximum": 65536
          },
          "wait_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      },
      "readOnly": true,
      "timeoutMs": 610000,
      "permissions": [],
      "availability": "local-command"
    },
    {
      "name": "stop_command",
      "description": "Request cancellation of one command launched by this Session. Read its output to confirm the final status; a cancel request is not proof of completion.",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "timeoutMs": 10000,
      "permissions": [
        "sandbox:cancel"
      ],
      "availability": "local-command"
    }
  ]
}
