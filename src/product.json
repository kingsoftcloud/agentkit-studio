{
  "schemaVersion": 1,
  "brand": {
    "name": "AgentKit Studio",
    "shortName": "AgentKit"
  },
  "versionSources": {
    "plugin": "package.json#version",
    "desktop": "explicit-build-version-or-dsh-version"
  },
  "copy": {
    "chat": {
      "zh": {"chat.deepDiving": "正在思考中", "chat.deepDivingFor": "正在思考中，用时 {duration} ···"},
      "en": {"chat.deepDiving": "Thinking", "chat.deepDivingFor": "Thinking for {duration} ···"}
    },
    "conversation": {
      "zh": {"placeholder.hero": "发消息或创建任务, / 调用指令, @ 文件或对话", "hero.headline": "{productName}", "hero.preview": ""},
      "en": {"hero.headline": "{productName}", "hero.preview": ""}
    }
  },
  "desktop": {
    "appId": "com.kingsoftcloud.agentkit-studio",
    "pluginRoots": ["@kingsoftcloud/agentkit-studio"],
    "defaultBundles": ["@kingsoftcloud/agentkit-studio"],
    "updates": {
      "environment": "production",
      "origin": "https://agentkit.ks3-cn-beijing.ksyuncs.com",
      "channel": "preview"
    },
    "platforms": {
      "mac-arm64": {"icon": "assets/agentkit-studio-macos.png", "trayIcon": "assets/agentkit-studio-tray.ico"},
      "mac-x64": {"icon": "assets/agentkit-studio-macos.png", "trayIcon": "assets/agentkit-studio-tray.ico"},
      "win-x64": {"icon": "assets/agentkit-studio-macos.png", "trayIcon": "assets/agentkit-studio-tray.ico"}
    }
  }
}
