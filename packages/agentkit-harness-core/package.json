    },
    "./edit-matchers": {
      "types": "./dist/edit-matchers.d.mts",
      "default": "./dist/edit-matchers.mjs"
    },
    "./model-json": {
      "types": "./dist/model-json.d.mts",
      "default": "./dist/model-json.mjs"
    },
    "./patch-apply": {
      "types": "./dist/patch-apply.d.mts",
      "default": "./dist/patch-apply.mjs"
    },
    "./patch-parser": {
      "types": "./dist/patch-parser.d.mts",
      "default": "./dist/patch-parser.mjs"
    },
    "./tool-context": {
      "types": "./dist/tool-context.d.mts",
