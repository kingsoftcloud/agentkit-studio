{
  "name": "@kingsoftcloud/agentkit-harness",
  "version": "0.0.1",
  "description": "AgentKit Harness DSH plugin using the official Agent, Session, persistence and stream contracts.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.19.0" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.mjs" },
    "./core": { "types": "./src/index.d.ts", "default": "./src/core.mjs" },
    "./contract": { "types": "./src/contract.d.ts", "default": "./src/contract.mjs" },
    "./dsh-adapter": { "types": "./src/dsh-adapter.d.ts", "default": "./src/dsh-adapter.mjs" },
    "./manifest": "./agentkit-harness.plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.mjs", "src/index.d.ts",
    "src/core.mjs",
    "src/contract.mjs", "src/contract.d.ts",
    "src/dsh-adapter.mjs", "src/dsh-adapter.d.ts",
    "README.md", "LICENSE", "agentkit-harness.plugin.json"
  ],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  }
}
