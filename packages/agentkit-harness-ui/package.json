{
  "name": "@kingsoftcloud/agentkit-harness-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reusable React task-process UI for AgentKit Native: an explicitly versioned event protocol, a pure state reducer, and an accessible timeline. No Studio/DSH/Python imports; React is a peer dependency.",
  "exports": {
    ".": "./src/index.mjs",
    "./protocol": "./src/protocol.mjs",
    "./reducer": "./src/reducer.mjs",
    "./project": "./src/project.mjs",
    "./tool-detail": "./src/tool-detail.mjs",
    "./summary": "./src/summary.mjs",
    "./diff": "./src/diff.mjs",
    "./terminal": "./src/terminal.mjs",
    "./renderers": "./src/renderers.mjs",
    "./view": "./src/view.mjs",
    "./components": "./src/components.mjs",
    "./styles": "./src/styles.mjs",
    "./react-binding": "./src/react-binding.mjs",
    "./input-preview": "./src/input-preview.mjs",
    "./inspector": "./src/inspector.mjs",
    "./markdown": "./markdown/dist/markdown.mjs",
    "./context-status": "./src/context-status.mjs",
    "./status-panel": "./src/status-panel.mjs",
    "./command-output": "./src/command-output.mjs",
    "./file-preview": "./src/file-preview.mjs"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "markdown/source",
    "markdown/build",
    "markdown/dist"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node markdown/build/build-markdown.cjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "streamdown": "2.5.0",
    "@streamdown/cjk": "1.0.3",
    "@shikijs/core": "4.0.2",
    "@shikijs/langs": "4.0.2",
    "@shikijs/themes": "4.0.2",
    "@shikijs/engine-javascript": "4.0.2",
    "esbuild": "0.27.7",
    "typescript": "6.0.3"
  }
}
