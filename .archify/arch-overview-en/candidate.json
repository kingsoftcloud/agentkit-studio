  "cards": [
    {
      "dot": "cyan",
      "title": "How to read this",
      "items": [
        "Solid lines are the operation channel: the browser calls an operation and the control plane dispatches it to a Host domain.",
        "Dashed lines are the bypass: artifacts and deployments use HTTP prefixes and never touch the operation dispatcher."
      ]
    },
    {
      "dot": "emerald",
      "title": "Two physical channels",
      "items": [
        "/agentkit RPC: typed operation calls.",
        "HTTP prefixes: model proxying, session streaming, deployment and artifact upload."
      ]
    },
    {
      "dot": "rose",
      "title": "Where the boundary is",
      "items": [
        "Credentials stay in the Host; the browser gets capabilities and status.",
        "native-engine is routable but never offered at creation."
      ]
    }
  ]
