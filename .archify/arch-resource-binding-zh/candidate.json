  "cards": [
    {
      "dot": "cyan",
      "title": "怎么读这张图",
      "items": [
        "五类绑定都挂在修订版本上，不挂在智能体上。",
        "智能体只持有当前指向；换资源等于生成新的修订版本。",
        "五条绑定各自独立解析，同一类可以有多个。"
      ]
    },
    {
      "dot": "emerald",
      "title": "互斥与上限",
      "items": [
        "skill_space 与 skill_spaces 不能同时出现。",
        "skill_spaces 与 mcp_servers 各最多 16 项。",
        "引用 ID 匹配 ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$。"
      ]
    },
    {
      "dot": "rose",
      "title": "凭证边界",
      "items": [
        "凭证写成 env://<名称>，明文只存在 Host 凭据服务里。",
        "浏览器拿到的是连接元数据与最后一次探测契约，永远不是明文。",
        "模型档案、MCP 引用、平台连接各自解析，互不代填。"
      ]
    }
  ]
