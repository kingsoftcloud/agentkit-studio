  "cards": [
    {
      "dot": "cyan",
      "title": "How to read this",
      "items": [
        "All five bindings live on the revision, not on the agent.",
        "The agent holds only a pointer; swapping a resource produces a new revision.",
        "The five bindings resolve independently, and one kind may carry several."
      ]
    },
    {
      "dot": "emerald",
      "title": "Exclusivity and limits",
      "items": [
        "skill_space and skill_spaces cannot both appear.",
        "skill_spaces and mcp_servers allow at most 16 entries each.",
        "A reference ID matches ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$."
      ]
    },
    {
      "dot": "rose",
      "title": "Credential boundary",
      "items": [
        "Credentials are written as env://<name>; plaintext exists only in the Host credential service.",
        "The browser receives connection metadata and the last probe contract, never plaintext.",
        "Model profiles, MCP references and platform connections resolve separately and never stand in for each other."
      ]
    }
  ]
