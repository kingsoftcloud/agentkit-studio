  "cards": [
    {
      "dot": "cyan",
      "title": "How to read this",
      "items": [
        "The main path runs left to right: submit, upload, create, provision, configure, start, ready.",
        "Branches hang below the state that spawns them; edges back to an earlier state are drawn as loops above.",
        "State names are API strings and are never translated — they appear verbatim in responses."
      ]
    },
    {
      "dot": "amber",
      "title": "UNKNOWN is not failure",
      "items": [
        "The four *_UNKNOWN states only mean the platform returned no confirmed outcome — neither success nor failure.",
        "The only correct action is to reconcile in the operations centre, not to retry.",
        "Retrying an UNKNOWN as if it failed submits a paid operation twice."
      ]
    },
    {
      "dot": "rose",
      "title": "Five intent groups",
      "items": [
        "Submit: the record exists and the bundle is uploading.",
        "Progress: the platform is working; wait.",
        "Attention: stuck; a person must act.",
        "Terminal: READY and DELETED, with no further automatic transition.",
        "Unknown: reconcile before deciding."
      ]
    }
