{
  "name": "@kingsoftcloud/agentkit-studio",
  "version": "0.0.8",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "icon": "./assets/agentkit-studio.svg",
  "description": "AgentKit Studio product plugin with an independent TypeScript provider for the official DSH host.",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./dist/client.js",
    "./brand": "./src/brand.js",
    "./host-remote": "./src/host-remote.mjs",
    "./host-bootstrap": "./src/host/bootstrap.mjs",
    "./model-proxy": "./src/model-proxy.mjs",
    "./session-adapter": "./src/session-adapter.mjs",
    "./manifest": "./studio.plugin.json",
    "./agentkit-harness": "./src/providers/agentkit-harness.mjs",
    "./runtime-contract": "./src/runtime-contract.mjs",
    "./dsh-runtime": "./src/providers/dsh-runtime.mjs",
    "./dsh-runtime-plugin": "./src/providers/dsh-runtime-plugin.mjs",
    "./model-service": "./src/model-service.mjs",
    "./model-proxy-handler": "./src/model-proxy-handler.mjs",
    "./sse": "./src/sse.mjs"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "third-party",
    "src",
    "packages/agentkit-harness",
    "packages/expert-catalog",
    "dist",
    "src/brand.js",
    "assets",
    "studio.plugin.json",
    "CHANGELOG.md",
    "docs",
    "examples",
    "tests",
    "scripts",
    "patches",
    "host-source",
    "vendor/native",
    "cordis.patch.yml",
    "README.md",
    "scripts/start-agent-bundle.mjs"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "check": "node scripts/check-node-version.mjs && tsc -p tsconfig.contracts.json && node scripts/check-portability.mjs && node --check src/index.mjs && node --check src/client.js && node --check dist/client.js && node --check src/brand.js && node --check src/session-adapter.mjs && node --check src/host-remote.mjs && node --check src/agent-preset-admission.mjs && node --check packages/agentkit-harness/src/core.mjs && node --check packages/agentkit-harness/src/index.mjs && node scripts/test-studio.mjs",
    "build:client": "node scripts/build-client.mjs",
    "precheck": "node scripts/verify-native-dependencies.mjs && node scripts/build-client.mjs && node scripts/build-mcp-client.mjs",
    "pretest": "node scripts/verify-native-dependencies.mjs && node scripts/build-client.mjs && node scripts/build-mcp-client.mjs",
    "prepack": "node scripts/check-local-process-launcher.mjs && node scripts/verify-native-dependencies.mjs && node scripts/build-client.mjs && node scripts/build-mcp-client.mjs",
    "test": "node scripts/test-studio.mjs",
    "pack:harness": "pnpm --dir packages/agentkit-harness pack --pack-destination ../../.artifacts",
    "verify-dsh": "node scripts/verify-dsh-node-store.mjs",
    "verify-dsh-lifecycle": "node scripts/verify-dsh-lifecycle.mjs",
    "verify-dsh-live-runtime": "node scripts/verify-dsh-live-runtime.mjs",
    "verify-studio-plugin-lifecycle": "node scripts/verify-studio-plugin-lifecycle.mjs",
    "verify-studio-desktop-dev": "node scripts/verify-studio-desktop-dev.mjs",
    "verify-harness": "node scripts/verify-agentkit-harness-plugin.mjs",
    "verify-desktop-update": "node scripts/verify-desktop-update-inputs.mjs",
    "verify-desktop-differential": "node scripts/verify-desktop-differential.mjs",
    "verify-desktop-artifact": "node scripts/verify-desktop-artifact.mjs",
    "verify-desktop-feed": "node scripts/desktop-release.mjs verify-feed",
    "publish-desktop-feed": "node scripts/desktop-release.mjs publish",
    "verify-desktop-installed-update": "node scripts/verify-desktop-installed-update.mjs",
    "verify-dsh-sdk": "node scripts/verify-dsh-sdk-node-store.mjs",
    "verify-dsh-plugin-market": "node scripts/verify-dsh-plugin-market.mjs",
    "check:contracts": "tsc -p tsconfig.contracts.json",
    "verify-studio-frozen-host": "node scripts/verify-studio-frozen-host.mjs",
    "pack:catalog": "pnpm --dir packages/expert-catalog pack --pack-destination ../../.artifacts",
    "build:harness": "node scripts/verify-native-dependencies.mjs",
    "build:mcp": "node scripts/build-mcp-client.mjs",
    "verify-native-dsh-turn": "node scripts/verify-native-dsh-turn.mjs",
    "verify-native-owned-recovery": "node scripts/verify-native-owned-recovery.mjs",
    "verify-native-dsh-output": "node scripts/verify-native-dsh-output.mjs",
    "verify-native-dsh-browser": "node scripts/verify-native-dsh-browser.mjs",
    "verify-native-dsh-numeric": "node scripts/verify-native-dsh-numeric.mjs",
    "verify-studio-native-harness": "node scripts/verify-studio-native-harness.mjs",
    "build:harness-node": "node scripts/verify-native-dependencies.mjs",
    "build:native-source": "node scripts/build-native-harness.mjs && node scripts/build-native-node.mjs && node packages/agentkit-harness-ui/markdown/build/build-markdown.cjs",
    "pack:native-source": "node scripts/pack-native-packages.mjs",
    "check:native-ui": "node packages/agentkit-harness-ui/markdown/build/build-markdown.cjs && node --test packages/agentkit-harness-ui/test/*.test.mjs"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-schedule"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-sidebar-browser",
        "@deepseek-ai/dsh-client-ui-schedule"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "0.16.8",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.2",
    "@kingsoftcloud/agentkit-harness-core": "file:vendor/native/kingsoftcloud-agentkit-harness-core-0.0.1-faa777e5b10213fd.tgz",
    "@kingsoftcloud/agentkit-harness-node": "file:vendor/native/kingsoftcloud-agentkit-harness-node-0.0.1-a55eee867cd48c58.tgz",
    "@kingsoftcloud/agentkit-harness-ui": "file:vendor/native/kingsoftcloud-agentkit-harness-ui-0.0.1-727bef49a22028a6.tgz",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@openai/codex": "0.159.2",
    "ajv": "8.17.1",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "aws4": "1.13.2",
    "e2b": "2.58.0",
    "parse5": "7.3.0",
    "playwright-core": "1.58.2",
    "pngjs": "7.0.0",
    "undici": "8.11.2",
    "ws": "8.21.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.58.2",
    "@shikijs/core": "4.0.2",
    "@shikijs/engine-javascript": "4.0.2",
    "@shikijs/langs": "4.0.2",
    "@shikijs/themes": "4.0.2",
    "@streamdown/cjk": "1.0.3",
    "esbuild": "0.27.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "streamdown": "2.5.0",
    "typescript": "6.0.3",
    "unbash": "4.0.1",
    "marked": "18.1.1"
  },
  "bundledDependencies": [
    "@kingsoftcloud/agentkit-harness-core",
    "@kingsoftcloud/agentkit-harness-node",
    "@kingsoftcloud/agentkit-harness-ui"
  ],
  "publishConfig": {
    "executableFiles": [
      "node_modules/@kingsoftcloud/agentkit-harness-node/src/native/local-process-bin/darwin-arm64/launcher",
      "node_modules/@kingsoftcloud/agentkit-harness-node/src/native/local-process-bin/darwin-x64/launcher",
      "node_modules/@kingsoftcloud/agentkit-harness-node/src/native/local-process-bin/linux-arm64/launcher",
      "node_modules/@kingsoftcloud/agentkit-harness-node/src/native/local-process-bin/linux-x64/launcher"
    ],
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://kingsoftcloud.github.io/agentkit-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsoftcloud/agentkit-studio.git"
  },
  "bugs": {
    "url": "https://github.com/kingsoftcloud/agentkit-studio/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh-plugin",
    "agentkit",
    "studio",
    "cloud-assistant",
    "personal-assistant"
  ]
}
