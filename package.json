{
  "name": "@kingsoftcloud/agentkit-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "icon": "./assets/agentkit-studio.svg",
  "description": "AgentKit Studio product plugin with an independent TypeScript provider for the official DSH host.",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./dist/client.js",
    "./brand": "./src/brand.js",
    "./host-remote": "./src/host-remote.mjs",
    "./model-proxy": "./src/model-proxy.mjs",
    "./session-adapter": "./src/session-adapter.mjs",
    "./manifest": "./studio.plugin.json",
    "./agentkit-harness": "./src/providers/agentkit-harness.mjs",
    "./model-service": "./src/model-service.mjs",
    "./model-proxy-handler": "./src/model-proxy-handler.mjs",
    "./sse": "./src/sse.mjs"
  },
  "files": [
    "src",
    "dist",
    "src/brand.js",
    "assets",
    "studio.plugin.json",
    "docs",
    "tests",
    "scripts",
    "patches",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.mjs && node --check src/client.js && node --check dist/client.js && node --check src/brand.js && node --check src/session-adapter.mjs && node --check src/host-remote.mjs && node --check src/agent-preset-admission.mjs && node --test tests/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "precheck": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify-dsh": "node scripts/verify-dsh-node-store.mjs",
    "verify-dsh-sdk": "node scripts/verify-dsh-sdk-node-store.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "dependencies": {
    "aws4": "1.13.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
